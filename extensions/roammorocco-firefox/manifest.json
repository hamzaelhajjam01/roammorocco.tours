{
  "manifest_version": 3,
  "name": "Roam Morocco: MAD Currency & Travel Guide",
  "short_name": "Roam Morocco",
  "version": "1.0.0",
  "description": "Moroccan Dirham (MAD) currency converter, local tipping calculator, and expert travel guide by Roam Morocco Tours.",
  "homepage_url": "https://roammorocco.tours/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Roam Morocco Travel Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@roammorocco.tours",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}