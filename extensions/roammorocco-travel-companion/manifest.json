{
  "manifest_version": 3,
  "name": "Roam Morocco — Dirham (MAD) & Travel Companion",
  "short_name": "Roam Morocco",
  "version": "1.0.0",
  "description": "Instant Moroccan Dirham (MAD) currency converter, local tipping & bargaining calculator, and expert travel guide by Roam Morocco Tours.",
  "homepage_url": "https://roammorocco.tours/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Roam Morocco Travel Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ]
}
