---
import Layout from '../layouts/Layout.astro';

const title = "Refund Policy - RoamMorocco";
const description = "Review the official refund and cancellation policy for Roam Morocco Tours. Clear guidelines on booking deposits, date changes, and tour refunds.";
const canonical = "https://roammorocco.tours/refund-policy.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "RoamMorocco",
  "image": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png",
  "telephone": "+212 653-506441",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "N4, Immeuble, 38 Rue Tariq Bnou Ziad",
    "addressLocality": "Marrakech",
    "postalCode": "40000",
    "addressCountry": "MA"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "bestRating": "5",
    "worstRating": "1",
    "reviewCount": "985"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://roammorocco.tours/",
    "availability": "https://schema.org/InStock",
    "priceCurrency": "USD",
    "price": "100.00",
    "priceValidUntil": "2027-12-31"
  }
};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

        body {
            background-color: #060605;
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        h1 {
            color: #FFFFFF;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: 600;
        }
        h2 {
            color: #C8A45C;
            font-size: 1.5rem;
            margin-top: 40px;
            margin-bottom: 15px;
            font-weight: 500;
        }
        p {
            margin-bottom: 20px;
        }
        a {
            color: #C8A45C;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 40px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    
  </style>

  <div class="container">
        <a href="/" class="back-link">← Back to Home</a>
        <h1>Refund Policy</h1>
        <p>This is a placeholder for the Refund Policy of RoamMorocco. Please update this page with your official legal terms.</p>
        <h2>1. Cancellations</h2>
        <p>If you need to cancel your private Moroccan journey, please notify us as early as possible.</p>
        <h2>2. Refunds</h2>
        <p>Refunds are subject to our cancellation timeline and any non-refundable deposits made to secure local accommodations or transport.</p>
        <h2>3. Contact Us</h2>
        <p>For refund requests or inquiries, please contact us at <a href="mailto:contact@roammorocco.tours">contact@roammorocco.tours</a> or via WhatsApp at <a href="https://wa.me/212653506441">+212 653 506 441</a>.</p>
    </div>
  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->
</Layout>