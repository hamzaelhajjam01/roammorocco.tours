# ==============================================================================
# Roam Morocco Tours — Apache / LiteSpeed Production Configuration (.htaccess)
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3. Blog Slug Permalinks (Legacy & Direct Link Redirects to /blog/)
  RewriteRule ^agafay-desert-vs-merzouga\.html$ /blog/agafay-desert-vs-merzouga.html [L,R=301]
  RewriteRule ^agafay-desert-vs-merzouga$ /blog/agafay-desert-vs-merzouga.html [L,R=301]
  RewriteRule ^bali-travel-guide\.html$ /blog/bali-travel-guide.html [L,R=301]
  RewriteRule ^bali-travel-guide$ /blog/bali-travel-guide.html [L,R=301]
  RewriteRule ^best-time-to-visit-sahara-morocco\.html$ /blog/best-time-to-visit-sahara-morocco.html [L,R=301]
  RewriteRule ^best-time-to-visit-sahara-morocco$ /blog/best-time-to-visit-sahara-morocco.html [L,R=301]
  RewriteRule ^cheap-flights-to-morocco\.html$ /blog/cheap-flights-to-morocco.html [L,R=301]
  RewriteRule ^cheap-flights-to-morocco$ /blog/cheap-flights-to-morocco.html [L,R=301]
  RewriteRule ^dubai-travel-guide\.html$ /blog/dubai-travel-guide.html [L,R=301]
  RewriteRule ^dubai-travel-guide$ /blog/dubai-travel-guide.html [L,R=301]
  RewriteRule ^ferry-from-spain-to-morocco\.html$ /blog/ferry-from-spain-to-morocco.html [L,R=301]
  RewriteRule ^ferry-from-spain-to-morocco$ /blog/ferry-from-spain-to-morocco.html [L,R=301]
  RewriteRule ^gladiator-2-morocco-filming-locations\.html$ /blog/gladiator-2-morocco-filming-locations.html [L,R=301]
  RewriteRule ^gladiator-2-morocco-filming-locations$ /blog/gladiator-2-morocco-filming-locations.html [L,R=301]
  RewriteRule ^is-morocco-safe-for-tourists\.html$ /blog/is-morocco-safe-for-tourists.html [L,R=301]
  RewriteRule ^is-morocco-safe-for-tourists$ /blog/is-morocco-safe-for-tourists.html [L,R=301]
  RewriteRule ^istanbul-travel-guide\.html$ /blog/istanbul-travel-guide.html [L,R=301]
  RewriteRule ^istanbul-travel-guide$ /blog/istanbul-travel-guide.html [L,R=301]
  RewriteRule ^marrakech-vs-fes\.html$ /blog/marrakech-vs-fes.html [L,R=301]
  RewriteRule ^marrakech-vs-fes$ /blog/marrakech-vs-fes.html [L,R=301]
  RewriteRule ^morocco-10-day-itinerary\.html$ /blog/morocco-10-day-itinerary.html [L,R=301]
  RewriteRule ^morocco-10-day-itinerary$ /blog/morocco-10-day-itinerary.html [L,R=301]
  RewriteRule ^morocco-driving-times\.html$ /blog/morocco-driving-times.html [L,R=301]
  RewriteRule ^morocco-driving-times$ /blog/morocco-driving-times.html [L,R=301]
  RewriteRule ^morocco-private-driver-cost\.html$ /blog/morocco-private-driver-cost.html [L,R=301]
  RewriteRule ^morocco-private-driver-cost$ /blog/morocco-private-driver-cost.html [L,R=301]
  RewriteRule ^morocco-train-and-private-driver\.html$ /blog/morocco-train-and-private-driver.html [L,R=301]
  RewriteRule ^morocco-train-and-private-driver$ /blog/morocco-train-and-private-driver.html [L,R=301]
  RewriteRule ^paris-travel-guide\.html$ /blog/paris-travel-guide.html [L,R=301]
  RewriteRule ^paris-travel-guide$ /blog/paris-travel-guide.html [L,R=301]
  RewriteRule ^renting-a-car-in-morocco-vs-private-driver\.html$ /blog/renting-a-car-in-morocco-vs-private-driver.html [L,R=301]
  RewriteRule ^renting-a-car-in-morocco-vs-private-driver$ /blog/renting-a-car-in-morocco-vs-private-driver.html [L,R=301]
  RewriteRule ^sahara-desert-tour-merzouga-vs-zagora\.html$ /blog/sahara-desert-tour-merzouga-vs-zagora.html [L,R=301]
  RewriteRule ^sahara-desert-tour-merzouga-vs-zagora$ /blog/sahara-desert-tour-merzouga-vs-zagora.html [L,R=301]
  RewriteRule ^spain-morocco-itinerary\.html$ /blog/spain-morocco-itinerary.html [L,R=301]
  RewriteRule ^spain-morocco-itinerary$ /blog/spain-morocco-itinerary.html [L,R=301]
  RewriteRule ^the-art-of-the-souk-bargaining-etiquette\.html$ /blog/the-art-of-the-souk-bargaining-etiquette.html [L,R=301]
  RewriteRule ^the-art-of-the-souk-bargaining-etiquette$ /blog/the-art-of-the-souk-bargaining-etiquette.html [L,R=301]
  RewriteRule ^tokyo-travel-guide\.html$ /blog/tokyo-travel-guide.html [L,R=301]
  RewriteRule ^tokyo-travel-guide$ /blog/tokyo-travel-guide.html [L,R=301]
  RewriteRule ^what-to-wear-in-morocco\.html$ /blog/what-to-wear-in-morocco.html [L,R=301]
  RewriteRule ^what-to-wear-in-morocco$ /blog/what-to-wear-in-morocco.html [L,R=301]


  # 1. Force HTTPS
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://roammorocco.tours%{REQUEST_URI} [L,R=301]

  # 2. Enforce Canonical Domain (Redirect www.roammorocco.tours -> roammorocco.tours)
  RewriteCond %{HTTP_HOST} ^www\.roammorocco\.tours$ [NC]
  RewriteRule ^ https://roammorocco.tours%{REQUEST_URI} [L,R=301]
</IfModule>

# ==============================================================================
# Performance & Browser Caching (Core Web Vitals Optimization)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Sitemaps (Fresh content check)
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"

  # Images & Media (Long-term cache)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Compression (Gzip / Deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# Security Headers
# ==============================================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
