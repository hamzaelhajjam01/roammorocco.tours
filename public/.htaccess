# ==============================================================================
# Roam Morocco Tours — Production Migration Configuration (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --------------------------------------------------------------------------
  # 1. EXCLUSIONS (CRITICAL FOR GOOGLEBOT CRAWL & SSL)
  # --------------------------------------------------------------------------
  # Do not redirect robots.txt — Googlebot requires 200 OK on old domain
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^\.well-known/ - [L]

  # --------------------------------------------------------------------------
  # 2. 1-TO-1 TRANSFER ROUTES (RETURN 200 OK ON PRIVATEMOROCCOTRANSFERS)
  # --------------------------------------------------------------------------
  # A. Localized transfer routes: /{lang}/transfers/{slug}.html -> /{lang}/transfers/{slug}
  RewriteRule ^(fr|es|de|it|ar|pt|nl)/transfers/(.+?)(?:\.html)?$ https://www.privatemoroccotransfers.com/$1/transfers/$2 [R=301,L]

  # B. Default transfer routes: /transfers/{slug}.html -> /transfers/{slug}
  RewriteRule ^transfers/(.+?)(?:\.html)?$ https://www.privatemoroccotransfers.com/transfers/$1 [R=301,L]

  # C. Transfer hubs
  RewriteRule ^(fr|es|de|it|ar|pt|nl)/transfers(?:\.html)?/?$ https://www.privatemoroccotransfers.com/$1/transfers [R=301,L]
  RewriteRule ^transfers(?:\.html)?/?$ https://www.privatemoroccotransfers.com/transfers [R=301,L]

  # --------------------------------------------------------------------------
  # 3. VERIFIED PAGES (RETURN 200 OK ON PRIVATEMOROCCOTRANSFERS)
  # --------------------------------------------------------------------------
  RewriteRule ^about(?:\.html)?/?$ https://www.privatemoroccotransfers.com/about [R=301,L]
  RewriteRule ^contact(?:\.html)?/?$ https://www.privatemoroccotransfers.com/contact [R=301,L]
  RewriteRule ^calculator(?:\.html)?/?$ https://www.privatemoroccotransfers.com/calculator [R=301,L]

  # Blog sections -> redirect to active /blog hubs (avoids 404s on un-migrated posts)
  RewriteRule ^(fr|es|de|it)/blog.*$ https://www.privatemoroccotransfers.com/$1/blog [R=301,L]
  RewriteRule ^blog.*$ https://www.privatemoroccotransfers.com/blog [R=301,L]

  # Localized language homepages
  RewriteRule ^(fr|es|de|it|ar|pt|nl)(?:\.html)?/?$ https://www.privatemoroccotransfers.com/$1 [R=301,L]

  # --------------------------------------------------------------------------
  # 4. DIRECT 301 CATCH-ALL FOR ALL OTHER REQUESTS & HOMEPAGE
  # --------------------------------------------------------------------------
  # Direct single-hop 301 for HTTP, HTTPS, WWW, non-WWW, and all other paths
  RewriteRule ^(.*)$ https://www.privatemoroccotransfers.com/ [R=301,L]
</IfModule>
