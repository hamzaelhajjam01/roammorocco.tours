  <!-- Client-side Interactive Scripts -->
  <script is:inline>
    window.addEventListener("load",()=>document.body.classList.add("loaded"));



    /* ── CLICK & TAP STICKER POPUP (DESKTOP & MOBILE) ── */
    (function(){
      const stickers = [
        "/stickers/ait-ben-haddou-sticker.webp",
        "/stickers/al-qarawiyyin-sticker.webp",
        "/stickers/argan-oil-making-sticker.webp",
        "/stickers/bab-mansour-sticker.webp",
        "/stickers/essaouira-sqala-sticker.webp",
        "/stickers/gnawa-maalem-sticker.webp",
        "/stickers/hassan-tower-sticker.webp",
        "/stickers/jemaa-el-fnaa-sticker.webp",
        "/stickers/koutoubia-sticker.webp",
        "/stickers/moroccan-caftan-sticker.webp",
        "/stickers/tbourida-sticker.webp",
        "/stickers/volubilis-sticker.webp"
      ];
      let stickerIdx = 0;
      let activeTimer = null;

      function dismissAllStickers(fast) {
        if (activeTimer) { clearTimeout(activeTimer); activeTimer = null; }
        const activeStickers = document.querySelectorAll('.click-pop-sticker');
        activeStickers.forEach(img => {
          if (fast) {
            img.remove();
          } else {
            img.style.opacity = "0";
            img.style.transform = "translate(-50%, -50%) scale(0.6)";
            setTimeout(() => { if (img.parentNode) img.remove(); }, 200);
          }
        });
      }

      window.addEventListener('scroll', () => dismissAllStickers(false), { passive: true });

      function spawnSticker(e) {
        if (e.target.closest('a') || e.target.closest('button')) return;

        dismissAllStickers(true);

        const src = stickers[stickerIdx];
        stickerIdx = (stickerIdx + 1) % stickers.length;

        const img = document.createElement("img");
        img.src = src;
        img.alt = "";
        img.className = "click-pop-sticker";
        
        let x = e.clientX;
        let y = e.clientY;
        if ((!x && x !== 0) && e.touches && e.touches[0]) {
          x = e.touches[0].clientX;
          y = e.touches[0].clientY;
        }

        const isMobile = window.innerWidth <= 900;
        const stickerWidth = isMobile ? 115 : 170;
        const rot = (Math.random() * 26 - 13).toFixed(1);

        img.style.cssText = `
          position: fixed;
          left: ${x}px;
          top: ${y}px;
          width: ${stickerWidth}px;
          height: auto;
          pointer-events: none;
          z-index: 99999;
          transform: translate(-50%, -50%) scale(0.3) rotate(${rot}deg);
          opacity: 0;
          transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.25s ease;
          filter: drop-shadow(0 12px 24px rgba(0,0,0,0.3));
        `;

        document.body.appendChild(img);

        requestAnimationFrame(() => {
          img.style.transform = `translate(-50%, -50%) scale(1) rotate(${rot}deg)`;
          img.style.opacity = "1";
        });

        activeTimer = setTimeout(() => {
          if (img.parentNode) {
            img.style.transform = `translate(-50%, -50%) scale(0.7) rotate(${rot}deg)`;
            img.style.opacity = "0";
            setTimeout(() => { if (img.parentNode) img.remove(); }, 350);
          }
        }, 2000);
      }

      function attachStickerClick() {
        const targets = document.querySelectorAll('.hero h1, .hero .hero-h1-sub, .footer-logo-img, .footer-giant-brand, .footer-header-row, .footer-wrap');
        targets.forEach(el => {
          el.style.cursor = 'pointer';
          el.addEventListener('click', spawnSticker);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attachStickerClick);
      } else {
        attachStickerClick();
      }
    })();
  </script>
