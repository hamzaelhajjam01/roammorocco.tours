<body class={bodyClass} id="top">
  {showHeader && <Header showLoader={showLoader} />}
  <slot />
  {showFooter && <Footer />}
  {showConcierge && <TripConcierge />}

  <!-- Client-side Interactive Scripts -->
  <script is:inline>
    window.addEventListener("load",()=>document.body.classList.add("loaded"));

/* ── PAGE LOADER CONTROLLER — STICKER SLAP (INITIAL VISIT ONLY) ── */
    (function(){
      const loader = document.getElementById('page-loader');
      if(!loader) return;

      // Fail-safe timeout: Always dismiss loader within 2.5s max under any condition
      const failSafe = setTimeout(() => {
        if(loader && loader.parentNode) {
          loader.classList.add('done');
          setTimeout(() => loader.remove(), 400);
        }
      }, 2500);

      if(sessionStorage.getItem('hasLoadedBefore')){
        clearTimeout(failSafe);
        loader.remove();
        return;
      }
      sessionStorage.setItem('hasLoadedBefore', 'true');

      const baseSlapMs   = 320;   // base animation-duration of stickerSlap
      const baseHoldMs   = 380;   // base hold duration before peeling
      const basePeelMs   = 180;   // base animation-duration of stickerPeel
      const stickers     = Array.from(document.querySelectorAll('.loader-item'));
      const logo         = document.getElementById('loader-final-logo');

      function rnd(min,max){ return (Math.random()*(max-min)+min).toFixed(1); }

      function slap(idx){
        const currentSpeed = 1 + idx * 0.2; // increase speed per sticker
        const slapMs = baseSlapMs / currentSpeed;
        const holdMs = baseHoldMs / currentSpeed;
        const peelMs = basePeelMs / currentSpeed;
        if(idx >= stickers.length){
          logo.classList.add('stamp');
          // After stamping the logo, pause briefly before completing the loader
          setTimeout(() => {
            loader.classList.add('done');
            // Hold on the logo for 3 seconds before removing the loader
            setTimeout(() => loader.remove(), 3000);
          }, 1500);
          return;
        }

        const s = stickers[idx];
        const r1   = rnd(-10, 10);
        const r0   = (+r1 + parseFloat(rnd(20,35)) * (Math.random()>.5?1:-1)).toFixed(1);
        const tx   = rnd(-60, 60);
        const ty   = rnd(-80, -30);
        const rp   = rnd(15, 30) * (Math.random()>.5?1:-1);
        const px   = rnd(-50, 50);
        const py   = rnd(20, 60);

        s.style.setProperty('--r0',  `${r0}deg`);
        s.style.setProperty('--r1',  `${r1}deg`);
        s.style.setProperty('--tx',  `${tx}px`);
        s.style.setProperty('--ty',  `${ty}px`);
        s.style.setProperty('--rp',  `${rp}deg`);
        s.style.setProperty('--px',  `${px}px`);
        s.style.setProperty('--py',  `${py}px`);
        s.style.setProperty('--dur', `${slapMs}ms`);

        s.classList.remove('peel-off');
        void s.offsetWidth;
        s.classList.add('slap-in');

        setTimeout(()=>{
          s.classList.remove('slap-in');
          void s.offsetWidth;
          s.classList.add('peel-off');
          setTimeout(()=>{ s.classList.remove('peel-off'); slap(idx+1); }, peelMs);
        }, slapMs + holdMs);
      }

      slap(0);
    })();

    /* ── CLICK & TAP STICKER POPUP (DESKTOP & MOBILE) ── */
    (function(){
      const stickers = [
        "stickers/ait-ben-haddou-sticker.webp",
        "stickers/al-qarawiyyin-sticker.webp",
        "stickers/argan-oil-making-sticker.webp",
        "stickers/bab-mansour-sticker.webp",
        "stickers/essaouira-sqala-sticker.webp",
        "stickers/gnawa-maalem-sticker.webp",
        "stickers/hassan-tower-sticker.webp",
        "stickers/jemaa-el-fnaa-sticker.webp",
        "stickers/koutoubia-sticker.webp",
        "stickers/moroccan-caftan-sticker.webp",
        "stickers/tbourida-sticker.webp",
        "stickers/volubilis-sticker.webp"
      ];
      let stickerIdx = 0;
      let activeTimer = null;

      function dismissAllStickers(fast) {
        if (activeTimer) { clearTimeout(activeTimer); activeTimer = null; }
        const activeStickers = document.querySelectorAll('.click-pop-sticker');
        activeStickers.forEach(img => {
          if (fast) {
            img.remove();
          } else {
            img.style.opacity = "0";
            img.style.transform = "translate(-50%, -50%) scale(0.6)";
            setTimeout(() => { if (img.parentNode) img.remove(); }, 200);
          }
        });
      }

      window.addEventListener('scroll', () => dismissAllStickers(false), { passive: true });

      function spawnSticker(e) {
        if (e.target.closest('a') || e.target.closest('button')) return;

        dismissAllStickers(true);

        const src = stickers[stickerIdx];
        stickerIdx = (stickerIdx + 1) % stickers.length;

        const img = document.createElement("img");
        img.src = src;
        img.alt = "";
        img.className = "click-pop-sticker";
        
        let x = e.clientX;
        let y = e.clientY;
        if ((!x && x !== 0) && e.touches && e.touches[0]) {
          x = e.touches[0].clientX;
          y = e.touches[0].clientY;
        }

        const isMobile = window.innerWidth <= 900;
        const stickerWidth = isMobile ? 115 : 170;
        const rot = (Math.random() * 26 - 13).toFixed(1);

        img.style.cssText = `
          position: fixed;
          left: ${x}px;
          top: ${y}px;
          width: ${stickerWidth}px;
          height: auto;
          pointer-events: none;
          z-index: 99999;
          transform: translate(-50%, -50%) scale(0.3) rotate(${rot}deg);
          opacity: 0;
          transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.25s ease;
          filter: drop-shadow(0 12px 24px rgba(0,0,0,0.3));
        `;

        document.body.appendChild(img);

        requestAnimationFrame(() => {
          img.style.transform = `translate(-50%, -50%) scale(1) rotate(${rot}deg)`;
          img.style.opacity = "1";
        });

        activeTimer = setTimeout(() => {
          if (img.parentNode) {
            img.style.transform = `translate(-50%, -50%) scale(0.7) rotate(${rot}deg)`;
            img.style.opacity = "0";
            setTimeout(() => { if (img.parentNode) img.remove(); }, 350);
          }
        }, 2000);
      }

      function attachStickerClick() {
        const targets = document.querySelectorAll('.hero h1, .hero .hero-h1-sub, .footer-logo-img, .footer-giant-brand, .footer-header-row, .footer-wrap');
        targets.forEach(el => {
          el.style.cursor = 'pointer';
          el.addEventListener('click', spawnSticker);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attachStickerClick);
      } else {
        attachStickerClick();
      }
    })();
  </script>
  <script is:inline src="/js/roam-nav.js?v=20261012_nav6" defer></script>
  {showConcierge && <script is:inline src="/js/trip-concierge.js?v=20261012_gold4" defer></script>}
  <script is:inline src="/js/booking-wizard.js?v=20261014_goldtheme" defer></script>
</body>
</html>
