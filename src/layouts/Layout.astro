---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TripConcierge from '../components/TripConcierge.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: string | object | any[];
  bodyClass?: string;
  showLoader?: boolean;
  showHeader?: boolean;
  showFooter?: boolean;
  showConcierge?: boolean;
  extraStyles?: string[];
}

const {
  title = "Private Morocco Tours: Luxury Sahara Expeditions & Drivers",
  description = "Discover Morocco with Roam Morocco Tours. Custom luxury Sahara desert expeditions, Atlas trekking, and private tours crafted by local Marrakech experts.",
  canonical = "https://roammorocco.tours/",
  ogImage = "https://roammorocco.tours/images/hero-desert.jpg",
  schema,
  bodyClass = "roam-light-theme",
  showLoader = false,
  showHeader = true,
  showFooter = true,
  showConcierge = true,
  extraStyles = []
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-G2EBSDKVZM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-G2EBSDKVZM');

    // Auto-track WhatsApp, Contact & Booking Conversions
    document.addEventListener('DOMContentLoaded', function() {
      document.addEventListener('click', function(e) {
        var a = e.target.closest('a');
        if (!a || !a.href) return;
        if (a.href.includes('wa.me')) {
          gtag('event', 'contact_whatsapp', { 'event_category': 'conversion', 'event_label': a.textContent.trim() || 'WhatsApp' });
        } else if (a.href.startsWith('mailto:') || a.href.startsWith('tel:')) {
          gtag('event', 'contact_direct', { 'event_category': 'engagement', 'event_label': a.href });
        } else if (a.href.includes('airalo.com') || a.href.includes('discovercars.com') || a.href.includes('booking.com') || a.href.includes('trip.com')) {
          gtag('event', 'affiliate_click', { 'event_category': 'outbound', 'event_label': a.href });
        }
      });
      document.addEventListener('submit', function(e) {
        gtag('event', 'generatelead', { 'event_category': 'conversion', 'event_label': e.target.id || 'booking_form' });
      });
    });
  </script>

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="en" href={canonical}>
  <link rel="alternate" hreflang="x-default" href={canonical}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:secure_url" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>
  <meta property="og:site_name" content="Roam Morocco Tours">

  <!-- Search Engine Thumbnail & Twitter Cards -->
  <meta name="thumbnail" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={title}>

