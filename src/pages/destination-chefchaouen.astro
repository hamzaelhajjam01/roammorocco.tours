---
import Layout from '../layouts/Layout.astro';
import RouteGoogleMapCard from '../components/RouteGoogleMapCard.astro';

const title = "Private Chefchaouen Tours | Fes & Tangier to the Blue City";
const description = "Discover Morocco";
const canonical = "https://roammorocco.tours/destination-chefchaouen.html";
const ogImage = "https://roammorocco.tours/img/dest-chefchaouen.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css?v=20261012_sticky2"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "Chefchaouen (The Blue Pearl)",
      "description": "Nestled in Morocco's northern Rif Mountains, Chefchaouen is famed worldwide for its dreamy cobalt-blue alleyways, Andalusian heritage, and crisp mountain atmosphere.",
      "url": "https://roammorocco.tours/destination-chefchaouen.html",
      "touristType": [
        "Photographers",
        "Couples",
        "Honeymooners",
        "Independent Explorers"
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 35.1714,
        "longitude": -5.2697
      }
    },
    {
      "@type": "TouristTrip",
      "name": "Private Chefchaouen Tour & Excursion from Fes / Tangier",
      "description": "A tailored private tour through the Rif Mountains to Chefchaouen, including private transfers, guided medina walks, and flexible sunset pacing.",
      "provider": {
        "@type": "TravelAgency",
        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "telephone": "+212653506441"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long is the drive from Fes to Chefchaouen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The drive from Fes to Chefchaouen takes approximately 3.5 to 4 hours in our comfortable, private air-conditioned vehicle. We take the scenic route through the Rif mountain valleys and pause whenever you wish for coffee, photos, or panoramic views."
          }
        },
        {
          "@type": "Question",
          "name": "Is a day trip to Chefchaouen enough time, or should we stay overnight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A day trip gives you about 4 to 5 relaxed hours to explore the blue alleys, photograph the famous doorways, have lunch in Outa El Hammam square, and browse artisan weaving. However, staying overnight allows you to experience the magical sunset from the Spanish Mosque and walk the quiet blue streets in the morning before day-trippers arrive."
          }
        },
        {
          "@type": "Question",
          "name": "Can we take a private tour from Tangier to Chefchaouen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Tangier is even closer to Chefchaouen than Fes (approx. 2 hours and 15 minutes drive). We frequently pick up guests directly from Tangier Ville Port (ferries from Spain) or Tangier Ibn Battouta Airport."
          }
        }
      ]
    }
  ]
};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs & Badge -->
      <div class="dest-kicker-bar">
        <div class="dest-breadcrumb">
          <a href="/index.html">Home</a> &nbsp;/&nbsp; <a href="/destinations.html">Destinations</a> &nbsp;/&nbsp; <span>Chefchaouen</span>
        </div>
        <span class="dest-badge-tag">THE BLUE PEARL</span>
      </div>

      <!-- Hero Banner -->
      <div class="dest-hero">
        <img src="/img/dest-chefchaouen.jpg" alt="Chefchaouen Blue Streets in the Rif Mountains" class="dest-hero-img">
        <div class="dest-hero-overlay">
          <h1 class="dest-hero-title">Private Chefchaouen Tours: The Blue Pearl of Morocco</h1>
          <p class="dest-hero-subtitle">Wander tranquil cobalt alleys, discover Andalusian heritage, sip mint tea by mountain springs, and watch the sunset from the Spanish Mosque with a private chauffeur.</p>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> Full Day Excursion or 2 Days Overnight</span>
        <span class="dest-metric-item">🛡 <strong>Style:</strong> Private Executive 4x4 &amp; Chauffeur</span>
        <span class="dest-metric-item">📍 <strong>Departures:</strong> Fes, Tangier, or Casablanca</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985 Verified Reviews)</span>
      </div>

      <!-- 2-Column Core Layout -->
            <!-- GEO & AEO Destination Fast Facts (BLUF) -->
      <aside class="ai-quick-summary-card" aria-label="Chefchaouen Travel Fast Facts">
        <div class="ai-summary-header">
          <span class="ai-summary-kicker">⚡ CHEFCHAOUEN AT A GLANCE (QUICK SUMMARY)</span>
          <span class="ai-summary-badge">The Blue Pearl</span>
        </div>
        <p class="ai-summary-text">
          <strong>Chefchaouen</strong> (Morocco’s famous Blue Pearl) is nestled in the dramatic Rif Mountains of northern Morocco, celebrated for its powder-blue painted medina walls, Spanish Mosque sunset vistas, and tranquil artisan wool-weaving culture. Recommended visit duration is <strong>1 to 2 days</strong>, easily accessible via private chauffeur from Tangier (2h 15m) or Fes (3h 30m) with scenic mountain photo stops included.
        </p>
      </aside>

      <div class="dest-layout-grid">

        <!-- Left Main Column -->
        <div class="dest-content-col">

          <!-- Highlights Callout Box -->
          <div class="dest-highlights-box">
            <h2 class="dest-highlights-title">⚡ Chefchaouen Highlights &amp; Private Perks</h2>
            <ul class="dest-highlights-list">
              <li><strong>The Iconic Cobalt Blue Alleys:</strong> Stroll unhurried through photogenic blue-washed stairways, flower pot facades, and ornate wooden doors.</li>
              <li><strong>Spanish Mosque Sunset Viewpoint:</strong> A gentle 20-minute panoramic hike overlooking the entire blue village as dusk illuminates the Rif peaks.</li>
              <li><strong>Plaza Uta el-Hammam &amp; Kasbah:</strong> Relax at shaded outdoor cafes beside the 15th-century red-walled Kasbah fortress and Grand Mosque.</li>
              <li><strong>Ras El Maa Mountain Spring:</strong> Watch cold mountain water flow down from the Rif peaks where local women gather to wash wool and carpets.</li>
              <li><strong>Bespoke Artisan Weaving:</strong> Discover indigenous Rif mountain handicrafts, woven blankets, wool djellabas, and goat cheese.</li>
            </ul>
          </div>

          <!-- Deep Narrative Overview -->
          <div class="dest-narrative">
            <h2>Morocco’s Most Serene Mountain Sanctuary</h2>
            <p>Perched between two horn-shaped mountain peaks in the northern Rif range (from which the Berber word <em>Chefchaouen</em> derives: "watch the horns"), the Blue Pearl is an aesthetic dream. Founded in 1471 by Moulay Ali Ben Moussa Ben Rached El Alami as a secret fortress against Portuguese invasions, the town welcomed Jewish and Muslim refugees fleeing the Spanish Reconquista.</p>
            <p>They painted their homes in soothing shades of blue—a tradition with deep spiritual roots, reflecting the sky and God’s heaven, while practically keeping houses cool and repelling mosquitoes.</p>
            
            <div style="background:#faf8f5;border:1px solid rgba(0,0,0,0.06);border-left:4px solid var(--gold,#C8A45C);border-radius:16px;padding:24px;margin:24px 0;">
              <p style="font-style:italic;margin:0 0 8px;font-size:15px;color:#333;">"Unlike the frantic energy of big city medinas, Chefchaouen moves at a slow, peaceful mountain tempo. Every turn is an oil painting of indigo, turquoise, and cobalt."</p>
              <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— ROAM MOROCCO FIELD REPORT</span>
            </div>
            
            <p>Traveling with our private chauffeur means you bypass slow, crowded tour buses. We plan your departure so you arrive before the bus crowds, explore the best secret corners, and return in absolute comfort.</p>
          </div>

          
          <!-- Featured Gateway Route: Tangier to Chefchaouen -->
          <RouteGoogleMapCard
            origin="Tangier"
            destination="Chefchaouen"
            distance="114 km"
            duration="2h 15m"
            highway="N2 via Tetouan & Rif Mountains"
            price={109}
            waUrl="https://wa.me/212653506441?text=Salam%20Roam%20Morocco!%20I'd%20like%20to%20book%20a%20private%20transfer%20from%20Tangier%20to%20Chefchaouen."
          />

          <!-- Day-by-Day Detailed Itinerary -->
          <div class="dest-itinerary-timeline">
            <h3 class="dest-itinerary-header">
              <span>Sample Private Day Excursion from Fes / Tangier</span>
              <span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:700;letter-spacing:0.06em;color:#8A6A23;background:rgba(200,164,92,0.12);border:1px solid rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;">TAILORED PACING</span>
            </h3>

            <!-- Timeline -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">08:00 AM // SCENIC RIF MOUNTAIN ROAD TRIP</span>
              <h4 class="dest-day-title">Fes or Tangier Departure → Rif Foothills</h4>
              <p class="dest-day-desc">Your private driver picks you up directly at your riad door in an executive, air-conditioned vehicle. Enjoy a peaceful drive through olive groves, cedar-covered hills, and the Rif mountain range. Stop for fresh mountain coffee and panoramic photo viewpoints overlooking the dam of Sidi Chahed.</p>
              <div class="dest-day-tags">
                <span>Scenic 4x4 Chauffeur</span>
                <span>Flexible Photo Stops</span>
                <span>Water &amp; Wi-Fi Onboard</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">11:30 AM // BLUE MEDINA EXPLORATION &amp; LUNCH</span>
              <h4 class="dest-day-title">Outa El Hammam → Artisan Weavers → Ras El Maa</h4>
              <p class="dest-day-desc">Arrive in Chefchaouen. Walk through the blue maze with your guide or at your own leisurely pace. Discover the hidden photo corners, the leather goods, and the famous leather babouches. Savor lunch at a charming terrace restaurant overlooking the square, sampling local goats' cheese tagines and fresh fig salads.</p>
              <div class="dest-day-tags">
                <span>4–5 Hours on Ground</span>
                <span>Artisan Cooperatives</span>
                <span>Authentic Rif Cuisine</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">04:30 PM // SPANISH MOSQUE HIKE &amp; RETURN DRIVE</span>
              <h4 class="dest-day-title">Panoramic Viewpoint → Relaxing Evening Transfer</h4>
              <p class="dest-day-desc">Before heading back, take the scenic trail to the historic Spanish Mosque perched on the hill above the town for the classic panorama of the blue town set against the mountains. Your chauffeur welcomes you back to your vehicle for a relaxed evening drive, dropping you directly at your accommodation.</p>
              <div class="dest-day-tags">
                <span>Optional Sunset Hike</span>
                <span>Door-to-Door Riad Drop-Off</span>
              </div>
            </div>
          </div>

          <!-- Inclusions & Exclusions Checklist -->
          <div class="dest-inclusions-card">
            <h3 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;margin:0 0 20px;">What's Included in Your Chefchaouen Tour</h3>
            <div class="dest-inclusions-grid">
              <div class="dest-inc-col">
                <h4 style="color:#25D366;">✔ INCLUDED</h4>
                <ul class="dest-inc-list">
                  <li>Dedicated private air-conditioned vehicle with fuel &amp; tolls</li>
                  <li>Professional English-speaking Berber chauffeur</li>
                  <li>Door-to-door hotel/riad pickup and drop-off (Fes or Tangier)</li>
                  <li>Flexible hours in Chefchaouen (no rushed schedules)</li>
                  <li>Chilled bottled mineral water in the vehicle</li>
                  <li>Spanish Mosque panoramic walk assistance</li>
                </ul>
              </div>
              <div class="dest-inc-col">
                <h4 style="color:#f10b18;">✕ NOT INCLUDED</h4>
                <ul class="dest-exc-list">
                  <li>Lunch in Chefchaouen (plenty of recommendations provided)</li>
                  <li>Optional Kasbah Museum entrance ticket (~60 MAD)</li>
                  <li>Discretionary driver gratuity</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="dest-faq-box">
            <h3 class="dest-faq-title">Frequently Asked Questions: Chefchaouen Tours</h3>
            
            <div class="dest-faq-item active">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Can we do this tour starting in Tangier and ending in Fes?</h4>
              <div class="dest-faq-a">
                <p>Yes! This is one of our most popular one-way transfers. We pick you up in Tangier (airport, hotel, or ferry port from Spain), drive you to Chefchaouen for 4–5 hours of exploration with your luggage safely stored in our vehicle, and then proceed south to drop you off at your riad in Fes.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Are there lots of stairs in Chefchaouen?</h4>
              <div class="dest-faq-a">
                <p>Yes, Chefchaouen is built into the hillside and features many cobblestone steps and slopes. We recommend wearing comfortable walking shoes with good traction. We can easily tailor the walking route to be as gentle and accessible as needed.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar -->
                <!-- Right Sticky Sidebar: Pre-Locked Route Card -->
        <aside class="dest-sidebar-col">
          <div class="dest-prelocked-widget"
               data-tour-name="Chefchaouen Blue City Private Day Tour"
               data-price-1-4="180"
               data-price-5-7="230"
               data-price-8-12="310"
               data-tour-sub="Door-to-door private Mercedes van · Rif Mountains panoramic route">
            
            <div class="dest-prelocked-badge"><span>●</span> INSTANT DIRECT BOOKING</div>
            <h3 class="dest-prelocked-title">Chefchaouen Blue City Private Day Tour</h3>
            <p class="dest-prelocked-sub">Door-to-door private Mercedes van · Rif Mountains panoramic route</p>

            <label class="dest-form-label" style="margin-bottom:6px;display:block;">Group Size &amp; Vehicle</label>
            <div class="dest-tier-grid">
              <button type="button" class="dest-tier-btn active" data-tier="1_4">
                <span class="dest-tier-pax">1–4 Pax</span>
                <span class="dest-tier-veh">Sedan / 4x4</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="5_7">
                <span class="dest-tier-pax">5–7 Pax</span>
                <span class="dest-tier-veh">VIP Van</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="8_12">
                <span class="dest-tier-pax">8–12 Pax</span>
                <span class="dest-tier-veh">Minibus</span>
              </button>
            </div>

            <div class="dest-prelocked-fields">
              <div class="dest-form-field">
                <label class="dest-form-label" for="pickupCityChefchaouen">Departure City</label>
                <select class="dest-form-select dest-prelocked-city" id="pickupCityChefchaouen">
                  <option value="Fes (Hotel or Riad)" data-surcharge="0" selected>Fes (Hotel or Riad)</option>
                  <option value="Tangier (Port / Hotel)" data-surcharge="-50">Tangier (Port / Hotel) (-50€)</option>
                  <option value="Tetouan" data-surcharge="-70">Tetouan (-70€)</option>
                  <option value="Casablanca (Airport or Hotel)" data-surcharge="120">Casablanca (Airport or Hotel) (+120€)</option>
                </select>
              </div>

              <div class="dest-form-field">
                <label class="dest-form-label" for="travelDateChefchaouen">Approx. Travel Date</label>
                <input class="dest-form-input dest-prelocked-date" type="date" id="travelDateChefchaouen">
              </div>
            </div>

            <div class="dest-prelocked-price-box">
              <div class="dest-prelocked-price-num">180€</div>
              <span class="dest-prelocked-price-sub">Total private group price (not per person)</span>
              <p class="dest-prelocked-price-note">Includes dedicated chauffeur, fuel, Rif Mountains scenic stops &amp; free time in the Blue Medina.</p>
            </div>

            <a href="#" class="dest-prelocked-wa-btn">
              <img src="/img/whatsapp-logo.png" alt="WhatsApp">
              <span>Book via WhatsApp <span class="dest-prelocked-btn-price">— 180€</span></span>
            </a>

            <div class="dest-prelocked-trust">
              <span>🛡 <strong>100% Private:</strong> Dedicated vehicle &amp; local Berber driver.</span>
              <span>⚡ <strong>Fast Confirmation:</strong> Operations team replies &lt; 10 mins.</span>
              <span>🇲🇦 <strong>Zero Deposit:</strong> No upfront deposit needed to check dates.</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </main>

    <!-- Signature Footer -->

  <script is:inline>
    
    function scrollToBookingForm(e) {
      if (e) e.preventDefault();
      const formBox = document.querySelector('.dest-booking-widget') || document.querySelector('.dest-sidebar-col');
      if (formBox) {
        const yOffset = -80;
        const y = formBox.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        setTimeout(() => {
          const input = document.getElementById('clientName');
          if (input) input.focus();
        }, 500);
      }
    }

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.add("at-top");
          topEl.classList.remove("at-bottom");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-dark-bg.png';
        } else {
          topEl.classList.add("at-bottom");
          topEl.classList.remove("at-top");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-light-bg.png';
        }
      }
    }
    addEventListener("scroll", onScroll, {passive: true});
    onScroll();

    function toggleFaq(btn){
      const item = btn.closest('.dest-faq-item');
      if(item) item.classList.toggle('active');
    }

    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(burgerBtn && mobileDrawer){
      burgerBtn.addEventListener('click', function(e){
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      document.addEventListener('click', function(e){
        if(!mobileDrawer.contains(e.target) && !burgerBtn.contains(e.target)){
          mobileDrawer.classList.remove('open');
        }
      });
    }
    function closeDrawer(){
      if(mobileDrawer) mobileDrawer.classList.remove('open');
    }

    async function handleInquirySubmit(e, tourName){
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.dest-submit-btn');
      
      const name = (document.getElementById('clientName')?.value || '').trim();
      const email = (document.getElementById('clientEmail')?.value || '').trim();
      const phone = (document.getElementById('clientPhone')?.value || '').trim();
      const dates = (document.getElementById('travelDates')?.value || '').trim();
      const dep = (document.getElementById('departureCity')?.value || '').trim();
      const notes = (document.getElementById('notes')?.value || '').trim();

      const payload = {
        name: name,
        email: email,
        phone: phone,
        service: tourName + (dep ? ` (${dep})` : ''),
        pickup: dep || tourName,
        date: dates,
        notes: notes,
        source: window.location.pathname
      };

      const waMsg = `Salam Roam Morocco! I would like to inquire about the ${tourName}:\n\n` +
        `👤 Name: ${name}\n` +
        `✉️ Email: ${email}\n` +
        `📱 WhatsApp: ${phone}\n` +
        (dep ? `🚗 Route / Departure: ${dep}\n` : '') +
        (dates ? `📅 Travel Date: ${dates}\n` : '') +
        (notes ? `📝 Notes: ${notes}\n` : '') +
        `\nCan you please confirm driver availability and send a quote?`;
      
      const waUrl = `https://wa.me/212653506441?text=${encodeURIComponent(waMsg)}`;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      let statusBox = document.getElementById('destFormStatus');
      if (!statusBox) {
        statusBox = document.createElement('div');
        statusBox.id = 'destFormStatus';
        statusBox.className = 'dest-form-status';
        form.appendChild(statusBox);
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: tourName,
          value: 200,
          currency: 'EUR'
        });
      }

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.innerHTML = `<strong>✓ Proposal Request Dispatched!</strong>Thank you, ${name}. Your inquiry for <strong>${tourName}</strong> has been sent to our team. We will check route and driver availability and email you at <strong>${email}</strong> within 30 minutes.<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Chat with Local Specialist on WhatsApp &rarr;</a>`;

        if (submitBtn) {
          submitBtn.textContent = '✓ REQUEST SENT TO OPERATIONS';
          submitBtn.style.background = '#16a34a';
          submitBtn.style.borderColor = '#16a34a';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 1000);

      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.innerHTML = `Connecting directly to our Marrakech WhatsApp desk...<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Open WhatsApp &rarr;</a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>

  <!-- Sticky Mobile Tour Bar (<900px) -->
  <div class="sticky-mobile-tour-bar">
    <div class="smt-info">
      <div class="smt-title">Chefchaouen Blue City Tour</div>
      <div class="smt-price">From <span class="smt-price-num">180€</span> <span>per vehicle</span></div>
    </div>
    <a href="https://wa.me/212653506441?text=Salam%20Roam%20Morocco!%20I'm%20interested%20in%20the%20Chefchaouen%20Blue%20City%20Private%20Day%20Tour." target="_blank" rel="noopener" class="smt-btn">
      <img src="/img/whatsapp-logo.png" alt="WhatsApp">
      <span>Book on WhatsApp</span>
    </a>
  </div>
</Layout>