---
import Layout from '../layouts/Layout.astro';
import RouteGoogleMapCard from '../components/RouteGoogleMapCard.astro';

const title = "Fes Private Tours: Medina, Chouara Tanneries &amp; Volubilis";
const description = "Explore Fes el-Bali with a private guide: Chouara Tanneries, ancient madrasas, and private day trips to Roman Volubilis and Meknes.";
const canonical = "https://roammorocco.tours/destination-fes.html";
const ogImage = "https://roammorocco.tours/img/frida-aguilar-estrada-LhVJaRPweJc-unsplash.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css?v=20261012_sticky2"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "Fes el-Bali Medina",
      "description": "The world's largest car-free urban zone and the spiritual heart of Morocco, home to the 9th-century University of Al-Qarawiyyin and the historic Chouara tanneries.",
      "url": "https://roammorocco.tours/destination-fes.html",
      "touristType": [
        "History Lovers",
        "Cultural Travelers",
        "Architectural Historians",
        "Photographers"
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 34.0331,
        "longitude": -5.0003
      }
    },
    {
      "@type": "TouristTrip",
      "name": "Private Fes & Imperial North Heritage Tour",
      "description": "A comprehensive private experience pairing an academic guide in Fes Medina with private chauffeur day excursions to Roman Volubilis and Meknes.",
      "provider": {
        "@type": "TravelAgency",
        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "telephone": "+212760426269"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I visit Volubilis and Meknes as a day trip from Fes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, absolutely! Volubilis is only about 1 hour and 15 minutes by private car from Fes. Our private day trip combines the Roman mosaics of Volubilis, the holy hill town of Moulay Idriss, and the imperial city of Meknes with the monumental Bab Mansour gate."
          }
        },
        {
          "@type": "Question",
          "name": "Is Fes older than Marrakech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Fes was founded in 789 AD by Idris I, making it nearly 300 years older than Marrakech (founded in 1062 AD). Fes is celebrated as Morocco's spiritual, intellectual, and artisan capital."
          }
        },
        {
          "@type": "Question",
          "name": "Why is a private guide essential in Fes el-Bali?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fes el-Bali contains over 9,000 winding, car-free alleyways with no street names or GPS coverage. A licensed private guide provides context on the medieval guild system, ensures you visit authentic artisan cooperatives, and navigates the labyrinth with ease."
          }
        },
        {
          "@type": "Question",
          "name": "How do I visit the Chouara Tannery in Fes without getting scammed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The safest way is to visit with a licensed official national tour guide rather than following touts on the street. View the stone pits from authorized leather shop terraces, accept a fresh mint sprig to neutralize the pungent smell, tip 10 to 20 MAD if you don't buy leather goods, and negotiate prices firmly if purchasing handcrafted Moroccan leather jackets or slippers."
          }
        }
      ]
    }
  ]
};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs & Badge -->
      <div class="dest-kicker-bar">
        <div class="dest-breadcrumb">
          <a href="/">Home</a> &nbsp;/&nbsp; <a href="/destinations.html">Destinations</a> &nbsp;/&nbsp; <span>Fes</span>
        </div>
        <span class="dest-badge-tag">THE SPIRITUAL CAPITAL</span>
      </div>

      <!-- Hero Banner -->
      <div class="dest-hero">
        <img src="/img/frida-aguilar-estrada-LhVJaRPweJc-unsplash.jpg" alt="Fes El Bali Medina and Bab Bou Jeloud" class="dest-hero-img">
        <div class="dest-hero-overlay">
          <h1 class="dest-hero-title">Private Fes Tours: UNESCO Medina &amp; Imperial Excursions</h1>
          <p class="dest-hero-subtitle">Journey deep into the medieval heart of Morocco. 9,000 ancient alleys, world-famous leather tanneries, and private day excursions to Roman Volubilis &amp; Meknes.</p>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> 2 to 4 Days (Customizable)</span>
        <span class="dest-metric-item">🛡 <strong>Style:</strong> Private Licensed Scholar &amp; Chauffeur</span>
        <span class="dest-metric-item">📍 <strong>Base:</strong> Historic Luxury Riad inside Fes Medina</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985 Verified Reviews)</span>
      </div>

      <!-- 2-Column Core Layout -->
            <!-- GEO & AEO Destination Fast Facts (BLUF) -->
      <aside class="ai-quick-summary-card" aria-label="Fes Travel Fast Facts">
        <div class="ai-summary-header">
          <span class="ai-summary-kicker">⚡ FES AT A GLANCE (QUICK SUMMARY)</span>
          <span class="ai-summary-badge">Imperial Capital</span>
        </div>
        <p class="ai-summary-text">
          <strong>Fes</strong> is Morocco’s spiritual and cultural capital, home to <strong>Fes el-Bali</strong>—the world's largest contiguous car-free urban area containing over 9,000 medieval alleyways, the 9th-century Al Quaraouiyine University (the world's oldest university), and the iconic 11th-century <strong>Chouara Leather Tanneries</strong>. Recommended visit duration is <strong>2 to 3 days</strong>. Roam Morocco provides licensed academic medina historians, door-to-door riad transport, and Sahara desert transfer connections.
        </p>
      </aside>

      <div class="dest-layout-grid">

        <!-- Left Main Column -->
        <div class="dest-content-col">

          <!-- Highlights Callout Box -->
          <div class="dest-highlights-box">
            <h2 class="dest-highlights-title">⚡ Fes Highlights &amp; Private Exclusives</h2>
            <ul class="dest-highlights-list">
              <li><strong>Al-Qarawiyyin University:</strong> Stand outside the oldest continuously operating university in the world, founded in 859 AD by Fatima al-Fihri.</li>
              <li><strong>Chouara Leather Tanneries:</strong> Exclusive balcony view over the iconic 11th-century stone dye pits without tourist crowds.</li>
              <li><strong>Bou Inania &amp; Al-Attarine Madrasas:</strong> Intricate cedar carvings, marble courtyards, and museum-grade geometric zellige mosaics.</li>
              <li><strong>Volubilis Roman UNESCO Ruins:</strong> Private day tour to breathtaking 2,000-year-old Roman mosaic floors, triumphal arches, and olive presses.</li>
              <li><strong>Imperial Meknes &amp; Bab Mansour:</strong> Visit Sultan Moulay Ismail’s monumental capital and royal granaries.</li>
            </ul>
          </div>

          <!-- Deep Narrative Overview -->
          <div class="dest-narrative">
            <h2>The Intellectual &amp; Spiritual Soul of the Kingdom</h2>
            <p>If Marrakech is the theatrical heartbeat of Morocco, Fes is its scholarly, contemplative mind. Walking through the monumental cobalt gate of Bab Bou Jeloud into Fes el-Bali is an immediate portal into the 14th century. Mules loaded with spices clip-clop past bakeries that have used the exact same wood-fired ovens for four hundred years.</p>
            <p>Because Fes el-Bali has zero cars, a knowledgeable private guide is invaluable. We match you with licensed cultural scholars who weave together the profound tapestry of Moroccan philosophy, Andalusian architectural influx, and Jewish Mellah craftsmanship.</p>
            
            <div style="background:#faf8f5;border:1px solid rgba(0,0,0,0.06);border-left:4px solid var(--gold,#C8A45C);border-radius:16px;padding:24px;margin:24px 0;">
              <p style="font-style:italic;margin:0 0 8px;font-size:15px;color:#333;">"Fes does not yield its secrets to those who rush. Behind plain cedar doors lie riad courtyards so opulent they rival the Alhambra in Granada."</p>
              <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— ROAM MOROCCO HISTORICAL NOTES</span>
            </div>
            
            <p>Beyond the Medina, our private chauffeur service connects Fes effortlessly to the Roman ruins of Volubilis, the holy town of Moulay Idriss, and the dramatic mountain passes leading toward the Sahara Desert.</p>
          </div>

          
          <!-- Featured Route: Fes to Chefchaouen Blue City -->
          <RouteGoogleMapCard
            origin="Fes"
            destination="Chefchaouen"
            distance="198 km"
            duration="3h 30m"
            highway="N13 & R419 via Rif Mountains"
            price={145}
            waUrl="https://wa.me/212760426269?text=Salam%20Roam%20Morocco!%20I'd%20like%20to%20book%20a%20private%20day%20trip%20from%20Fes%20to%20Chefchaouen."
          />

          <!-- Day-by-Day Detailed Itinerary -->
          <div class="dest-itinerary-timeline">
            <h3 class="dest-itinerary-header">
              <span>Sample 3-Day Curated Fes Heritage Circuit</span>
              <span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:700;letter-spacing:0.06em;color:#8A6A23;background:rgba(200,164,92,0.12);border:1px solid rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;">CULTURE &amp; ROMAN HERITAGE</span>
            </h3>

            <!-- Day 1 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 01 // DEEP DIVE INTO FES EL-BALI MEDINA</span>
              <h4 class="dest-day-title">Ancient Guilds, Madrasas &amp; Chouara Tanneries</h4>
              <p class="dest-day-desc">Meet your licensed scholar guide at your riad. Explore the stunning 14th-century Bou Inania Madrasa, the Nejjarine Museum of Wooden Arts &amp; Crafts, and Al-Qarawiyyin mosque library. Visit the Chouara Tanneries from a private viewing terrace with fresh mint sprigs. Stroll through the copper and brass artisan alleys of Place Seffarine, followed by a panoramic late-afternoon drive to the Marinid Tombs overlooking the entire golden valley of Fes.</p>
              <div class="dest-day-tags">
                <span>Walking Tour: 5 Hours</span>
                <span>Licensed Private Scholar</span>
                <span>Sunset at Marinid Tombs</span>
              </div>
            </div>

            <!-- Day 2 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 02 // ROMAN MOSAICS &amp; IMPERIAL MEKNES</span>
              <h4 class="dest-day-title">Volubilis Archaeological Site → Moulay Idriss → Meknes</h4>
              <p class="dest-day-desc">Your private chauffeur picks you up in an executive 4x4 at 09:00 AM. Travel 1 hour west through olive groves to Volubilis, a UNESCO World Heritage site featuring the best-preserved Roman ruins in North Africa. Explore the House of Orpheus and the Labors of Hercules mosaics. Continue to the pilgrimage town of Moulay Idriss for lunch with mountain views. Finish the afternoon in the 17th-century Imperial City of Meknes, admiring the towering Bab Mansour gate before returning to Fes.</p>
              <div class="dest-day-tags">
                <span>Private Chauffeur &amp; 4x4</span>
                <span>UNESCO Roman Archaeological Site</span>
                <span>Scenic Countryside Drive</span>
              </div>
            </div>

            <!-- Day 3 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 03 // CHEFCHAOUEN EXCURSION OR SAHARA CROSSING</span>
              <h4 class="dest-day-title">Day Trip to Chefchaouen OR Departure toward Erg Chebbi</h4>
              <p class="dest-day-desc">Depending on your travel schedule, choose between a stunning scenic day trip into the northern Rif Mountains to explore the blue alleys of Chefchaouen, OR embark on our signature desert journey south toward the Middle Atlas cedar forests and Merzouga dunes.</p>
              <div class="dest-day-tags">
                <span>Flexible Direction</span>
                <span>Rif Mountains or Sahara Departure</span>
                <span>Door-to-Door Luggage Care</span>
              </div>
            </div>
          </div>

          <!-- Visiting Chouara Tanneries in Fes Section -->
          <div class="dest-tannery-feature" style="background:#fff;border-radius:16px;padding:32px;margin-bottom:30px;box-shadow:0 4px 20px rgba(0,0,0,0.03);border:1px solid rgba(0,0,0,0.08);">
            <span style="font-size:11px;font-family:'Inter',sans-serif;color:#8A6A23;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;background:rgba(200,164,92,0.12);border:1px solid rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;display:inline-block;">INSIDER GUIDE // ARTISAN HERITAGE</span>
            <h3 style="font-family:'Playfair Display',serif;font-size:26px;color:#1a1a1a;margin:14px 0 16px;">Visiting Chouara Tannery in Fes (Morocco's Famous Leather Tanneries)</h3>
            <p style="font-size:15px;line-height:1.7;color:#4a4a4a;margin-bottom:14px;">The <strong>Chouara Tannery in Fes</strong> (often written as Chaouwara) is the oldest and largest working medieval leather tannery in Morocco, operating continuously since the 11th century. Nestled in the heart of Fes el-Bali near Place Seffarine, these iconic stone dye pits look and function almost identically to how they did a thousand years ago.</p>
            <p style="font-size:15px;line-height:1.7;color:#4a4a4a;margin-bottom:14px;">Hides of cow, sheep, goat, and camel are processed entirely by hand using natural organic elements—pigeon droppings for softening, followed by vivid natural dyes extracted from poppy flower (red), saffron (yellow), cedar wood (brown), and indigo (blue). When visiting with Roam Morocco, our licensed guides take you to exclusive rooftop viewing terraces, providing fresh mint sprigs to counteract the pungent organic odors while offering panoramic photo opportunities overlooking the vibrant honeycombed vats.</p>
            <div style="background:#f9f8f6;border-left:4px solid var(--gold,#C8A45C);padding:20px;margin:20px 0;border-radius:12px;border:1px solid rgba(0,0,0,0.06);border-left:4px solid #C8A45C;">
              <h4 style="font-size:15px;margin:0 0 8px;color:#1a1a1a;">Tips for Visiting the Fes Leather Tanneries:</h4>
              <ul style="font-size:14px;line-height:1.6;color:#555;padding-left:20px;margin:0;">
                <li><strong>Best Lighting:</strong> Visit between 09:30 AM and 12:00 PM when the sunlight directly illuminates the colorful dye vats and artisans are actively working.</li>
                <li><strong>Avoiding Unofficial Touts:</strong> Never follow aggressive faux guides in the Medina alleys. Always visit with a licensed official scholar guide who secures private terrace access without high-pressure sales tactics.</li>
                <li><strong>Shopping for Authentic Moroccan Leather:</strong> Genuine Fes leather goods (jackets, duffel bags, babouche slippers, and poufs) are vegetable-tanned, supple, and durable. Be prepared to gently negotiate—our private guides will assist you with fair pricing.</li>
              </ul>
            </div>
            <p style="font-size:14px;color:#666;margin:0;"><em>Planning intercity travel? Travel comfortably between Marrakech, Casablanca, and Fes with our licensed <a href="/morocco-private-driver.html" style="color:#f10b18;font-weight:600;text-decoration:underline;">private driver service in Morocco</a>.</em></p>
          </div>

          <!-- Inclusions & Exclusions Checklist -->
          <div class="dest-inclusions-card">
            <h3 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;margin:0 0 20px;">What's Included in Your Private Fes Tour</h3>
            <div class="dest-inclusions-grid">
              <div class="dest-inc-col">
                <h4 style="color:#25D366;">✔ INCLUDED</h4>
                <ul class="dest-inc-list">
                  <li>Licensed English-speaking Fes cultural guide for full day</li>
                  <li>Dedicated private air-conditioned transport for day excursions</li>
                  <li>Full day excursion to Volubilis, Moulay Idriss &amp; Meknes</li>
                  <li>Entry tickets to historical Madrasas &amp; Volubilis archaeological site</li>
                  <li>Pickup and drop-off directly at your Fes riad</li>
                  <li>Luggage handling and porter service into car-free Medina</li>
                </ul>
              </div>
              <div class="dest-inc-col">
                <h4 style="color:#f10b18;">✕ NOT INCLUDED</h4>
                <ul class="dest-exc-list">
                  <li>Lunches and alcoholic drinks</li>
                  <li>Discretionary tips for guides and chauffeur</li>
                  <li>Personal craft purchases in artisan souks</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="dest-faq-box">
            <h3 class="dest-faq-title">Frequently Asked Questions: Fes Private Tours</h3>
            
            <div class="dest-faq-item active">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Can cars drive inside the Fes Medina?</h4>
              <div class="dest-faq-a">
                <p>No. Fes el-Bali is the largest contiguous car-free urban zone on the planet. Cars and vans can only drop passengers at designated gates (such as Bab Bou Jeloud or Place R'cif). For all our guests staying in riads, our team coordinates private luggage porters with traditional hand-carts to transport your bags safely directly to your riad doorway.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Can we do a day trip to Chefchaouen from Fes?</h4>
              <div class="dest-faq-a">
                <p>Yes. The drive takes approximately 3.5 to 4 hours each way through the scenic Rif Mountains. With our private chauffeur, you depart early (07:30 AM), enjoy 4 to 5 relaxed hours in Chefchaouen, and return comfortably to Fes by dinner.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Is Fes or Marrakech better for shopping?</h4>
              <div class="dest-faq-a">
                <p>Marrakech has more modern, chic bohemian boutique designs, but Fes is universally recognized as the master craft capital for traditional pottery (blue Fes zellige), copper lamps, and authentic vegetable-tanned leather.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">What is the best way to visit Chouara Tannery in Fes without scams?</h4>
              <div class="dest-faq-a">
                <p>The safest way to visit the Chouara Tanneries in Fes is with a licensed official guide who takes you to reputable viewing terraces overlooking the dye pits. You will be provided fresh mint sprigs to breathe through to counteract the odor. Never follow unofficial street touts in the alleys, who often demand exorbitant exit tips or steer travelers into high-pressure leather shops.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar -->
                <!-- Right Sticky Sidebar: Pre-Locked Route Card -->
        <aside class="dest-sidebar-col">
          <div class="dest-prelocked-widget"
               data-tour-name="Fes Medina, Volubilis & Meknes Private Circuit"
               data-price-1-4="175"
               data-price-5-7="225"
               data-price-8-12="295"
               data-tour-sub="Certified English historian · Roman ruins of Volubilis &amp; Imperial Meknes">
            
            <div class="dest-prelocked-badge"><span>●</span> INSTANT DIRECT BOOKING</div>
            <h3 class="dest-prelocked-title">Fes Medina, Volubilis & Meknes Private Circuit</h3>
            <p class="dest-prelocked-sub">Certified English historian · Roman ruins of Volubilis &amp; Imperial Meknes</p>

            <label class="dest-form-label" style="margin-bottom:6px;display:block;">Group Size &amp; Vehicle</label>
            <div class="dest-tier-grid">
              <button type="button" class="dest-tier-btn active" data-tier="1_4">
                <span class="dest-tier-pax">1–4 Pax</span>
                <span class="dest-tier-veh">Sedan / 4x4</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="5_7">
                <span class="dest-tier-pax">5–7 Pax</span>
                <span class="dest-tier-veh">VIP Van</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="8_12">
                <span class="dest-tier-pax">8–12 Pax</span>
                <span class="dest-tier-veh">Minibus</span>
              </button>
            </div>

            <div class="dest-prelocked-fields">
              <div class="dest-form-field">
                <label class="dest-form-label" for="pickupCityFes">Departure City</label>
                <select class="dest-form-select dest-prelocked-city" id="pickupCityFes">
                  <option value="Fes (Medina / Riad)" data-surcharge="0" selected>Fes (Medina / Riad)</option>
                  <option value="Meknes" data-surcharge="-20">Meknes (-20€)</option>
                  <option value="Rabat" data-surcharge="40">Rabat (+40€)</option>
                </select>
              </div>

              <div class="dest-form-field">
                <label class="dest-form-label" for="travelDateFes">Approx. Travel Date</label>
                <input class="dest-form-input dest-prelocked-date" type="date" id="travelDateFes">
              </div>
            </div>

            <div class="dest-prelocked-price-box">
              <div class="dest-prelocked-price-num">175€</div>
              <span class="dest-prelocked-price-sub">Total private group price (not per person)</span>
              <p class="dest-prelocked-price-note">Includes dedicated chauffeur, private licensed historical guide, fuel &amp; door-to-door hotel pickup.</p>
            </div>

            <a href="#" class="dest-prelocked-wa-btn">
              <img src="/img/whatsapp-logo.png" alt="WhatsApp">
              <span>Book via WhatsApp <span class="dest-prelocked-btn-price">— 175€</span></span>
            </a>

            <div class="dest-prelocked-trust">
              <span>🛡 <strong>100% Private:</strong> Dedicated vehicle &amp; local Berber driver.</span>
              <span>⚡ <strong>Fast Confirmation:</strong> Operations team replies &lt; 10 mins.</span>
              <span>🇲🇦 <strong>Zero Deposit:</strong> No upfront deposit needed to check dates.</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </main>

    <!-- Signature Footer -->

  <script is:inline>
    
    function scrollToBookingForm(e) {
      if (e) e.preventDefault();
      const formBox = document.querySelector('.dest-booking-widget') || document.querySelector('.dest-sidebar-col');
      if (formBox) {
        const yOffset = -80;
        const y = formBox.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        setTimeout(() => {
          const input = document.getElementById('clientName');
          if (input) input.focus();
        }, 500);
      }
    }

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.add("at-top");
          topEl.classList.remove("at-bottom");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-dark-bg.png';
        } else {
          topEl.classList.add("at-bottom");
          topEl.classList.remove("at-top");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-light-bg.png';
        }
      }
    }
    addEventListener("scroll", onScroll, {passive: true});
    onScroll();

    function toggleFaq(btn){
      const item = btn.closest('.dest-faq-item');
      if(item) item.classList.toggle('active');
    }

    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(burgerBtn && mobileDrawer){
      burgerBtn.addEventListener('click', function(e){
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      document.addEventListener('click', function(e){
        if(!mobileDrawer.contains(e.target) && !burgerBtn.contains(e.target)){
          mobileDrawer.classList.remove('open');
        }
      });
    }
    function closeDrawer(){
      if(mobileDrawer) mobileDrawer.classList.remove('open');
    }

    async function handleInquirySubmit(e, tourName){
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.dest-submit-btn');
      
      const name = (document.getElementById('clientName')?.value || '').trim();
      const email = (document.getElementById('clientEmail')?.value || '').trim();
      const phone = (document.getElementById('clientPhone')?.value || '').trim();
      const dates = (document.getElementById('travelDates')?.value || '').trim();
      const guests = (document.getElementById('groupSize')?.value || '').trim();
      const notes = (document.getElementById('notes')?.value || '').trim();

      const payload = {
        name: name,
        email: email,
        phone: phone,
        service: tourName,
        pickup: tourName,
        date: dates,
        passengers: guests,
        notes: notes,
        source: window.location.pathname
      };

      const waMsg = `Salam Roam Morocco! I would like to inquire about the ${tourName}:\n\n` +
        `👤 Name: ${name}\n` +
        `✉️ Email: ${email}\n` +
        `📱 WhatsApp: ${phone}\n` +
        (dates ? `📅 Travel Dates: ${dates}\n` : '') +
        (guests ? `👥 Group Size: ${guests}\n` : '') +
        (notes ? `📝 Special Requests: ${notes}\n` : '') +
        `\nCan you please confirm availability and send a detailed itinerary proposal?`;
      
      const waUrl = `https://wa.me/212760426269?text=${encodeURIComponent(waMsg)}`;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      let statusBox = document.getElementById('destFormStatus');
      if (!statusBox) {
        statusBox = document.createElement('div');
        statusBox.id = 'destFormStatus';
        statusBox.className = 'dest-form-status';
        form.appendChild(statusBox);
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: tourName,
          value: 200,
          currency: 'EUR'
        });
      }

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.innerHTML = `<strong>✓ Proposal Request Dispatched!</strong>Thank you, ${name}. Your inquiry for <strong>${tourName}</strong> has been sent to our Marrakech team. We will review riad and route availability and email you at <strong>${email}</strong> within 30 minutes.<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Chat with Local Specialist on WhatsApp &rarr;</a>`;

        if (submitBtn) {
          submitBtn.textContent = '✓ REQUEST SENT TO OPERATIONS';
          submitBtn.style.background = '#16a34a';
          submitBtn.style.borderColor = '#16a34a';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 1000);

      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.innerHTML = `Connecting directly to our Marrakech WhatsApp desk...<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Open WhatsApp &rarr;</a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>

