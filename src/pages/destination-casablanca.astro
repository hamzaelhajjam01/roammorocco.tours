---
import Layout from '../layouts/Layout.astro';

const title = "Private Tours from Casablanca: Morocco Circuits &amp; Transfers";
const description = "Begin your private Morocco journey from Casablanca (CMN). Customized circuits to Chefchaouen, Fes, the Sahara Desert, and Marrakech with a private driver.";
const canonical = "https://roammorocco.tours/destination-casablanca.html";
const ogImage = "https://roammorocco.tours/img/dest-casablanca.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css?v=20261012_sticky2"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "Casablanca & Mohammed V International Hub",
      "description": "Morocco's economic capital and main intercontinental gateway, celebrated for the monumental Hassan II Mosque, Atlantic Corniche, and Art Deco architecture.",
      "url": "https://roammorocco.tours/destination-casablanca.html",
      "touristType": [
        "International Travelers",
        "Families",
        "Luxury Vacationers",
        "First-Time Visitors"
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 33.5731,
        "longitude": -7.5898
      }
    },
    {
      "@type": "TouristTrip",
      "name": "Grand Morocco Private Circuit from Casablanca (7 to 12 Days)",
      "description": "An all-inclusive private expedition departing from Casablanca airport covering Rabat, Chefchaouen, Fes, Merzouga Desert, and Marrakech.",
      "provider": {
        "@type": "TravelAgency",
        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "telephone": "+212653506441"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can you meet us directly at Casablanca Airport (CMN)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Our private English-speaking chauffeur will track your flight status and wait for you in the arrivals hall with a personalized Roam Morocco name board. We assist with your luggage and immediately escort you to your executive air-conditioned 4x4 or minivan."
          }
        },
        {
          "@type": "Question",
          "name": "Can non-Muslims visit the Hassan II Mosque in Casablanca?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Hassan II Mosque is one of the very few active mosques in Morocco open to non-Muslim visitors through official guided tours. We organize priority entry so you can witness its staggering ocean-perched prayer hall, titanium retractable roof, and hand-carved cedar ceilings."
          }
        },
        {
          "@type": "Question",
          "name": "How many days is ideal for a tour starting in Casablanca?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a complete circuit that includes the Imperial Cities (Rabat, Fes, Meknes), the Blue City of Chefchaouen, the Sahara Desert, and Marrakech, 8 to 12 days is ideal. For shorter trips (4 to 5 days), we can take you on a direct Casablanca to Marrakech route via the coast or interior."
          }
        }
      ]
    }
  ]
};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs & Badge -->
      <div class="dest-kicker-bar">
        <div class="dest-breadcrumb">
          <a href="/index.html">Home</a> &nbsp;/&nbsp; <a href="/destinations.html">Destinations</a> &nbsp;/&nbsp; <span>Casablanca</span>
        </div>
        <span class="dest-badge-tag">INTERNATIONAL ARRIVAL HUB</span>
      </div>

      <!-- Hero Banner -->
      <div class="dest-hero">
        <img src="/img/dest-casablanca.jpg" alt="Hassan II Mosque in Casablanca over the Atlantic Ocean" class="dest-hero-img">
        <div class="dest-hero-overlay">
          <h1 class="dest-hero-title">Private Tours from Casablanca: Grand Moroccan Circuits</h1>
          <p class="dest-hero-subtitle">Touch down in Morocco and step into seamless VIP travel. Airport pickup, the awe-inspiring Hassan II Mosque, and bespoke Grand Tours connecting Fes, the Sahara, and Marrakech.</p>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> 7 to 12 Days (Customizable)</span>
        <span class="dest-metric-item">🛡 <strong>Style:</strong> Dedicated 4x4 Chauffeur Throughout</span>
        <span class="dest-metric-item">📍 <strong>Arrival Hub:</strong> Mohammed V International (CMN)</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985 Verified Reviews)</span>
      </div>

      <!-- 2-Column Core Layout -->
            <!-- GEO & AEO Destination Fast Facts (BLUF) -->
    <aside class="ai-quick-summary-card" aria-label="Casablanca Travel Fast Facts">
      <div class="ai-summary-header">
        <span class="ai-summary-kicker">⚡ CASABLANCA AT A GLANCE (QUICK SUMMARY)</span>
        <span class="ai-summary-badge">Economic Gateway</span>
      </div>
      <p class="ai-summary-text">
        <strong>Casablanca</strong> is Morocco’s modern commercial powerhouse and principal transatlantic flight gateway (Mohammed V Airport - CMN). The city's crown jewel is the monumental <strong>Hassan II Mosque</strong>—one of the largest mosques in the world, built directly over the Atlantic Ocean with a 210-meter minaret. Recommended stay is <strong>1 day / 1 night</strong> before connecting directly to Marrakech (2h 45m) or Fes (3h 30m) via Roam Morocco’s private chauffeur transfers.
      </p>
    </aside>

    <div class="dest-layout-grid">

        <!-- Left Main Column -->
        <div class="dest-content-col">

          <!-- Highlights Callout Box -->
          <div class="dest-highlights-box">
            <h2 class="dest-highlights-title">⚡ Casablanca &amp; Grand Circuit Highlights</h2>
            <ul class="dest-highlights-list">
              <li><strong>Hassan II Mosque VIP Visit:</strong> Tour North Africa’s largest mosque, featuring a 210-meter minaret and a floor built directly above the Atlantic ocean swell.</li>
              <li><strong>Seamless CMN Airport Pickup:</strong> Avoid airport taxi queues; your chauffeur meets you the moment you exit customs with your private vehicle.</li>
              <li><strong>Capital Heritage in Rabat:</strong> Explore the oceanfront Kasbah of the Oudayas, Hassan Tower, and the Royal Mausoleum of Mohammed V.</li>
              <li><strong>Full Moroccan Loop:</strong> Effortlessly link Casablanca → Rabat → Chefchaouen → Fes → Merzouga Sahara → Marrakech with zero back-tracking.</li>
              <li><strong>Rick’s Café Experience:</strong> Enjoy an atmospheric evening cocktail in the legendary recreation of Humphrey Bogart’s film bar.</li>
            </ul>
          </div>

          <!-- Deep Narrative Overview -->
          <div class="dest-narrative">
            <h2>Your Gateway to the Kingdom of Morocco</h2>
            <p>Casablanca is where most long-haul flights from North America, Europe, and Australia touch down. While many tour agencies rush travelers through on generic schedules, starting your journey in Casablanca with a private chauffeur offers unparalleled flexibility.</p>
            <p>You begin with the marvel of modern Islamic architecture—the Hassan II Mosque, where hand-carved marble and cedarwood honor centuries of artisanal mastery. From there, your private vehicle charts an unhurried course northward to the royal capital of Rabat and the blue streets of Chefchaouen, before venturing south into the imperial medinas and the Sahara dunes.</p>
            
            <div style="background:#faf8f5;border:1px solid rgba(0,0,0,0.06);border-left:4px solid var(--gold,#C8A45C);border-radius:16px;padding:24px;margin:24px 0;">
              <p style="font-style:italic;margin:0 0 8px;font-size:15px;color:#333;">"Starting in Casablanca gives travelers the true narrative arc of Morocco: beginning at the modern Atlantic coast, journeying into the ancient medieval medinas, and culminating in the silence of the Saharan sands."</p>
              <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— ROAM MOROCCO ITINERARY DIRECTORY</span>
            </div>
            
            <p>Because your vehicle and driver remain exclusively with you throughout the entire route, you enjoy luggage security, total route flexibility, and zero transit stress.</p>
          </div>

          <!-- Day-by-Day Detailed Itinerary -->
          <div class="dest-itinerary-timeline">
            <h3 class="dest-itinerary-header">
              <span>Sample 8-Day Grand Circuit from Casablanca</span>
              <span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:700;letter-spacing:0.06em;color:#8A6A23;background:rgba(200,164,92,0.12);border:1px solid rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;">POPULAR FOR US &amp; UK TRAVELERS</span>
            </h3>

            <!-- Timeline -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 01 // WELCOME TO MOROCCO</span>
              <h4 class="dest-day-title">CMN Airport Arrival → Hassan II Mosque → Imperial Rabat</h4>
              <p class="dest-day-desc">Meet your private chauffeur at Casablanca Airport. Visit the monumental Hassan II Mosque right by the sea. Continue 1 hour north to Rabat, the diplomatic capital. Explore the white-and-blue Oudayas Kasbah and the unfinished 12th-century Hassan Tower before relaxing at your luxury riad.</p>
              <div class="dest-day-tags">
                <span>Airport Pickup Included</span>
                <span>Hassan II Mosque Tour</span>
                <span>Overnight in Rabat</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 02–03 // THE BLUE CITY &amp; SPIRITUAL FES</span>
              <h4 class="dest-day-title">Rabat → Chefchaouen (Rif Mountains) → Fes el-Bali</h4>
              <p class="dest-day-desc">Drive through the scenic Rif Mountains into Chefchaouen. Spend the afternoon photographing the blue alleys and artisan shops. On Day 3, continue south past the Roman ruins of Volubilis to reach Fes for a full guided day exploring the ancient medina, madrasas, and Chouara tanneries.</p>
              <div class="dest-day-tags">
                <span>Chefchaouen Blue Alleys</span>
                <span>UNESCO Roman Volubilis</span>
                <span>Licensed Fes Scholar Guide</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 04–06 // MIDDLE ATLAS TO SAHARA DUNES</span>
              <h4 class="dest-day-title">Fes → Ziz Valley → Erg Chebbi Glamping → Dades Valley</h4>
              <p class="dest-day-desc">Cross the Middle Atlas cedar forests, greeting wild Barbary apes in Azrou. Descend through the dramatic Ziz Gorge into the dunes of Erg Chebbi. Experience sunset camel rides and sleep in a luxury desert tent. Continue through Todra Gorge into the dramatic Kasbah canyons of Dades Valley.</p>
              <div class="dest-day-tags">
                <span>Luxury Sahara Glamping</span>
                <span>Camel Trek &amp; Campfire Drumming</span>
                <span>Todra &amp; Dades Gorges</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 07–08 // THE OCHRE CITY &amp; DEPARTURE</span>
              <h4 class="dest-day-title">Aït Benhaddou → High Atlas → Marrakech (or CMN Return)</h4>
              <p class="dest-day-desc">Tour the UNESCO fortress of Ksar Aït Benhaddou, cross the scenic Tizi n'Tichka pass, and spend your final two days exploring Marrakech’s palaces, Majorelle Gardens, and vibrant souks. Departure transfer back to Marrakech (RAK) or Casablanca (CMN) airport.</p>
              <div class="dest-day-tags">
                <span>UNESCO Ksar Aït Benhaddou</span>
                <span>Marrakech Medina Exploration</span>
                <span>Seamless Airport Drop-off</span>
              </div>
            </div>
          </div>

          <!-- Inclusions & Exclusions Checklist -->
          <div class="dest-inclusions-card">
            <h3 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;margin:0 0 20px;">What's Included in Your Casablanca Grand Tour</h3>
            <div class="dest-inclusions-grid">
              <div class="dest-inc-col">
                <h4 style="color:#25D366;">✔ INCLUDED</h4>
                <ul class="dest-inc-list">
                  <li>Dedicated private air-conditioned vehicle throughout the entire tour</li>
                  <li>Professional English-speaking Berber chauffeur</li>
                  <li>All vehicle fuel, highway tolls, and parking fees</li>
                  <li>Handpicked luxury riad &amp; hotel accommodations with breakfast</li>
                  <li>Luxury Sahara desert camp with private en-suite tent &amp; dinner</li>
                  <li>Private licensed local guides in Fes &amp; Marrakech</li>
                  <li>Sunset camel trek in Erg Chebbi</li>
                  <li>Airport pickup (CMN) and departure transfer</li>
                </ul>
              </div>
              <div class="dest-inc-col">
                <h4 style="color:#f10b18;">✕ NOT INCLUDED</h4>
                <ul class="dest-exc-list">
                  <li>International flights</li>
                  <li>Mid-day lunches and alcoholic beverages</li>
                  <li>Discretionary tips for guides and chauffeur</li>
                  <li>Personal travel insurance</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="dest-faq-box">
            <h3 class="dest-faq-title">Frequently Asked Questions: Tours from Casablanca</h3>
            
            <div class="dest-faq-item active">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Can our tour end in Marrakech instead of Casablanca?</h4>
              <div class="dest-faq-a">
                <p>Yes! Many international travelers book open-jaw flights: arriving in Casablanca (CMN) and departing from Marrakech Menara Airport (RAK). We design your itinerary to finish directly at Marrakech airport with zero backtracking.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">How flexible is the daily schedule during the tour?</h4>
              <div class="dest-faq-a">
                <p>Because your tour is 100% private, you control the pace. If you wish to sleep in an extra hour, stop at roadside cafes, or spend longer taking photos, your chauffeur is entirely at your service.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar -->
                <!-- Right Sticky Sidebar: Pre-Locked Route Card -->
        <aside class="dest-sidebar-col">
          <div class="dest-prelocked-widget"
               data-tour-name="Casablanca to Marrakech Chauffeur & City Highlights"
               data-price-1-4="145"
               data-price-5-7="185"
               data-price-8-12="260"
               data-tour-sub="Hassan II Mosque priority access · Direct VIP highway transfer">
            
            <div class="dest-prelocked-badge"><span>●</span> INSTANT DIRECT BOOKING</div>
            <h3 class="dest-prelocked-title">Casablanca to Marrakech Chauffeur & City Highlights</h3>
            <p class="dest-prelocked-sub">Hassan II Mosque priority access · Direct VIP highway transfer</p>

            <label class="dest-form-label" style="margin-bottom:6px;display:block;">Group Size &amp; Vehicle</label>
            <div class="dest-tier-grid">
              <button type="button" class="dest-tier-btn active" data-tier="1_4">
                <span class="dest-tier-pax">1–4 Pax</span>
                <span class="dest-tier-veh">Sedan / 4x4</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="5_7">
                <span class="dest-tier-pax">5–7 Pax</span>
                <span class="dest-tier-veh">VIP Van</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="8_12">
                <span class="dest-tier-pax">8–12 Pax</span>
                <span class="dest-tier-veh">Minibus</span>
              </button>
            </div>

            <div class="dest-prelocked-fields">
              <div class="dest-form-field">
                <label class="dest-form-label" for="pickupCityCasablanca">Departure City</label>
                <select class="dest-form-select dest-prelocked-city" id="pickupCityCasablanca">
                  <option value="Casablanca (CMN Airport)" selected>Casablanca (CMN Airport)</option>
                  <option value="Casablanca (City / Hotel)">Casablanca (City / Hotel)</option>
                  <option value="Marrakech (To Casablanca)">Marrakech (To Casablanca)</option>
                </select>
              </div>

              <div class="dest-form-field">
                <label class="dest-form-label" for="travelDateCasablanca">Approx. Travel Date</label>
                <input class="dest-form-input dest-prelocked-date" type="date" id="travelDateCasablanca">
              </div>
            </div>

            <div class="dest-prelocked-price-box">
              <div class="dest-prelocked-price-num">145€</div>
              <span class="dest-prelocked-price-sub">Total private group price (not per person)</span>
              <p class="dest-prelocked-price-note">Includes private Mercedes chauffeur, CMN airport or hotel pickup, highway tolls &amp; Marrakech door delivery.</p>
            </div>

            <a href="#" class="dest-prelocked-wa-btn">
              <img src="/img/whatsapp-logo.png" alt="WhatsApp">
              <span>Book via WhatsApp <span class="dest-prelocked-btn-price">— 145€</span></span>
            </a>

            <div class="dest-prelocked-trust">
              <span>🛡 <strong>100% Private:</strong> Dedicated vehicle &amp; local Berber driver.</span>
              <span>⚡ <strong>Fast Confirmation:</strong> Operations team replies &lt; 10 mins.</span>
              <span>🇲🇦 <strong>Zero Deposit:</strong> No upfront deposit needed to check dates.</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </main>

    <!-- Signature Footer -->

  <script is:inline>
    
    function scrollToBookingForm(e) {
      if (e) e.preventDefault();
      const formBox = document.querySelector('.dest-booking-widget') || document.querySelector('.dest-sidebar-col');
      if (formBox) {
        const yOffset = -80;
        const y = formBox.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        setTimeout(() => {
          const input = document.getElementById('clientName');
          if (input) input.focus();
        }, 500);
      }
    }

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.add("at-top");
          topEl.classList.remove("at-bottom");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = 'img/logo-for-dark-bg.png';
        } else {
          topEl.classList.add("at-bottom");
          topEl.classList.remove("at-top");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = 'img/logo-for-light-bg.png';
        }
      }
    }
    addEventListener("scroll", onScroll, {passive: true});
    onScroll();

    function toggleFaq(btn){
      const item = btn.closest('.dest-faq-item');
      if(item) item.classList.toggle('active');
    }

    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(burgerBtn && mobileDrawer){
      burgerBtn.addEventListener('click', function(e){
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      document.addEventListener('click', function(e){
        if(!mobileDrawer.contains(e.target) && !burgerBtn.contains(e.target)){
          mobileDrawer.classList.remove('open');
        }
      });
    }
    function closeDrawer(){
      if(mobileDrawer) mobileDrawer.classList.remove('open');
    }

    async function handleInquirySubmit(e, tourName){
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.dest-submit-btn');
      
      const name = (document.getElementById('clientName')?.value || '').trim();
      const email = (document.getElementById('clientEmail')?.value || '').trim();
      const phone = (document.getElementById('clientPhone')?.value || '').trim();
      const dates = (document.getElementById('travelDates')?.value || '').trim();
      const dur = (document.getElementById('tourDuration')?.value || '').trim();
      const notes = (document.getElementById('notes')?.value || '').trim();

      const payload = {
        name: name,
        email: email,
        phone: phone,
        service: tourName + (dur ? ` - ${dur}` : ''),
        pickup: 'Casablanca (CMN Airport / City)',
        duration: dur,
        date: dates,
        notes: notes,
        source: window.location.pathname
      };

      const waMsg = `Salam Roam Morocco! I would like to inquire about a ${tourName}:\n\n` +
        `👤 Name: ${name}\n` +
        `✉️ Email: ${email}\n` +
        `📱 WhatsApp: ${phone}\n` +
        (dur ? `⏱ Circuit Duration: ${dur}\n` : '') +
        (dates ? `📅 Arrival Date: ${dates}\n` : '') +
        (notes ? `📝 Notes: ${notes}\n` : '') +
        `\nCan you please confirm itinerary availability and send a detailed proposal?`;
      
      const waUrl = `https://wa.me/212653506441?text=${encodeURIComponent(waMsg)}`;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      let statusBox = document.getElementById('destFormStatus');
      if (!statusBox) {
        statusBox = document.createElement('div');
        statusBox.id = 'destFormStatus';
        statusBox.className = 'dest-form-status';
        form.appendChild(statusBox);
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: tourName,
          value: 200,
          currency: 'EUR'
        });
      }

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.innerHTML = `<strong>✓ Proposal Request Dispatched!</strong>Thank you, ${name}. Your inquiry for <strong>${tourName}</strong> has been sent to our team. We will review route and driver availability and email you at <strong>${email}</strong> within 30 minutes.<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Chat with Local Specialist on WhatsApp &rarr;</a>`;

        if (submitBtn) {
          submitBtn.textContent = '✓ REQUEST SENT TO OPERATIONS';
          submitBtn.style.background = '#16a34a';
          submitBtn.style.borderColor = '#16a34a';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 1000);

      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.innerHTML = `Connecting directly to our Marrakech WhatsApp desk...<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Open WhatsApp &rarr;</a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>

  <!-- Sticky Mobile Tour Bar (<900px) -->
  <div class="sticky-mobile-tour-bar">
    <div class="smt-info">
      <div class="smt-title">Casablanca to Marrakech Transfer</div>
      <div class="smt-price">From <span class="smt-price-num">145€</span> <span>per vehicle</span></div>
    </div>
    <a href="https://wa.me/212653506441?text=Salam%20Roam%20Morocco!%20I'm%20interested%20in%20the%20Casablanca%20to%20Marrakech%20Chauffeur%20&%20City%20Highlights." target="_blank" rel="noopener" class="smt-btn">
      <img src="/img/whatsapp-logo.png" alt="WhatsApp">
      <span>Book on WhatsApp</span>
    </a>
  </div>
</Layout>