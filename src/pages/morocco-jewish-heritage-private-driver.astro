---
import Layout from '../layouts/Layout.astro';

const title = "Private Chauffeur for Jewish Heritage Tours in Morocco | Roam Morocco";
const description = "Hire a licensed, Shabbat-friendly private driver for Moroccan Jewish roots tours. Toyota Prado 4x4 & Mercedes VIP vans, synagogue keyholder access & kosher logistics.";
const canonical = "https://roammorocco.tours/morocco-jewish-heritage-private-driver.html";
const ogImage = "https://roammorocco.tours/images/morocco-fes-medina-architecture.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://roammorocco.tours/#website",
      "name": "Roam Morocco Tours",
      "url": "https://roammorocco.tours/",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://roammorocco.tours/?s={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "TravelAgency",
      "@id": "https://roammorocco.tours/#agency",
      "name": "Roam Morocco Tours",
      "url": "https://roammorocco.tours/",
      "image": [
        "https://roammorocco.tours/images/morocco-fes-medina-architecture.jpg",
        "https://roammorocco.tours/images/fleet-toyota-prado-4x4.webp"
      ],
      "logo": "https://roammorocco.tours/images/Logos/roammorocco-favicon.png",
      "telephone": "+212 760-426269",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "N4, Immeuble, 38 Rue Tariq Bnou Ziad",
        "addressLocality": "Marrakech",
        "postalCode": "40000",
        "addressCountry": "MA"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "985",
        "reviewCount": "985"
      }
    },
    {
      "@type": [
        "Service",
        "Product"
      ],
      "@id": "https://roammorocco.tours/morocco-jewish-heritage-private-driver.html#service",
      "name": "Morocco Jewish Heritage Private Chauffeur Service",
      "serviceType": "Shabbat-Friendly Tourist Chauffeur & Heritage Transport",
      "brand": {
        "@type": "Brand",
        "name": "Roam Morocco Tours"
      },
      "provider": {
        "@id": "https://roammorocco.tours/#agency"
      },
      "description": "Dedicated licensed English-speaking private driver service in Morocco tailored for Jewish heritage travel, roots research, synagogue keyholder access, and strict Shabbat compliance.",
      "offers": {
        "@type": "Offer",
        "url": "https://roammorocco.tours/morocco-jewish-heritage-private-driver.html",
        "priceCurrency": "EUR",
        "price": "180.00",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "180.00",
          "priceCurrency": "EUR",
          "unitText": "DAY"
        },
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-01-01",
        "priceValidUntil": "2027-12-31"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://roammorocco.tours/morocco-jewish-heritage-private-driver.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does your private driver accommodate Shabbat observance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your driver adheres strictly to your Shabbat schedule. On Friday afternoon, we ensure you arrive at your riad or hotel at least two hours before sunset. The vehicle remains parked and off the road throughout Shabbat until Saturday night Havdalah. The chauffeur stays on quiet standby and resumes driving on Sunday morning or Saturday night as requested."
          }
        },
        {
          "@type": "Question",
          "name": "Can the driver help arrange visits to locked synagogues and Mellah cemeteries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Most historic synagogues and Jewish cemeteries in Morocco (such as Ibn Danan in Fes, Slat Al Azama in Marrakech, or Rabbi Chaim Pinto in Essaouira) are locked and cared for by hereditary Muslim or Jewish guardians. Our drivers maintain direct telephone contacts with these caretakers and arrange entry so you never arrive at a locked door."
          }
        },
        {
          "@type": "Question",
          "name": "How do we handle kosher food during long intercity driving days?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All our private vehicles come equipped with an insulated chilled cooler box. When departing Casablanca or Marrakech, your driver assists with pickups from certified kosher restaurants or community caterers. On travel days, we stop at verified clean cafes with fresh fruit, raw nuts, and bottled water, or arrange fresh vegetarian/pescatarian meals according to your rabbinic guidelines."
          }
        },
        {
          "@type": "Question",
          "name": "What are the rates for a private driver for Jewish roots travel in Morocco?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our rates range from €180 to €220 per day for a modern 2024 Toyota Land Cruiser Prado TXL 4x4 or Mercedes-Benz V-Class VIP minivan. Flat multi-day packages start at €1,450 for an 8-day circuit and €1,850 for a 10-day circuit. All rates are all-inclusive of vehicle, driver lodging, per-diem meals, fuel, tolls, and insurance."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">
    :root {
      --gold-deep: #8A6A23;
      --gold-light: #C8A45C;
      --bg-cream: #f4efe6;
      --card-white: #ffffff;
      --border-subtle: rgba(0, 0, 0, 0.1);
      --text-black: #050505;
      --text-muted: rgba(0, 0, 0, 0.72);
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #f4efe6 !important;
      color: #000000 !important;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    main.heritage-driver-main {
      padding: 120px 24px 80px;
    }

    .container-boxed {
      max-width: 1040px;
      margin: 0 auto;
    }

    .kicker-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.14);
      border: 1px solid rgba(200, 164, 92, 0.3);
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 20px;
    }
    .kicker-badge::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #8A6A23;
    }

    .hero-heading {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: clamp(32px, 5.2vw, 56px);
      font-weight: 800;
      letter-spacing: -.04em;
      line-height: 1.08;
      text-transform: uppercase;
      color: #000000;
      margin: 0 0 20px;
    }

    .hero-lead {
      font-size: clamp(17px, 2vw, 20px);
      line-height: 1.65;
      color: rgba(0, 0, 0, 0.82);
      max-width: 840px;
      margin: 0 0 32px;
    }

    .trust-meta-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 40px;
      font-size: 13px;
      font-weight: 600;
      color: rgba(0, 0, 0, 0.7);
    }
    .trust-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 999px;
      padding: 8px 18px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    }

    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      margin: 40px 0;
    }
    .pillar-card {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.09);
      border-radius: 16px;
      padding: 28px 26px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
      transition: transform .2s ease;
    }
    .pillar-card:hover {
      transform: translateY(-2px);
    }
    .pillar-icon {
      font-size: 26px;
      margin-bottom: 12px;
      display: block;
    }
    .pillar-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 19px;
      font-weight: 800;
      text-transform: uppercase;
      color: #000000;
      margin: 0 0 10px;
    }
    .pillar-desc {
      font-size: 15px;
      line-height: 1.65;
      color: rgba(0, 0, 0, 0.78);
      margin: 0;
    }

    .rates-box {
      background: #ffffff;
      border: 1px solid rgba(0,0,0,0.12);
      border-radius: 20px;
      padding: 36px 32px;
      margin: 48px 0;
      box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    }
    .rates-box h3 {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 24px;
      font-weight: 800;
      text-transform: uppercase;
      margin: 0 0 16px;
    }

    .rates-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      font-size: 15px;
    }
    .rates-table th {
      text-align: left;
      padding: 12px 16px;
      background: #f7f5f0;
      border-bottom: 2px solid rgba(0,0,0,0.1);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: .05em;
    }
    .rates-table td {
      padding: 14px 16px;
      border-bottom: 1px solid rgba(0,0,0,0.08);
      color: rgba(0,0,0,0.85);
    }
    .rates-table tr:last-child td {
      border-bottom: none;
    }
    .price-tag {
      font-weight: 800;
      color: #000000;
    }

    .btn-wa-solid {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 10px !important;
      background: #25D366 !important;
      color: #ffffff !important;
      font-weight: 800 !important;
      font-size: 14px !important;
      text-transform: uppercase !important;
      letter-spacing: .04em !important;
      padding: 16px 32px !important;
      border-radius: 9999px !important;
      text-decoration: none !important;
      transition: all .25s ease !important;
      box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35) !important;
    }
    .btn-wa-solid:hover {
      background: #20BA59 !important;
      transform: translateY(-2px) !important;
    }

    .btn-outline-black {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 8px !important;
      background: #000000 !important;
      color: #ffffff !important;
      font-weight: 800 !important;
      font-size: 14px !important;
      text-transform: uppercase !important;
      letter-spacing: .04em !important;
      padding: 16px 30px !important;
      border-radius: 9999px !important;
      text-decoration: none !important;
      transition: all .25s ease !important;
    }
    .btn-outline-black:hover {
      background: #262626 !important;
      transform: translateY(-2px) !important;
    }

    .faq-section-block {
      margin: 48px 0;
    }
    .faq-card {
      background: #ffffff;
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 14px;
      padding: 22px 26px;
      margin-bottom: 16px;
    }
    .faq-q {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 18px;
      font-weight: 800;
      text-transform: uppercase;
      margin: 0 0 10px;
      color: #000000;
    }
    .faq-a {
      font-size: 15px;
      line-height: 1.7;
      color: rgba(0,0,0,0.8);
      margin: 0;
    }
  </style>

  <main class="heritage-driver-main">
    <div class="container-boxed">
      
      <div class="kicker-badge">SPECIALIZED TOURIST CHAUFFEUR // SHABBAT COMPLIANT</div>
      <h1 class="hero-heading">Private Driver in Morocco for Jewish Heritage &amp; Roots Tours</h1>
      <p class="hero-lead">
        Explore Morocco's 2,000-year Jewish history with a dedicated licensed English-speaking chauffeur. Modern 2024 Toyota Prado 4x4 &amp; Mercedes VIP fleet, liaison with hereditary Mellah keyholders, on-board kosher cooling, and 100% Shabbat-compliant scheduling.
      </p>

      <div class="trust-meta-strip">
        <span class="trust-pill">🛡 Official Série T Ministry of Tourism Chauffeur</span>
        <span class="trust-pill">🕊 Strict Shabbat Timing (Vehicle Off Friday-Saturday)</span>
        <span class="trust-pill">🔑 Heritage Keyholder Contacts Across Morocco</span>
        <span class="trust-pill">💶 Transparent Flat Daily &amp; Circuit Rates</span>
      </div>

      <!-- Quick Action Buttons -->
      <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 48px;">
        <a href="https://wa.me/212760426269?text=Salam%20Roam%20Morocco!%20I'd%20like%20to%20hire%20a%20private%20driver%20for%20a%20Jewish%20Heritage%20Tour." class="btn-wa-solid" target="_blank" rel="noopener">
          <img src="/img/whatsapp-logo.png" alt="WhatsApp" class="wa-btn-icon notranslate" translate="no" width="20" height="20">
          <span>Inquire Chauffeur on WhatsApp</span>
        </a>
        <a href="/tour-jewish-heritage.html" class="btn-outline-black">
          View 8–12 Day Tour Itinerary
        </a>
      </div>

      <!-- 4 Core Trust Pillars -->
      <div class="pillars-grid">
        <div class="pillar-card">
          <span class="pillar-icon">🕊</span>
          <h3 class="pillar-title">1. Shabbat-Observant Schedule</h3>
          <p class="pillar-desc">
            We understand the sanctity of Shabbat. On Fridays, your chauffeur schedules the route so you reach your riad or hotel well before candle-lighting time. The vehicle remains parked and off the road throughout Shabbat until Havdalah. We coordinate accommodations situated within walking distance of active synagogues like Slat Al Azama in Marrakech or Temple Beth-El in Casablanca.
          </p>
        </div>

        <div class="pillar-card">
          <span class="pillar-icon">🔑</span>
          <h3 class="pillar-title">2. Synagogue Keyholder Access</h3>
          <p class="pillar-desc">
            Many historic Moroccan synagogues and Jewish cemeteries—including Ibn Danan in Fes, Sefrou, and Rabbi Chaim Pinto in Essaouira—are kept locked under the watchful care of hereditary guardians. Your driver calls ahead to local caretakers to ensure gates are unlocked, lights are burning, and you receive a respectful, warm welcome without waiting outside.
          </p>
        </div>

        <div class="pillar-card">
          <span class="pillar-icon">❄️</span>
          <h3 class="pillar-title">3. Kosher Logistics &amp; Cooler Box</h3>
          <p class="pillar-desc">
            Traveling kosher in Morocco requires thoughtful logistics. Our executive vehicles are equipped with a chilled electric cooler box for your perishables, cheeses, and vacuum-sealed meals. In Casablanca and Marrakech, your driver facilitates pickups from certified kosher caterers and helps source strictly vegetarian or whole-fish dining along highway segments.
          </p>
        </div>

        <div class="pillar-card">
          <span class="pillar-icon">🗺</span>
          <h3 class="pillar-title">4. Roots Research &amp; Hiloulot</h3>
          <p class="pillar-desc">
            Tracing family ancestry in Meknes, Debdou, Demnate, or the High Atlas? Traveling for an annual Hiloula pilgrimage to Rabbi Amram Ben Diwan in Ouezzane or Rabbi David Ben Barroukh in Taroudant? Your driver knows the mountain tracks, local town elders, and cemetery records to help guide your family pilgrimage.
          </p>
        </div>
      </div>

      <!-- Transparent Vehicle Rates -->
      <div class="rates-box">
        <h3>Transparent Flat Rates for Private Chauffeur</h3>
        <p style="font-size: 15px; color: rgba(0,0,0,0.75); margin-bottom: 24px;">
          All rates are flat per vehicle (covering 1 to 6 passengers). Rates include all fuel, highway tolls, chauffeur lodging and per-diem expenses throughout Morocco, airport pick-up/drop-off, and commercial passenger transport insurance.
        </p>

        <table class="rates-table">
          <thead>
            <tr>
              <th>Service / Package</th>
              <th>Duration</th>
              <th>Vehicle Type</th>
              <th>Flat Vehicle Rate</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Daily Custom Chauffeur Hire</strong></td>
              <td>1 Day (Full Flexibility)</td>
              <td>2024 Toyota Prado 4x4 or Mercedes V-Class</td>
              <td class="price-tag">€180 – €220 / day</td>
            </tr>
            <tr>
              <td><strong>Essential Mellahs Circuit</strong></td>
              <td>8 Days (Casablanca, Fes, Meknes, Marrakech)</td>
              <td>2024 Toyota Prado TXL 4x4</td>
              <td class="price-tag">€1,450 all-inclusive</td>
            </tr>
            <tr>
              <td><strong>Essential Mellahs Circuit (VIP)</strong></td>
              <td>8 Days (Casablanca, Fes, Meknes, Marrakech)</td>
              <td>2024 Mercedes-Benz V-Class VIP</td>
              <td class="price-tag">€1,680 all-inclusive</td>
            </tr>
            <tr>
              <td><strong>Grand Heritage &amp; Shrines Circuit</strong></td>
              <td>10 Days (+ Sefrou, Essaouira, Atlas)</td>
              <td>2024 Toyota Prado TXL 4x4</td>
              <td class="price-tag">€1,850 all-inclusive</td>
            </tr>
            <tr>
              <td><strong>Grand Heritage &amp; Shrines Circuit (VIP)</strong></td>
              <td>10 Days (+ Sefrou, Essaouira, Atlas)</td>
              <td>2024 Mercedes-Benz V-Class VIP</td>
              <td class="price-tag">€2,150 all-inclusive</td>
            </tr>
            <tr>
              <td><strong>All-Morocco Pilgrimage &amp; Deep Roots</strong></td>
              <td>12 Days (+ Ouezzane, Souss, Southern Mellahs)</td>
              <td>2024 Toyota Prado TXL 4x4</td>
              <td class="price-tag">€2,250 all-inclusive</td>
            </tr>
            <tr>
              <td><strong>Extended Family Minibus (VIP Coach)</strong></td>
              <td>8 to 12 Days (7–15 passengers)</td>
              <td>Mercedes-Benz Sprinter VIP Coach</td>
              <td class="price-tag">From €2,100 all-inclusive</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Fleet Overview -->
      <h2>Executive Fleet Tailored for Heritage Circuits</h2>
      <p style="font-size: 16px; line-height: 1.6; color: rgba(0,0,0,0.8); margin-bottom: 28px;">
        Unlike unlicensed city taxis, our company-owned fleet meets all Moroccan tourist transport standards, featuring high-speed cellular Wi-Fi, multi-zone air conditioning, leather seating, and USB charging.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-bottom: 48px;">
        <div style="background: #ffffff; border: 1px solid rgba(0,0,0,0.1); border-radius: 16px; overflow: hidden;">
          <img src="/images/fleet-toyota-prado-4x4.webp" alt="Toyota Prado TXL 4x4 Chauffeur Vehicle" style="width: 100%; height: 200px; object-fit: cover; display: block;">
          <div style="padding: 20px;">
            <h4 style="font-family: Helvetica, Arial, sans-serif; font-size: 18px; font-weight: 800; text-transform: uppercase; margin: 0 0 6px;">Toyota Prado TXL 4x4</h4>
            <p style="font-size: 14px; color: rgba(0,0,0,0.75); line-height: 1.6; margin: 0;">Ideal for couples and small families (1–4 passengers). High clearance for mountain villages and rural Mellah roads with luxurious leather comfort.</p>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid rgba(0,0,0,0.1); border-radius: 16px; overflow: hidden;">
          <img src="/images/fleet-mercedes-v-class.webp" alt="Mercedes V-Class VIP Chauffeur Minivan" style="width: 100%; height: 200px; object-fit: cover; display: block;">
          <div style="padding: 20px;">
            <h4 style="font-family: Helvetica, Arial, sans-serif; font-size: 18px; font-weight: 800; text-transform: uppercase; margin: 0 0 6px;">Mercedes-Benz V-Class VIP</h4>
            <p style="font-size: 14px; color: rgba(0,0,0,0.75); line-height: 1.6; margin: 0;">Designed for families and senior travelers (3–6 passengers). Captain chairs, easy step-in access, conference layout, and ample space for multi-week luggage.</p>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid rgba(0,0,0,0.1); border-radius: 16px; overflow: hidden;">
          <img src="/images/fleet-mercedes-sprinter-vip.webp" alt="Mercedes Sprinter VIP Minibus" style="width: 100%; height: 200px; object-fit: cover; display: block;">
          <div style="padding: 20px;">
            <h4 style="font-family: Helvetica, Arial, sans-serif; font-size: 18px; font-weight: 800; text-transform: uppercase; margin: 0 0 6px;">Mercedes-Benz Sprinter VIP</h4>
            <p style="font-size: 14px; color: rgba(0,0,0,0.75); line-height: 1.6; margin: 0;">Built for multi-generational family roots tours and synagogue delegations (7–15 passengers) with panoramic windows, PA microphone, and high roof.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="faq-section-block">
        <h2 style="font-family: Helvetica, Arial, sans-serif; font-size: 26px; font-weight: 800; text-transform: uppercase; margin-bottom: 24px;">Frequently Asked Questions</h2>

        <div class="faq-card">
          <h3 class="faq-q">Is it safe for Jewish travelers to visit Morocco?</h3>
          <p class="faq-a">
            Morocco is universally recognized as one of the safest, most welcoming countries for Jewish travelers in the world. The Moroccan Monarchy has maintained an unbroken constitutional pledge to safeguard Jewish citizens, heritage sites, and visiting pilgrims. Synagogues and community institutions operate openly. Having a dedicated licensed Moroccan driver adds an extra layer of local warmth, language ease, and seamless navigation.
          </p>
        </div>

        <div class="faq-card">
          <h3 class="faq-q">How do we book our hotels and riads?</h3>
          <p class="faq-a">
            You maintain 100% control over your accommodations. You can book riads and luxury hotels directly through your preferred loyalty programs or platforms. We provide complimentary recommendations for properties located within walking distance of active synagogues (such as in Marrakech Medina near Hay Essalam or Casablanca's Gauthier / Racine neighborhoods) to ensure hassle-free Shabbat observance.
          </p>
        </div>

        <div class="faq-card">
          <h3 class="faq-q">Can our chauffeur meet us at the airport?</h3>
          <p class="faq-a">
            Yes! Your private chauffeur meets you directly inside the terminal arrivals hall at Casablanca Mohammed V (CMN), Marrakech Menara (RAK), Fes Saïss (FEZ), or Rabat-Salé (RBA), holding a personalized name greeting board and assisting with your luggage.
          </p>
        </div>

        <div class="faq-card">
          <h3 class="faq-q">Can we hire licensed local Jewish heritage guides for city tours?</h3>
          <p class="faq-a">
            While your chauffeur handles all intercity highway driving and door-to-door transit, we can easily arrange licensed official Moroccan step-on heritage guides specializing in Jewish history for walking tours through the Medina of Fes or Marrakech (typically ~€50–€70 for a half-day private walking tour).
          </p>
        </div>
      </div>

