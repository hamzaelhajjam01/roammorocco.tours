  <!-- Script for Interactive Customizer -->
  <script is:inline>
    (function() {
      const WHATSAPP_NUM = "212760426269";
      
      const destPills = document.querySelectorAll('#dest-options .c-pill');
      const durPills = document.querySelectorAll('#dur-options .c-pill');
      const stylePills = document.querySelectorAll('#style-options .c-pill');
      const groupPills = document.querySelectorAll('#group-options .c-pill');

      const sumDur = document.getElementById('sum-dur');
      const sumStyle = document.getElementById('sum-style');
      const sumGroup = document.getElementById('sum-group');
      const sumDest = document.getElementById('sum-dest');
      const waBtn = document.getElementById('wa-submit-btn');

      // Multi-select for destinations
      destPills.forEach(pill => {
        pill.addEventListener('click', () => {
          pill.classList.toggle('selected');
          updateSummary();
        });
      });

      // Single select helper
      function setupSingleSelect(pills, displayElem) {
        pills.forEach(pill => {
          pill.addEventListener('click', () => {
            pills.forEach(p => p.classList.remove('selected'));
            pill.classList.add('selected');
            if (displayElem) displayElem.textContent = pill.textContent;
            updateSummary();
          });
        });
      }

      setupSingleSelect(durPills, sumDur);
      setupSingleSelect(stylePills, sumStyle);
      setupSingleSelect(groupPills, sumGroup);

      function getSelectedValues(pills) {
        const selected = [];
        pills.forEach(p => {
          if (p.classList.contains('selected')) {
            selected.push(p.getAttribute('data-value'));
          }
        });
        return selected;
      }

      function updateSummary() {
        const dests = getSelectedValues(destPills);
        sumDest.textContent = dests.length > 0 ? dests.join(', ') : 'Custom Selection';

        const dur = document.querySelector('#dur-options .c-pill.selected')?.getAttribute('data-value') || '7 to 10 Days';
        const style = document.querySelector('#style-options .c-pill.selected')?.getAttribute('data-value') || 'Luxury Riads';
        const group = document.querySelector('#group-options .c-pill.selected')?.getAttribute('data-value') || 'Couple';

        const msg = `Salam Roam Morocco! I configured a custom tour on your website:%0A%0A` +
          `• Destinations: ${dests.join(', ')}%0A` +
          `• Duration: ${dur}%0A` +
          `• Style: ${style}%0A` +
          `• Group & Transport: ${group}%0A%0A` +
          `Can you please send me a detailed itinerary quote and availability?`;

        waBtn.onclick = function() {
          window.open(`https://wa.me/${WHATSAPP_NUM}?text=${msg}`, '_blank');
        };
      }

      updateSummary();
    })();
  </script>

  <!-- Concierge Chatbot Widget Script -->
