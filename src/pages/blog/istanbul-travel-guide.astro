      letter-spacing: .05em;
      font-size: 12px;
      font-weight: 700;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .roam-area-card {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      padding: 28px;
      margin: 36px 0;
      border-left: 4px solid var(--gold, #C8A45C) !important;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .roam-area-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 16px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      padding-bottom: 12px;
    }

    .roam-area-header h3 {
      margin: 0;
      font-size: 24px;
    }

    .roam-area-badge {
      background: rgba(200, 164, 92, 0.12);
      color: #8A6A23;
      border: 1px solid rgba(200, 164, 92, 0.28);
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      padding: 4px 12px;
      border-radius: 999px;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.06em;
    }

    .roam-area-vibe {
      font-size: 14px;
      font-family: 'Inter', -apple-system, sans-serif;
      color: var(--text-muted);
      margin-bottom: 14px;
      font-weight: 500;
    }

    .roam-hotel-list {
      margin-top: 20px;
      background: #faf8f5;
      padding: 18px 22px;
      border-radius: 12px;
      border: 1px solid rgba(0,0,0,0.06);
    }

    .roam-hotel-list h4 {
      margin: 0 0 12px 0;
      font-size: 15px;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--gold);
    }

    .hotel-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      padding: 10px 0;
      border-bottom: 1px dashed var(--border);
      font-size: 15px;
    }

    .hotel-item:last-child {
      border-bottom: none;
    }

    .hotel-link {
      color: #000000;
      font-weight: 700;
      text-decoration: underline;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .hotel-link:hover {
      color: var(--gold);
    }

    .roam-toolkit-box {
      background: #ffffff;
      border: 1px solid var(--border);
      padding: 36px;
      margin: 48px 0;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.03);
    }

    .roam-toolkit-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 14px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: #000000;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
    }

        .roam-toolkit-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 16px;
    }

    .roam-toolkit-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 16px 20px;
      background: #fdfcf9;
      border: 1px solid var(--border);
      border-left: 4px solid var(--gold, #C8A45C);
      border-radius: 6px;
      color: #000000 !important;
      text-decoration: none !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
      transition: all .25s ease;
    }

    .roam-toolkit-link:hover {
      background: #ffffff;
      border-color: rgba(0, 0, 0, 0.25);
      border-left-color: #000000;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .roam-toolkit-link span:first-child {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.4;
      color: #111111;
      flex: 1 1 auto;
    }

    .roam-toolkit-link span:last-child:not(:only-child) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 14px;
      background: #000000;
      color: #ffffff !important;
      border: 1px solid #000000;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      white-space: nowrap;
      flex-shrink: 0;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    }

    .roam-toolkit-link:hover span:last-child:not(:only-child) {
      background: var(--gold, #C8A45C);
      border-color: var(--gold, #C8A45C);
      color: #000000 !important;
      box-shadow: 0 4px 12px rgba(200, 164, 92, 0.35);
    }

    @media (max-width: 580px) {
      .roam-toolkit-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .roam-toolkit-link {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
        padding: 16px 18px;
      }
      .roam-toolkit-link span:last-child:not(:only-child) {
        width: 100%;
        text-align: center;
        justify-content: center;
        padding: 10px 14px;
      }
    }

    .roam-callout-ai {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      border-left: 4px solid var(--gold, #C8A45C) !important;
      padding: 24px;
      margin: 36px 0;
      font-size: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .roam-field-note {
      background: #faf8f5;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      padding: 28px;
      margin: 40px 0;
      position: relative;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .roam-field-note-quote {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 19px;
      font-style: italic;
      line-height: 1.6;
      margin: 0 0 12px 0;
      color: #000000;
    }

    .roam-field-note-author {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #8A6A23;
      font-weight: 700;
    }

    .faq-accordion {
