    }

    .verdict-box {
      background: #ffffff;
      border: 2px solid #000000;
      padding: 30px;
      margin: 40px 0;
      box-shadow: 6px 6px 0px rgba(0,0,0,0.08);
    }

    .verdict-box h3 {
      margin-top: 0;
      font-size: 20px;
      text-transform: uppercase;
      letter-spacing: .06em;
      border-bottom: 1px solid var(--border);
      padding-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .verdict-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
      margin-top: 20px;
    }

    .verdict-card {
      background: #faf8f5;
      padding: 20px;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .verdict-card .tag {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 700;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.12);
      border: 1px solid rgba(200, 164, 92, 0.28);
      padding: 3px 10px;
      border-radius: 999px;
      display: inline-block;
      letter-spacing: 0.05em;
      margin-bottom: 10px;
    }

    .verdict-card .title {
      font-weight: 800;
      font-size: 17px;
      margin-bottom: 6px;
    }

    .verdict-card .desc {
      font-size: 14px;
      line-height: 1.5;
      color: var(--text-muted);
      margin: 0;
    }

    .table-container {
      overflow-x: auto;
      margin: 36px 0;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 15px;
    }

    th, td {
      padding: 14px 18px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      border-right: 1px solid rgba(0, 0, 0, 0.06);
    }

    th {
      background: #18181B;
      color: #ffffff;
      font-family: 'Inter', -apple-system, sans-serif;
