            <span class="roam-toolkit-label">🏨 Best Riad Deals</span>
            <span class="roam-toolkit-btn">Booking.com &rarr;</span>
          </a>
          <a href="https://www.discovercars.com/?a_aid=578287" target="_blank" rel="noopener" class="roam-toolkit-link">
            <span class="roam-toolkit-label">🚗 Compare Car Rentals</span>
            <span class="roam-toolkit-btn">DiscoverCars &rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </article>

