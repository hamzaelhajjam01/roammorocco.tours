---
import Layout from '../layouts/Layout.astro';

const title = "Moroccan Jewish Heritage & Mellahs Tour: 8, 10 & 12 Days | Roam Morocco";
const description = "Private Jewish heritage tour across Morocco. Casablanca Jewish Museum, Fes Ibn Danan Synagogue, Sefrou, Marrakech Mellah & Essaouira with a licensed chauffeur.";
const canonical = "https://roammorocco.tours/tour-jewish-heritage.html";
const ogImage = "https://roammorocco.tours/images/morocco-fes-medina-architecture.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css", "/css/roam-toc.css?v=20260928_gold2"];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://roammorocco.tours/?s={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How does Roam Morocco accommodate Shabbat observance during the tour?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "All our Jewish heritage itineraries are structured around Shabbat. On Friday afternoon, your chauffeur ensures you are settled at your luxury riad or hotel well before candle-lighting time. The vehicle remains parked and off the road throughout Shabbat until Havdalah on Saturday night. We select accommodations within easy walking distance of active synagogues such as Temple Beth-El in Casablanca or Slat Al Azama in Marrakech."
        }
      },
      {
        "@type": "Question",
        "name": "Are kosher meals available during the private tour in Morocco?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Certified kosher restaurants and catering kitchens operate in Casablanca (such as Cercle de l'Union and Chabad Lubavitch) and Marrakech (Kosher Club and local community caterers). For rural and travel days between cities, we equip your private vehicle with a chilled cooler box, assist you with picking up prepared meals in advance, or reserve vetted pescatarian, vegetarian, and fresh-baked local dining options."
        }
      },
      {
        "@type": "Question",
        "name": "How do we access locked synagogues and historic Jewish cemeteries in Morocco?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Many historic synagogues and Mellah cemeteries across Morocco (including Ibn Danan in Fes, Rabbi Chaim Pinto in Essaouira, and Sefrou) are locked and tended by hereditary Muslim or Jewish guardians. Your Roam Morocco chauffeur maintains direct contact with these caretakers, coordinating visits in advance so doors are unlocked promptly upon your arrival."
        }
      },
      {
        "@type": "Question",
        "name": "What is included in the flat vehicle price?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our vehicle pricing is 100% transparent and flat per vehicle for up to 4–6 passengers. It includes your dedicated English-speaking licensed chauffeur, 2024 Toyota Prado TXL 4x4 or Mercedes-Benz V-Class VIP minivan, all fuel, highway tolls, chauffeur lodging and meals throughout the circuit, airport meet-and-greet, and full commercial passenger insurance. You book your preferred hotels directly with complete flexibility."
        }
      },
      {
        "@type": "Question",
        "name": "Can we visit specific family ancestral towns or rabbinic shrines (Hiloulot)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, roots travel and pilgrimage (Hiloula) requests are welcomed. We frequently tailor routes to include Rabbi Amram Ben Diwan in Asjen (Ouezzane), Rabbi David Ben Barroukh in Taroudant, the historic Jewish enclave of Debdou in eastern Morocco, or the High Atlas Mellahs of Demnate and Imi n'Ifri."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": [
      "TouristTrip",
      "Product"
    ],
    "@id": "https://roammorocco.tours/tour-jewish-heritage.html#trip",
    "name": "Moroccan Jewish Heritage & Mellahs Private Tour (8 to 12 Days)",
    "description": "Comprehensive private Jewish heritage circuit across Morocco. Explore Casablanca, Rabat, Volubilis, Meknes, Fes, Sefrou, Marrakech, and Essaouira with a dedicated licensed chauffeur.",
    "url": "https://roammorocco.tours/tour-jewish-heritage.html",
    "image": "https://roammorocco.tours/images/morocco-fes-medina-architecture.jpg",
    "touristType": [
      "Jewish Heritage Travelers",
      "Roots & Ancestry Travelers",
      "Families",
      "Private Small Groups"
    ],
    "duration": "P10D",
    "brand": {
      "@type": "Brand",
      "name": "Roam Morocco Tours"
    },
    "provider": {
      "@type": "TravelAgency",
      "name": "Roam Morocco Tours",
      "url": "https://roammorocco.tours/",
      "telephone": "+212 653-506441"
    },
    "offers": {
      "@type": "Offer",
      "url": "https://roammorocco.tours/tour-jewish-heritage.html",
      "priceCurrency": "EUR",
      "price": "1450.00",
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-01-01",
      "priceValidUntil": "2027-12-31"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "bestRating": "5",
      "worstRating": "1",
      "ratingCount": "985",
      "reviewCount": "985"
    }
  }
];
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">
    :root {
      --bg-cream: #f2eee6;
      --card-bg: #ffffff;
      --border-subtle: rgba(0, 0, 0, 0.12);
      --border-strong: rgba(0, 0, 0, 0.22);
      --text-main: #000000;
      --text-muted: rgba(0, 0, 0, 0.72);
      --gold-accent: #8A6A23;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #f2eee6 !important;
      color: #000000 !important;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    main.roam-tour-main {
      background: #f2eee6 !important;
      color: #000000 !important;
      padding: 120px 24px 80px !important;
    }

    .roam-tour-wrapper {
      max-width: 960px;
      margin: 0 auto;
    }

    .roam-tour-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #8A6A23;
