      line-height: 1.7;
      color: rgba(0,0,0,0.85);
      margin: 0;
    }

    .roam-pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin: 36px 0;
    }
