      letter-spacing: .08em;
      color: #8A6A23;
      margin-bottom: 8px;
    }
    .tier-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 22px;
      font-weight: 800;
      text-transform: uppercase;
      margin: 0 0 12px;
    }
    .tier-rate {
      font-size: 32px;
      font-weight: 800;
      color: #000000;
      margin-bottom: 4px;
    }
    .tier-unit {
      font-size: 12px;
      color: rgba(0,0,0,0.6);
      margin-bottom: 18px;
    }
    .tier-features {
      list-style: none;
      padding: 0;
      margin: 0 0 24px;
      font-size: 14px;
      line-height: 1.6;
      color: rgba(0,0,0,0.8);
      display: grid;
      gap: 10px;
    }
    .tier-features li {
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    .roam-itinerary-card {
      background: #ffffff !important;
      border: 1px solid rgba(0, 0, 0, 0.08) !important;
      border-radius: 16px !important;
      padding: 32px 36px !important;
      margin-bottom: 24px !important;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03) !important;
    }
