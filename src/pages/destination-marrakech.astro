---
import Layout from '../layouts/Layout.astro';
import RouteGoogleMapCard from '../components/RouteGoogleMapCard.astro';

const title = "Marrakech Private Tours: Guided Medina Walks &amp; Day Trips";
const description = "Experience Marrakech in luxury: private guided Medina walking tours, secret palaces, Majorelle Gardens, Agafay desert glamping, and Atlas day trips.";
const canonical = "https://roammorocco.tours/destination-marrakech.html";
const ogImage = "https://roammorocco.tours/img/dest-marrakech.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css?v=20261012_sticky2"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "Marrakech Medina & The Red City",
      "description": "Morocco's vibrant imperial metropolis famous for Jemaa el-Fnaa square, opulent riads, artisan souks, and stunning backdrop of the snow-capped Atlas Mountains.",
      "url": "https://roammorocco.tours/destination-marrakech.html",
      "touristType": [
        "Cultural Travelers",
        "Luxury Vacationers",
        "Couples",
        "Culinary Explorers"
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 31.6295,
        "longitude": -7.9811
      }
    },
    {
      "@type": "TouristTrip",
      "name": "3-Day Curated Marrakech & Agafay Private Experience",
      "description": "A tailored private experience featuring insider Medina walking tours, private chauffeur excursions to the Agafay stone desert, and lush High Atlas valleys.",
      "provider": {
        "@type": "TravelAgency",
        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "telephone": "+212760426269"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why do I need a private guide in the Marrakech Medina?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The ancient Medina of Marrakech has over 9,000 alleys and a bustling souk culture. A licensed private guide shields you from aggressive street touts, takes you to authentic master artisans away from tourist shops, and reveals hidden historical riads and courtyards you would never find on your own."
          }
        },
        {
          "@type": "Question",
          "name": "How far is the Agafay Desert from Marrakech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Agafay stone desert is just 45 minutes south of Marrakech. It offers sweeping lunar hills, luxury desert camps, sunset camel rides, and fine dining under the stars without requiring a multi-day journey to the Sahara."
          }
        },
        {
          "@type": "Question",
          "name": "What are the best day trips starting from Marrakech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The top private day trips from Marrakech are: (1) The High Atlas Mountains & Imlil Berber villages, (2) Essaouira on the Atlantic coast, (3) The Agafay Desert for sunset dinners, and (4) The cinematic UNESCO fortress of A\u00eft Benhaddou."
          }
        }
      ]
    }
  ]
};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs & Badge -->
      <div class="dest-kicker-bar">
        <div class="dest-breadcrumb">
          <a href="/index.html">Home</a> &nbsp;/&nbsp; <a href="/destinations.html">Destinations</a> &nbsp;/&nbsp; <span>Marrakech</span>
        </div>
        <span class="dest-badge-tag">THE OCHRE CITY</span>
      </div>

      <!-- Hero Banner -->
      <div class="dest-hero">
        <img src="/img/dest-marrakech.jpg" alt="Marrakech Medina and Koutoubia Mosque" class="dest-hero-img">
        <div class="dest-hero-overlay">
          <h1 class="dest-hero-title">Private Marrakech Tours: Medina Secrets, Palaces &amp; Beyond</h1>
          <p class="dest-hero-subtitle">Step past the tourist crowds into tranquil hidden riads, master craft ateliers, botanical gardens, and the lunar desert of Agafay with an expert private host.</p>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> 2 to 4 Days (Customizable)</span>
        <span class="dest-metric-item">🛡 <strong>Style:</strong> Private Licensed Historian &amp; Chauffeur</span>
        <span class="dest-metric-item">📍 <strong>Base:</strong> Handpicked Luxury Medina Riad</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985 Verified Reviews)</span>
      </div>

      <!-- GEO & AEO Destination Fast Facts (BLUF) -->
      <aside class="ai-quick-summary-card" aria-label="Marrakech Travel Fast Facts">
        <div class="ai-summary-header">
          <span class="ai-summary-kicker">⚡ MARRAKECH AT A GLANCE (QUICK SUMMARY)</span>
          <span class="ai-summary-badge">The Ochre City Guide</span>
        </div>
        <p class="ai-summary-text">
          <strong>Marrakech</strong> is Morocco’s vibrant cultural capital, famous for its 12th-century UNESCO Medina, Bahia Palace, Saadian Tombs, and Jemaa el-Fnaa square. The ideal visit duration is <strong>3 to 4 days</strong>, combining historical Medina walks with short excursions to the High Atlas Mountains (Ourika Valley, 45 min) or Agafay Desert (40 min). Roam Morocco offers private licensed local historian guides, door-to-door riad transfers, and Mercedes chauffeured day trips with zero group tourist traps.
        </p>
      </aside>

      <!-- 2-Column Core Layout -->
      <div class="dest-layout-grid">

        <!-- Left Main Column -->
        <div class="dest-content-col">

          <!-- Highlights Callout Box -->
          <div class="dest-highlights-box">
            <h2 class="dest-highlights-title">⚡ Marrakech Highlights &amp; Private Exclusives</h2>
            <ul class="dest-highlights-list">
              <li><strong>Insider Medina Walking Tour:</strong> Unlock centuries-old secret courtyards, the 19th-century Bahia Palace, and the Saadian Tombs with a licensed historian.</li>
              <li><strong>Master Artisan Souk Encounters:</strong> Meet genuine woodworkers, leather tanners, and copper craftsmen without high-pressure sales tactics.</li>
              <li><strong>Jardin Majorelle &amp; YSL Museum:</strong> Skip-the-line VIP access to Jacques Majorelle’s cobalt botanical garden and Yves Saint Laurent's haute couture archive.</li>
              <li><strong>Agafay Desert Sunset Dinner:</strong> Private 45-minute drive into the stone desert for sunset dromedary camel rides and a candlelit nomad feast.</li>
              <li><strong>High Atlas Day Escapes:</strong> Optional day trip to the scenic Ourika Valley or Imlil for fresh mountain air and traditional Berber home cooking.</li>
            </ul>
          </div>

          <!-- Deep Narrative Overview -->
          <div class="dest-narrative">
            <h2>Experience Marrakech Without the Stress</h2>
            <p>Marrakech is an exhilarating sensory explosion: the scent of cedarwood and orange blossom, the call to prayer echoing from the 12th-century Koutoubia minaret, and the intoxicating theater of Jemaa el-Fnaa square. Yet for many first-time travelers, navigating the Medina alone can become overwhelming.</p>
            <p>Our approach transforms your Marrakech stay from chaotic to effortless. We pair you with an articulate, licensed local host who grew up inside the Medina walls. You walk at your personal rhythm, learning the profound Islamic architecture and Jewish Mellah heritage that most tourists completely miss.</p>
            
            <div style="background:#faf8f5;border:1px solid rgba(0,0,0,0.06);border-left:4px solid var(--gold,#C8A45C);border-radius:16px;padding:24px;margin:24px 0;">
              <p style="font-style:italic;margin:0 0 8px;font-size:15px;color:#333;">"Marrakech is a city of hidden interiors. The rough clay walls on the outside give zero hint of the breathtaking marble fountains and fragrant zellige courtyards tucked just behind the cedar doors."</p>
              <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— ROAM MOROCCO MEDINA JOURNAL</span>
            </div>
            
            <p>Beyond the ancient walls, our private chauffeur stands by in an executive air-conditioned vehicle to whisk you away to the Palmeraie, the art foundations of Gueliz, or the moon-like dunes of the Agafay Desert for sunset cocktails.</p>
          </div>

          <!-- Featured Excursion Route: Marrakech to Agafay Desert & Atlas -->
          <RouteGoogleMapCard
            origin="Marrakech"
            destination="Agafay Desert"
            distance="35 km"
            duration="40 min"
            highway="R212 via Agafay Stone Dunes"
            price={55}
            waUrl="https://wa.me/212760426269?text=Salam%20Roam%20Morocco!%20I'd%20like%20to%20inquire%20about%20a%20private%20day%20trip%20from%20Marrakech%20to%20Agafay%20Desert."
          />

          <!-- Day-by-Day Detailed Itinerary -->
          <div class="dest-itinerary-timeline">
            <h3 class="dest-itinerary-header">
              <span>Sample 3-Day Curated Marrakech Circuit</span>
              <span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:700;letter-spacing:0.06em;color:#8A6A23;background:rgba(200,164,92,0.12);border:1px solid rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;">ZERO HOTEL PACKING</span>
            </h3>

            <!-- Day 1 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 01 // PALACES, MEDINA ALLEYS &amp; JEMAA EL-FNAA</span>
              <h4 class="dest-day-title">The Imperial Heritage &amp; Secret Souks</h4>
              <p class="dest-day-desc">Meet your private licensed guide after a rooftop breakfast at your riad. Explore the stunning zellige tilework of the Bahia Palace, the 16th-century Saadian Tombs, and the historic Jewish Mellah. Wander deeper into the specialized artisan quarters—from the dyers’ souk to the spice market of Rahba Kedima. Savor lunch at an exclusive courtyard terrace before taking in sunset over Jemaa el-Fnaa.</p>
              <div class="dest-day-tags">
                <span>Walking Tour: 4–5 Hours</span>
                <span>Licensed Private Guide</span>
                <span>Skip-the-Line Monument Entry</span>
              </div>
            </div>

            <!-- Day 2 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 02 // BOTANICAL GARDENS &amp; AGAFAY DESERT SUNSET</span>
              <h4 class="dest-day-title">Majorelle Gardens → YSL Museum → Agafay Luxury Camp</h4>
              <p class="dest-day-desc">Your chauffeur picks you up at 09:30 AM for a morning visit to Jardin Majorelle and the Yves Saint Laurent Museum. In the afternoon, enjoy leisure time at your riad pool or a traditional Moroccan hammam. At 16:00, drive 45 minutes into the lunar Agafay Desert. Take a sunset camel ride across stone dunes, followed by fine dining and live acoustic Berber music under the Saharan constellation.</p>
              <div class="dest-day-tags">
                <span>Private Mercedes Chauffeur</span>
                <span>Agafay Desert 4x4 Excursion</span>
                <span>Sunset Dinner Included</span>
              </div>
            </div>

            <!-- Day 3 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 03 // HIGH ATLAS FOOTHILLS &amp; BERBER CULTURE</span>
              <h4 class="dest-day-title">Ourika Valley &amp; Setti Fatma Waterfalls OR Departure</h4>
              <p class="dest-day-desc">Escape the city heat on a scenic 1-hour drive into the High Atlas foothills. Follow the tumbling Ourika river, explore terraced walnut orchards, and visit a traditional Berber family home for fresh mint tea and homemade bread with olive oil and honey. Return to Marrakech in late afternoon for boutique shopping or seamless airport drop-off.</p>
              <div class="dest-day-tags">
                <span>Scenic Mountain Drive: 1 Hour</span>
                <span>Traditional Berber Tea Experience</span>
                <span>Airport Drop-Off Ready</span>
              </div>
            </div>
          </div>

          <!-- Inclusions & Exclusions Checklist -->
          <div class="dest-inclusions-card">
            <h3 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;margin:0 0 20px;">What's Included in Your Private Marrakech Package</h3>
            <div class="dest-inclusions-grid">
              <div class="dest-inc-col">
                <h4 style="color:#25D366;">✔ INCLUDED</h4>
                <ul class="dest-inc-list">
                  <li>Licensed English-speaking Marrakech historical guide</li>
                  <li>Dedicated private air-conditioned transport &amp; driver</li>
                  <li>Skip-the-line monument entries (Bahia, Saadian Tombs)</li>
                  <li>Agafay Desert private round-trip transfer &amp; sunset dinner</li>
                  <li>Complimentary airport pickup &amp; riad baggage assistance</li>
                  <li>Insider recommendations for vetted riads &amp; restaurants</li>
                </ul>
              </div>
              <div class="dest-inc-col">
                <h4 style="color:#f10b18;">✕ NOT INCLUDED</h4>
                <ul class="dest-exc-list">
                  <li>Jardin Majorelle timed tickets (booked in advance upon request)</li>
                  <li>Mid-day lunches and personal alcohol</li>
                  <li>Discretionary tips for guides, drivers, and riad staff</li>
                  <li>Personal spa/hammam treatments</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="dest-faq-box">
            <h3 class="dest-faq-title">Frequently Asked Questions: Marrakech Private Tours</h3>
            
            <div class="dest-faq-item active">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">How many days should I spend in Marrakech?</h4>
              <div class="dest-faq-a">
                <p>We recommend at least 3 full days. This allows 1 full day for the ancient Medina and historical palaces, 1 day for modern Marrakech (Majorelle, Gueliz) and the Agafay desert sunset, and 1 day for a refreshing day trip to the High Atlas mountains or Essaouira.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Is it safe to walk around Marrakech at night?</h4>
              <div class="dest-faq-a">
                <p>Yes. Marrakech is generally very safe, and Jemaa el-Fnaa comes alive after dark with families, musicians, and food stalls. Main thoroughfares are well-lit and heavily policed. As in any major destination, keep your belongings close in crowded areas.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Can we customize this tour to include cooking classes or a hammam?</h4>
              <div class="dest-faq-a">
                <p>Absolutely. Every itinerary we design is 100% bespoke. We can easily arrange an authentic riad culinary masterclass, a luxury royal hammam ritual, or early morning hot air balloon rides over the desert plains.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar -->
                <!-- Right Sticky Sidebar: Pre-Locked Route Card -->
        <aside class="dest-sidebar-col">
          <div class="dest-prelocked-widget"
               data-tour-name="Marrakech & Agafay Desert Private Tour"
               data-price-1-4="140"
               data-price-5-7="180"
               data-price-8-12="240"
               data-tour-sub="Private luxury chauffeur · Sunset camel ride &amp; Berber dinner">
            
            <div class="dest-prelocked-badge"><span>●</span> INSTANT DIRECT BOOKING</div>
            <h3 class="dest-prelocked-title">Marrakech & Agafay Desert Private Tour</h3>
            <p class="dest-prelocked-sub">Private luxury chauffeur · Sunset camel ride &amp; Berber dinner</p>

            <label class="dest-form-label" style="margin-bottom:6px;display:block;">Group Size &amp; Vehicle</label>
            <div class="dest-tier-grid">
              <button type="button" class="dest-tier-btn active" data-tier="1_4">
                <span class="dest-tier-pax">1–4 Pax</span>
                <span class="dest-tier-veh">Sedan / 4x4</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="5_7">
                <span class="dest-tier-pax">5–7 Pax</span>
                <span class="dest-tier-veh">VIP Van</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="8_12">
                <span class="dest-tier-pax">8–12 Pax</span>
                <span class="dest-tier-veh">Minibus</span>
              </button>
            </div>

            <div class="dest-prelocked-fields">
              <div class="dest-form-field">
                <label class="dest-form-label" for="pickupCityMarrakech">Departure City</label>
                <select class="dest-form-select dest-prelocked-city" id="pickupCityMarrakech">
                  <option value="Marrakech (Medina / Riad)" selected>Marrakech (Medina / Riad)</option>
                  <option value="Marrakech (Palmeraie)">Marrakech (Palmeraie)</option>
                  <option value="Marrakech (Gueliz / City)">Marrakech (Gueliz / City)</option>
                </select>
              </div>

              <div class="dest-form-field">
                <label class="dest-form-label" for="travelDateMarrakech">Approx. Travel Date</label>
                <input class="dest-form-input dest-prelocked-date" type="date" id="travelDateMarrakech">
              </div>
            </div>

            <div class="dest-prelocked-price-box">
              <div class="dest-prelocked-price-num">140€</div>
              <span class="dest-prelocked-price-sub">Total private group price (not per person)</span>
              <p class="dest-prelocked-price-note">Includes dedicated chauffeur, fuel, sunset camel trek, Moroccan tagine dinner &amp; campfire.</p>
            </div>

            <a href="#" class="dest-prelocked-wa-btn">
              <img src="/img/whatsapp-logo.png" alt="WhatsApp">
              <span>Book via WhatsApp <span class="dest-prelocked-btn-price">— 140€</span></span>
            </a>

            <div class="dest-prelocked-trust">
              <span>🛡 <strong>100% Private:</strong> Dedicated vehicle &amp; local Berber driver.</span>
              <span>⚡ <strong>Fast Confirmation:</strong> Operations team replies &lt; 10 mins.</span>
              <span>🇲🇦 <strong>Zero Deposit:</strong> No upfront deposit needed to check dates.</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </main>

    <!-- Signature Footer -->

  <script is:inline>
    
    function scrollToBookingForm(e) {
      if (e) e.preventDefault();
      const formBox = document.querySelector('.dest-booking-widget') || document.querySelector('.dest-sidebar-col');
      if (formBox) {
        const yOffset = -80;
        const y = formBox.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        setTimeout(() => {
          const input = document.getElementById('clientName');
          if (input) input.focus();
        }, 500);
      }
    }

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.add("at-top");
          topEl.classList.remove("at-bottom");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-dark-bg.png';
        } else {
          topEl.classList.add("at-bottom");
          topEl.classList.remove("at-top");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-light-bg.png';
        }
      }
    }
    addEventListener("scroll", onScroll, {passive: true});
    onScroll();

    function toggleFaq(btn){
      const item = btn.closest('.dest-faq-item');
      if(item) item.classList.toggle('active');
    }

    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(burgerBtn && mobileDrawer){
      burgerBtn.addEventListener('click', function(e){
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      document.addEventListener('click', function(e){
        if(!mobileDrawer.contains(e.target) && !burgerBtn.contains(e.target)){
          mobileDrawer.classList.remove('open');
        }
      });
    }
    function closeDrawer(){
      if(mobileDrawer) mobileDrawer.classList.remove('open');
    }

    async function handleInquirySubmit(e, tourName){
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.dest-submit-btn');
      
      const name = (document.getElementById('clientName')?.value || '').trim();
      const email = (document.getElementById('clientEmail')?.value || '').trim();
      const phone = (document.getElementById('clientPhone')?.value || '').trim();
      const dates = (document.getElementById('travelDates')?.value || '').trim();
      const guests = (document.getElementById('groupSize')?.value || '').trim();
      const notes = (document.getElementById('notes')?.value || '').trim();

      const payload = {
        name: name,
        email: email,
        phone: phone,
        service: tourName,
        pickup: tourName,
        date: dates,
        passengers: guests,
        notes: notes,
        source: window.location.pathname
      };

      const waMsg = `Salam Roam Morocco! I would like to inquire about the ${tourName}:\n\n` +
        `👤 Name: ${name}\n` +
        `✉️ Email: ${email}\n` +
        `📱 WhatsApp: ${phone}\n` +
        (dates ? `📅 Travel Dates: ${dates}\n` : '') +
        (guests ? `👥 Group Size: ${guests}\n` : '') +
        (notes ? `📝 Special Requests: ${notes}\n` : '') +
        `\nCan you please confirm availability and send a detailed itinerary proposal?`;
      
      const waUrl = `https://wa.me/212760426269?text=${encodeURIComponent(waMsg)}`;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      let statusBox = document.getElementById('destFormStatus');
      if (!statusBox) {
        statusBox = document.createElement('div');
        statusBox.id = 'destFormStatus';
        statusBox.className = 'dest-form-status';
        form.appendChild(statusBox);
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: tourName,
          value: 200,
          currency: 'EUR'
        });
      }

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.innerHTML = `<strong>✓ Proposal Request Dispatched!</strong>Thank you, ${name}. Your inquiry for <strong>${tourName}</strong> has been sent to our Marrakech team. We will review riad and route availability and email you at <strong>${email}</strong> within 30 minutes.<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Chat with Local Specialist on WhatsApp &rarr;</a>`;

        if (submitBtn) {
          submitBtn.textContent = '✓ REQUEST SENT TO OPERATIONS';
          submitBtn.style.background = '#16a34a';
          submitBtn.style.borderColor = '#16a34a';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 1000);

      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.innerHTML = `Connecting directly to our Marrakech WhatsApp desk...<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Open WhatsApp &rarr;</a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>

  <!-- Sticky Mobile Tour Bar (<900px) -->
  <div class="sticky-mobile-tour-bar">
    <div class="smt-info">
      <div class="smt-title">Marrakech &amp; Agafay Private Tour</div>
      <div class="smt-price">From <span class="smt-price-num">140€</span> <span>per vehicle</span></div>
    </div>
    <a href="https://wa.me/212760426269?text=Salam%20Roam%20Morocco!%20I'm%20interested%20in%20the%20Marrakech%20&%20Agafay%20Desert%20Private%20Tour." target="_blank" rel="noopener" class="smt-btn">
      <img src="/img/whatsapp-logo.png" alt="WhatsApp">
      <span>Book on WhatsApp</span>
    </a>
  </div>
</Layout>