---
import Layout from '../layouts/Layout.astro';

const title = "Refund Policy - RoamMorocco";
const description = "Review the official refund and cancellation policy for Roam Morocco Tours. Clear guidelines on booking deposits, date changes, and tour refunds.";
const canonical = "https://roammorocco.tours/refund-policy.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/"
  },
  "publisher": {
    "@type": "TravelAgency",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png"
    }
  }
};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

        body {
            background-color: #060605;
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        h1 {
            color: #FFFFFF;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: 600;
        }
        h2 {
            color: #C8A45C;
            font-size: 1.5rem;
            margin-top: 40px;
            margin-bottom: 15px;
            font-weight: 500;
        }
        p {
            margin-bottom: 20px;
        }
        a {
            color: #C8A45C;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 40px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    
  </style>

  <div class="container">
        <a href="/" class="back-link">← Back to Home</a>
        <h1>Refund &amp; Cancellation Policy</h1>
        <p>At Roam Morocco Tours, we maintain straightforward, traveler-friendly cancellation and refund terms designed for complete peace of mind.</p>
        
        <h2>1. Services Under $300 (€300) — Zero Prepayment &amp; Free Cancellation</h2>
        <p>For transfers, airport pickups, and day excursions priced at $300 or less, <strong>no advance deposit is required (0% deposit)</strong>. Because no prepayment is taken upfront, you may modify dates or cancel your journey completely free of charge up to 24 hours prior to your scheduled pickup time with a simple message on WhatsApp or email.</p>

        <h2>2. Multi-Day Tours &amp; Services Exceeding $300 (€300)</h2>
        <p>For custom multi-day expeditions and services over $300, a 30% confirmation deposit is collected to guarantee your vehicle, chauffeur, and riad/camp accommodations:</p>
        <ul>
          <li><strong>Cancellations 14+ Days Before Departure:</strong> 100% refund of your deposit, minus any strictly non-refundable third-party riad/luxury camp reservation fees.</li>
          <li><strong>Cancellations Within 14 Days:</strong> Your 30% deposit is converted into a 100% flexible travel credit valid for 18 months, transferable to any rescheduled dates.</li>
          <li><strong>Flight Disruptions or Force Majeure:</strong> In case of airline cancellations or emergencies, we will gladly reschedule your private chauffeur itinerary at zero penalty.</li>
        </ul>

        <h2>3. Contact Our Booking Desk</h2>
        <p>For refund requests, date changes, or booking adjustments, reach us 24/7 at <a href="mailto:contact@roammorocco.tours">contact@roammorocco.tours</a> or on WhatsApp at <a href="https://wa.me/212760426269">+212 760 426 269</a>.</p>
    </div>
  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->
</Layout>