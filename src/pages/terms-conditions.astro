---
import Layout from '../layouts/Layout.astro';

const title = "Terms & Conditions - RoamMorocco";
const description = "Official terms and conditions for Roam Morocco Tours. Review booking agreements, payment terms, traveler responsibilities, and private tour policies.";
const canonical = "https://roammorocco.tours/terms-conditions.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/"
  },
  "publisher": {
    "@type": "TravelAgency",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png"
    }
  }
};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

        body {
            background-color: #060605;
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        h1 {
            color: #FFFFFF;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: 600;
        }
        h2 {
            color: #C8A45C;
            font-size: 1.5rem;
            margin-top: 40px;
            margin-bottom: 15px;
            font-weight: 500;
        }
        p {
            margin-bottom: 20px;
        }
        a {
            color: #C8A45C;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 40px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    
  </style>

  <div class="container">
        <a href="/" class="back-link">← Back to Home</a>
        <h1>Terms &amp; Conditions</h1>
        <p>Welcome to Roam Morocco Tours. By booking a private transfer, excursion, or multi-day tour package with us, you agree to these transparent Terms &amp; Conditions.</p>
        
        <h2>1. Transparent Deposit &amp; Booking Policy</h2>
        <p><strong>• Services of $300 (€300) or Less:</strong> We require <strong>0% upfront deposit</strong>. Single airport transfers, intercity corridor transfers, and short day trips priced at $300 or less can be confirmed instantly via WhatsApp or email with zero payment required today. You pay 100% of the flat quoted fare directly to your driver in cash (EUR, USD, GBP, or MAD) upon arrival at your destination.</p>
        <p><strong>• Multi-Day Tours &amp; Services Exceeding $300 (€300):</strong> For comprehensive multi-day journeys, bespoke private expeditions, and services exceeding $300, a transparent <strong>30% confirmation deposit</strong> is required to secure your dedicated vehicle, licensed chauffeur, and local accommodations/camps. The remaining 70% balance is settled directly upon your arrival in Morocco.</p>

        <h2>2. Pricing &amp; All-Inclusive Inclusions</h2>
        <p>All private chauffeur quotes provided by Roam Morocco Tours are strictly all-inclusive. Quoted fares cover the private vehicle, commercial passenger transport insurance, all fuel, highway tolls, parking fees, and driver meals/accommodations. There are never any surprise surcharges.</p>

        <h2>3. Flight Tracking &amp; Delays</h2>
        <p>For airport pickups (Marrakech RAK, Casablanca CMN, Tangier TNG, Fes FEZ, Agadir AGA), our dispatch team tracks your flight in real-time. Even if your inbound flight is delayed, your dedicated driver will wait curbside at arrivals with a personalized name sign at no additional charge.</p>

        <h2>4. Contact &amp; Concierge Support</h2>
        <p>If you have any questions regarding your booking, please contact our 24/7 concierge at <a href="mailto:contact@roammorocco.tours">contact@roammorocco.tours</a> or directly via WhatsApp at <a href="https://wa.me/212760426269">+212 760 426 269</a>.</p>
    </div>
  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->
</Layout>