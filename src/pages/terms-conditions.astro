---
import Layout from '../layouts/Layout.astro';

const title = "Terms & Conditions - RoamMorocco";
const description = "Official terms and conditions for Roam Morocco Tours. Review booking agreements, payment terms, traveler responsibilities, and private tour policies.";
const canonical = "https://roammorocco.tours/terms-conditions.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/"
  },
  "publisher": {
    "@type": "TravelAgency",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png"
    }
  }
};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

        body {
            background-color: #060605;
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        h1 {
            color: #FFFFFF;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: 600;
        }
        h2 {
            color: #C8A45C;
            font-size: 1.5rem;
            margin-top: 40px;
            margin-bottom: 15px;
            font-weight: 500;
        }
        p {
            margin-bottom: 20px;
        }
        a {
            color: #C8A45C;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 40px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    
  </style>

  <div class="container">
        <a href="/" class="back-link">← Back to Home</a>
        <h1>Terms & Conditions</h1>
        <p>This is a placeholder for the Terms & Conditions of RoamMorocco. Please update this page with your official legal terms.</p>
        <h2>1. Introduction</h2>
        <p>Welcome to RoamMorocco. By booking a tour with us, you agree to these Terms & Conditions.</p>
        <h2>2. Booking and Payments</h2>
        <p>All bookings are subject to availability. Payment terms and scheduling will be agreed upon during the reservation process.</p>
        <h2>3. Contact Us</h2>
        <p>If you have any questions, please contact us at <a href="mailto:contact@roammorocco.tours">contact@roammorocco.tours</a> or via WhatsApp at <a href="https://wa.me/212760426269">+212 760 426 269</a>.</p>
    </div>
  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->
</Layout>