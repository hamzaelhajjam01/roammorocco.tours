---
import Layout from '../../layouts/Layout.astro';

const title = "Politique de remboursement - RoamMaroc";
const description = "Consultez la politique officielle de remboursement et d’annulation de Roam Morocco Tours. Des directives claires sur les dépôts de réservation, les changements de date et les remboursements des visites.";
const canonical = "https://roammorocco.tours/fr/refund-policy.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/"
  },
  "publisher": {
    "@type": "TravelAgency",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png"
    }
  }
};
---
<Layout lang="fr" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

        body {
            background-color: #060605;
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        h1 {
            color: #FFFFFF;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: 600;
        }
        h2 {
            color: #C8A45C;
            font-size: 1.5rem;
            margin-top: 40px;
            margin-bottom: 15px;
            font-weight: 500;
        }
        p {
            margin-bottom: 20px;
        }
        a {
            color: #C8A45C;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 40px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    
  </style>

  <div class="container">
        <a href="/fr/" class="back-link">← Back to Home</a>
        <h1>Politique de Remboursement et d'Annulation</h1>
        <p>Chez Roam Morocco Tours, nous appliquons une politique d'annulation claire et équitable pour voyager l'esprit tranquille.</p>
        
        <h2>1. Prestations jusqu'à 300 $ (300 €) — Zéro Prépaiement & Annulation Gratuite</h2>
        <p>Pour les transferts et excursions de 300 $ ou moins, <strong>aucun acompte n'est requis (0 % d'acompte)</strong>. Vous pouvez modifier vos dates ou annuler gratuitement jusqu'à 24h avant l'heure de prise en charge par simple message WhatsApp.</p>

        <h2>2. Circuits et Prestations supérieures à 300 $ (300 €)</h2>
        <p>Pour les circuits de plusieurs jours où un acompte de 30 % a été versé :</p>
        <ul>
          <li><strong>Annulation à plus de 14 jours :</strong> Remboursement intégral de l'acompte, déduction faite des frais d'hébergements/riads non remboursables.</li>
          <li><strong>Annulation à moins de 14 jours :</strong> Votre acompte de 30 % est converti en avoir 100 % flexible valable 18 mois pour de nouvelles dates.</li>
          <li><strong>Perturbations aériennes :</strong> En cas d'annulation de vol, report gratuit et sans pénalité.</li>
        </ul>

        <h2>3. Contact Conciergerie</h2>
        <p>Contactez-nous 24h/24 à <a href="mailto:contact@roammorocco.tours">contact@roammorocco.tours</a> ou via WhatsApp au <a href="https://wa.me/212760426269">+212 760 426 269</a>.</p></div>
  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->
</Layout>