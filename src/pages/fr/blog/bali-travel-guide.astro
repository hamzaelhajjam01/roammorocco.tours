      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
      padding-top: 16px;
    }

    .meta-bar span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .gold-accent {
      color: var(--gold);
      font-weight: bold;
    }

    .article-hero-fig {
      margin: 0 0 48px 0;
