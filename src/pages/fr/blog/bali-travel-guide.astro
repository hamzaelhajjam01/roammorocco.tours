      border-top: 1px solid rgba(0,0,0,0.06);
    }

    .faq-item.active .faq-answer {
      display: block;
    }

    .roam-morocco-bridge {
      background: #000000;
      color: #ffffff;
      padding: 40px 32px;
      margin: 50px 0;
      border-radius: 20px;
      border: 1px solid rgba(200, 164, 92, 0.45);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
    }

    .roam-morocco-bridge h3 {
      color: #ffffff;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(22px, 3vw, 30px);
      margin: 0 0 14px 0;
    }

    .roam-morocco-bridge p {
      color: rgba(255, 255, 255, 0.85);
      font-size: 16px;
      margin-bottom: 24px;
    }

    .bridge-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
