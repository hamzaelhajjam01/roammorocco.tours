      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.12);
      border: 1px solid rgba(200, 164, 92, 0.28);
      padding: 4px 12px;
      border-radius: 999px;
      margin-bottom: 18px;
    }

    .article-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(32px, 5vw, 54px);
      line-height: 1.15;
      font-weight: 700;
