---
import Layout from '../../layouts/Layout.astro';

const title = "Visites des lieux de tournage au Maroc : Aït Benhaddou et les studios Atlas";
const description = "Explorez des décors de cinéma légendaires avec des visites privées des lieux de tournage au Maroc. Promenez-vous dans la Kasbah Ait Benhaddou, visitez les studios de cinéma Atlas, les décors de Gladiator II et Ouarzazate.";
const canonical = "https://roammorocco.tours/fr/tour-heritage-cinema.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css", "/css/roam-toc.css?v=20260928_gold2"];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://roammorocco.tours/?s={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": [
      "TouristTrip",
      "Product"
    ],
    "@id": "https://roammorocco.tours/tour-heritage-cinema.html#trip",
    "name": "Morocco Film Location Tours: Ait Benhaddou & Atlas Studios",
    "description": "Private guided day excursion through Morocco's cinematic heritage. Walk UNESCO Kasbah Ait Benhaddou, explore Atlas Film Studios sets from Gladiator, Lawrence of Arabia, and Game of Thrones, crossing the High Atlas Mountains.",
    "touristType": [
      "Film Enthusiast",
      "Cultural Explorer",
      "History Buff"
    ],
    "duration": "P1D",
    "image": [
