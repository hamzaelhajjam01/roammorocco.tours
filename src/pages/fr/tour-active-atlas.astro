    }
    .roam-btn-black:hover,
    .roam-tour-content a.roam-btn-black:hover,
    a.roam-btn-black:hover {
      background: #262626 !important;
      color: #ffffff !important;
      border-color: #262626 !important;
      transform: translateY(-2px) !important;
