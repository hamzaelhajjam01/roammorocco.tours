      padding: 32px 36px;
      margin-bottom: 40px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.03);
    }

    .roam-highlights-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 20px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: -.03em;
      color: #000000;
      margin: 0 0 20px;
    }

    .roam-highlight-list {
      list-style: none !important;
      padding: 0 !important;
      margin: 0 !important;
      display: grid;
      gap: 14px;
    }

    .roam-highlight-list li {
      display: flex;
      align-items: flex-start;
