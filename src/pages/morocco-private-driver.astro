<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

    :root {
      --gold: #C8A45C;
      --gold-dark: #9A7836;
      --gold-light: #dfc17f;
      --bg-cream: #f2eee6;
      --card-bg: #ffffff;
      --border-subtle: rgba(0, 0, 0, 0.12);
      --border-strong: rgba(0, 0, 0, 0.22);
      --text-main: #000000;
      --text-muted: rgba(0, 0, 0, 0.72);
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-cream);
      color: var(--text-main);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* Hero Section */
    .driver-hero {
      position: relative;
      padding: 130px 24px 70px;
      text-align: center;
      background: var(--bg-cream);
      border-bottom: 1px solid var(--border-subtle);
    }

    .driver-kicker-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 6px 16px;
      background: rgba(200, 164, 92, 0.12);
      border: 1px solid rgba(200, 164, 92, 0.28);
      border-radius: 999px;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      color: #8A6A23;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 24px;
    }

    .driver-kicker-badge::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
    }

    .driver-hero h1 {
      font-family: Helvetica, Arial, sans-serif;
      font-size: clamp(34px, 5.5vw, 62px);
      line-height: 1.0;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: -0.05em;
      max-width: 980px;
      margin: 0 auto 20px;
      color: #000000;
    }

    .driver-hero-subtitle {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: clamp(17px, 2.2vw, 21px);
      line-height: 1.6;
      color: var(--text-muted);
      max-width: 780px;
      margin: 0 auto 36px;
    }

    /* Trust Pill Grid */
    .driver-trust-strip {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      max-width: 900px;
      margin: 0 auto 36px;
    }

    .trust-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 999px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
      padding: 8px 18px;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #000000;
    }

    .trust-pill span.gold-check {
      color: var(--gold);
      font-weight: 900;
      font-size: 14px;
    }

    /* Hero CTA Row */
    .driver-hero-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
    }

    .btn-gold-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: #18181B;
      color: #ffffff;
      border: 1px solid #18181B;
      border-radius: 10px;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 16px 32px;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn-gold-primary:hover {
      background: var(--gold);
      color: #000000;
      border-color: var(--gold);
      transform: translateY(-2px);
    }

    .btn-wa-solid {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: linear-gradient(135deg, #25D366 0%, #1EBE5D 100%);
      color: #ffffff !important;
      border: none;
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(37, 211, 102, 0.28);
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 16px 28px;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn-wa-solid:hover {
      background: linear-gradient(135deg, #20BA59 0%, #17A34F 100%);
      color: #ffffff !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(37, 211, 102, 0.35);
    }

    /* Section Container */
    .driver-section-wrap {
      max-width: 1080px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .driver-section-head {
      margin-bottom: 48px;
      text-align: center;
    }

    .driver-sec-kicker {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #8A6A23;
      display: block;
      margin-bottom: 8px;
    }

    .driver-sec-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: clamp(26px, 4vw, 42px);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: -0.04em;
      margin: 0 0 14px;
      color: #000000;
    }

    .driver-sec-desc {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 16px;
      color: var(--text-muted);
      max-width: 680px;
      margin: 0 auto;
      line-height: 1.65;
    }

    /* Fleet Cards Grid */
    .fleet-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 32px;
      margin-bottom: 40px;
    }

    .fleet-card {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-top: 4px solid var(--gold);
      border-radius: 16px;
      padding: 36px 30px;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.03);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .fleet-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
    }

    .fleet-image-wrap {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 22px;
      aspect-ratio: 16 / 10;
      background: #faf8f5;
      border: 1px solid rgba(0, 0, 0, 0.08);
    }

    .fleet-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .fleet-card:hover .fleet-img {
      transform: scale(1.05);
    }

    .fleet-img-overlay {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 2;
    }

    .fleet-img-tag {
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      color: #ffffff;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .fleet-header {
      margin-bottom: 20px;
    }

    .fleet-type-badge {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #8A6A23;
      display: block;
      margin-bottom: 6px;
    }

    .fleet-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 22px;
      font-weight: 800;
      margin: 0 0 12px;
      color: #000000;
      letter-spacing: -0.02em;
    }

    .fleet-specs-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 20px;
    }

    .spec-pill {
      background: #faf8f5;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 999px;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 600;
      padding: 5px 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .fleet-desc {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 14.5px;
      line-height: 1.65;
      color: #444444;
      margin-bottom: 24px;
    }

    .fleet-features-list {
      list-style: none;
      padding: 0;
      margin: 0 0 28px;
      font-size: 13.5px;
      color: #222222;
    }

    .fleet-features-list li {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 10px;
    }

    .fleet-features-list li span.bullet {
      color: var(--gold);
      font-weight: 900;
    }

    .fleet-rate-box {
      border-top: 1px solid var(--border-subtle);
      padding-top: 20px;
      margin-top: auto;
    }

    .fleet-rate-tag {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #777;
      display: block;
      margin-bottom: 4px;
    }

    .fleet-price {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 26px;
      font-weight: 800;
      color: #000000;
      letter-spacing: -0.02em;
    }

    .fleet-price span {
      font-size: 13px;
      font-weight: 400;
      color: #666;
    }

    /* Tables & Horizontal Scroll */
    .table-container {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 32px 0 40px;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      overflow: hidden;
