---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

    :root {
      --bg-cream: #f2eee6;
      --card-bg: #ffffff;
      --border-subtle: rgba(0, 0, 0, 0.12);
      --border-strong: rgba(0, 0, 0, 0.22);
      --text-main: #000000;
      --text-muted: rgba(0, 0, 0, 0.72);
      --red: #f10b18;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #f2eee6 !important;
      color: #000000 !important;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    main.roam-tour-main {
      background: #f2eee6 !important;
      color: #000000 !important;
      padding: 120px 24px 80px !important;
    }

    .roam-tour-wrapper {
      max-width: 960px;
      margin: 0 auto;
    }

    .roam-tour-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.12);
