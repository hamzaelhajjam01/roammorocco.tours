      border: 1px solid rgba(0, 0, 0, 0.12);
      padding: 32px 36px;
      margin-bottom: 40px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.03);
    }

    .roam-highlights-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 20px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: -.03em;
      color: #000000;
      margin: 0 0 20px;
    }

    .roam-highlight-list {
      list-style: none !important;
      padding: 0 !important;
      margin: 0 !important;
      display: grid;
      gap: 14px;
    }

    .roam-highlight-list li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 17px;
      line-height: 1.6;
      color: rgba(0, 0, 0, 0.84);
    }

    .roam-highlight-bullet {
      color: var(--red);
      font-weight: 900;
      font-size: 16px;
      flex-shrink: 0;
      margin-top: -1px;
    }
  
    /* Action Buttons in Tour Pages */
    .roam-btn-black,
    .roam-tour-content a.roam-btn-black,
    a.roam-btn-black {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 8px !important;
      background: #000000 !important;
      color: #ffffff !important;
      font-family: Helvetica, Arial, sans-serif !important;
      font-weight: 800 !important;
      font-size: 13px !important;
      text-transform: uppercase !important;
      letter-spacing: .05em !important;
      padding: 14px 28px !important;
      border: 1px solid #000000 !important;
      border-radius: 9999px !important;
      text-decoration: none !important;
      cursor: pointer !important;
      line-height: 1 !important;
      transition: all .25s ease !important;
    }
    .roam-btn-black:hover,
    .roam-tour-content a.roam-btn-black:hover,
    a.roam-btn-black:hover {
      background: #262626 !important;
      color: #ffffff !important;
      border-color: #262626 !important;
      transform: translateY(-2px) !important;
      text-decoration: none !important;
    }

    .roam-btn-wa,
    .roam-tour-content a.roam-btn-wa,
    a.roam-btn-wa {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 8px !important;
      background: #25D366 !important;
      color: #000000 !important;
      font-family: Helvetica, Arial, sans-serif !important;
      font-weight: 800 !important;
      font-size: 13px !important;
      text-transform: uppercase !important;
      letter-spacing: .05em !important;
      padding: 14px 28px !important;
      border: 1px solid #25D366 !important;
      border-radius: 9999px !important;
      text-decoration: none !important;
      cursor: pointer !important;
      line-height: 1 !important;
      transition: all .25s ease !important;
    }
    .roam-btn-wa:hover,
    .roam-tour-content a.roam-btn-wa:hover,
    a.roam-btn-wa:hover {
      background: #20BA59 !important;
      color: #000000 !important;
      border-color: #20BA59 !important;
      transform: translateY(-2px) !important;
      text-decoration: none !important;
    }

    .roam-tour-cta-box,
    .roam-driver-box {
      background: #ffffff !important;
      border: 1px solid rgba(0, 0, 0, 0.14) !important;
      padding: 44px 32px !important;
      margin: 48px 0 !important;
      text-align: center !important;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.05) !important;
      border-radius: 24px !important;
    }
    .roam-tour-cta-title,
    .roam-driver-box h4 {
      font-family: Helvetica, Arial, sans-serif !important;
      font-size: clamp(20px, 3.2vw, 28px) !important;
      font-weight: 800 !important;
