      <!-- 4. GINZA -->
      <div class="roam-area-card" id="ginza">
        <div class="roam-area-header">
          <div>
            <h3>4. Ginza: Polierte Eleganz, gehobene Küche und Luxus der Spitzenklasse</h3>
