      {
        "@type": "Question",
        "name": "Do I need a visa to visit Morocco?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Citizens of the US, UK, Canada, Australia, and most of Europe do not need a visa for tourist visits up to 90 days. Always check with your local embassy before traveling."
        }
      },
      {
        "@type": "Question",
        "name": "Is Morocco safe for tourists?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, Morocco is generally very safe for tourists. The government places a high priority on tourist safety. Like any destination, practice common sense, especially in crowded medinas."
        }
      },
      {
        "@type": "Question",
        "name": "What should female travelers wear in Morocco?",
        "acceptedAnswer": {
          "@type": "Answer",
