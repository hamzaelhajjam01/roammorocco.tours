    }

    .faq-question {
      padding: 18px 22px;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 0;
    }

    .faq-question::after {
      content: "+";
      font-size: 22px;
      font-weight: 400;
      color: var(--gold);
      transition: transform 0.2s ease;
    }

