      padding: 28px;
      margin: 40px 0;
      position: relative;
    }

    .roam-field-note-quote {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 19px;
      font-style: italic;
      line-height: 1.6;
      margin: 0 0 12px 0;
      color: #000000;
    }

    .roam-field-note-author {
