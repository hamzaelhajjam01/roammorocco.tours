      margin: 48px 0;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.03);
    }

    .roam-toolkit-title {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 14px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: #000000;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border);
