    }

    .roam-toolkit-link:hover span:last-child:not(:only-child) {
      background: var(--gold, #C8A45C);
      border-color: var(--gold, #C8A45C);
      color: #000000 !important;
      box-shadow: 0 4px 12px rgba(200, 164, 92, 0.35);
    }

    @media (max-width: 580px) {
      .roam-toolkit-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .roam-toolkit-link {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
        padding: 16px 18px;
      }
      .roam-toolkit-link span:last-child:not(:only-child) {
        width: 100%;
        text-align: center;
        justify-content: center;
        padding: 10px 14px;
      }
    }

    .roam-callout-ai {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      border-left: 4px solid var(--gold, #C8A45C) !important;
      padding: 24px;
      margin: 36px 0;
      font-size: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
