      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .roam-toolkit-link span:first-child {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.4;
      color: #111111;
      flex: 1 1 auto;
    }

    .roam-toolkit-link span:last-child:not(:only-child) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 14px;
      background: #000000;
      color: #ffffff !important;
      border: 1px solid #000000;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      white-space: nowrap;
