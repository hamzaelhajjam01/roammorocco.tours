        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://roammorocco.tours/blog/morocco-train-and-private-driver.html"
