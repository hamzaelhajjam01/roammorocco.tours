      <div class="roam-tour-cta-box" style="background:#000000; color:#ffffff; padding:48px 36px; margin:48px 0; text-align:center; border-radius:20px; border:1px solid rgba(200, 164, 92, 0.45); box-shadow:0 16px 48px rgba(0, 0, 0, 0.35);">
