      gap: 6px;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.12);
      border: 1px solid rgba(200, 164, 92, 0.28);
      padding: 4px 12px;
      border-radius: 999px;
      margin-bottom: 18px;
    }

    .article-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(32px, 5vw, 54px);
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin: 0 0 20px 0;
      color: #000000;
    }

    .article-subtitle {
      font-size: clamp(18px, 2.2vw, 22px);
      line-height: 1.5;
      color: var(--text-muted);
      margin: 0 0 24px 0;
    }

    .meta-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 13px;
      font-family: 'Inter', -apple-system, sans-serif;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
      padding-top: 16px;
    }

    .meta-bar span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .gold-accent {
      color: var(--gold);
      font-weight: bold;
    }

    .article-hero-fig {
      margin: 0 0 48px 0;
      border: 1px solid var(--border);
      background: #ffffff;
      padding: 10px;
    }

    .article-hero-fig img {
      width: 100%;
