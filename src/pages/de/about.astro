---
import Layout from '../../layouts/Layout.astro';

const title = "Über uns – Roam Morocco Tours | Menschenzentriertes Reisen";
const description = "Roam Morocco ist ein Boutique-Reisebüro in Marrakesch, das private, maßgeschneiderte Expeditionen und immersive Touren mit Schwerpunkt auf lokalen marokkanischen Reiseführern und der Kultur entwirft.";
const canonical = "https://roammorocco.tours/de/about.html";
const ogImage = "https://roammorocco.tours/img/about-riad.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About RoamMorocco \u2014 Human-Centered Travel Philosophy",
  "url": "https://roammorocco.tours/about.html",
  "description": "Learn about Roam Morocco Tours: Boutique private custom travel agency based in Marrakech, founded on human-centered travel and authentic local Berber connections.",
  "mainEntity": {
    "@type": "TravelAgency",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "telephone": "+212 760-426269",
    "priceRange": "$$$$",
    "knowsAbout": [
      "Morocco Private Tours",
      "Berber Culture and Heritage",
      "Sahara Desert Expeditions",
      "High Atlas Mountain Trekking",
      "Fes and Marrakech Medina Heritage"
    ],
    "knowsLanguage": [
      "en",
      "fr",
      "ar",
      "ber"
    ],
    "sameAs": [
      "https://www.facebook.com/roammorocco",
      "https://www.instagram.com/roammorocco",
      "https://www.pinterest.com/roammoroccotours/",
      "https://chromewebstore.google.com/detail/roam-morocco-%E2%80%94-dirham-mad/flngffoeefehejlapaoaompgeomnnion",
      "https://addons.mozilla.org/en-US/firefox/addon/roam-morocco-travel-guide/"
    ],
    "founder": [
      {
        "@type": "Person",
        "name": "Hamza",
        "jobTitle": "Co-Founder & Expedition Curator"
      },
      {
        "@type": "Person",
        "name": "Abdelhakim",
        "jobTitle": "Co-Founder & Operations Lead"
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "N4, Immeuble, 38 Rue Tariq Bnou Ziad",
      "addressLocality": "Marrakech",
      "postalCode": "40000",
      "addressCountry": "MA"
    }
  }
};
---
<Layout lang="de" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

    :root{
      --white:#fff;--black:#000;--soft:#f4f4f4;--muted:#d9d9d9;--red:#f10b18;
    }
    *, *::before, *::after {
      box-sizing: border-box;
    }
    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #f2eee6;
      color: #000000;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }

    /* Announcement Bar */
    .announcement-bar {
      background: #f8f8f8;
      border-bottom: 1px solid rgba(0,0,0,0.08);
      padding: 8px 0;
      overflow: hidden;
      white-space: nowrap;
    }
    .announcement-track {
      display: flex;
      width: max-content;
      animation: announcementScroll 36s linear infinite;
    }
    .announcement-content {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 12px;
      font-weight: 500;
      color: #333;
      padding-right: 20px;
    }
    .announcement-content strong { font-weight: 800; color: #000; }
    @keyframes announcementScroll { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

    /* ── HEADER NAVIGATION — DYNAMIC MORPH ── */
    .top{
      position:fixed; z-index:200; display:flex; align-items:center; pointer-events:none; transition: top .48s cubic-bezier(.16,1,.3,1), bottom .48s cubic-bezier(.16,1,.3,1), left .48s cubic-bezier(.16,1,.3,1), right .48s cubic-bezier(.16,1,.3,1), transform .48s cubic-bezier(.16,1,.3,1), opacity .35s ease, gap .45s ease;
    }
    .top.at-top{ top:56px; bottom:auto; left:16px; right:16px; transform:translateY(0); justify-content:space-between; width:auto; }
    .top.at-top .navbox{ pointer-events:auto; background:rgba(255,255,255,0.78); backdrop-filter:blur(30px) saturate(1.8); -webkit-backdrop-filter:blur(30px) saturate(1.8); border:1px solid rgba(255,255,255,0.9); box-shadow:0 10px 32px rgba(0,0,0,0.05); border-radius:9999px; display:flex; align-items:center; color:#000; transition:all .45s cubic-bezier(.16,1,.3,1); }
    .top.at-top .navbox{ gap:22px; padding:10px 24px 10px 20px; min-height:52px; }
    .top .wordmark img{ height:40px; width:auto; display:block; transition:opacity .3s ease; }
    .top.at-top .burger-btn{color:#000}
    .top.at-top nav.desktop-nav{display:flex;gap:20px}
    .top.at-top nav.desktop-nav a{ font-size:13px; font-weight:700; letter-spacing:-.2px; color:#000; padding:6px 12px; border-radius:9999px; background:transparent; border:none; transition:all .25s ease; }
    .top.at-top nav.desktop-nav a:hover, .top.at-top nav.desktop-nav a.active{ background:rgba(0,0,0,0.06); color:#000; }

    .top.at-bottom{ top:auto; bottom:24px; left:50%; right:auto; transform:translateX(-50%); justify-content:center; gap:10px; width:max-content; }
    .top.at-bottom .navbox{ pointer-events:auto; background:rgba(18,18,18,0.92); backdrop-filter:blur(30px) saturate(1.8); -webkit-backdrop-filter:blur(30px) saturate(1.8); border:1px solid rgba(255,255,255,0.16); box-shadow:0 16px 48px rgba(0,0,0,0.32); border-radius:9999px; display:flex; align-items:center; color:#fff; transition:all .45s cubic-bezier(.16,1,.3,1); }
    .top.at-bottom .navbox{ gap:14px; padding:8px 10px 8px 18px; min-height:52px; }
    .top.at-bottom .burger-btn{color:#fff}
    .top.at-bottom nav.desktop-nav{display:flex;gap:4px}
    .top.at-bottom nav.desktop-nav a{ font-size:12px; font-weight:700; letter-spacing:.01em; color:rgba(255,255,255,0.85); padding:8px 14px; border-radius:9999px; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.08); transition:all .25s ease; }
    .top.at-bottom nav.desktop-nav a:hover, .top.at-bottom nav.desktop-nav a.active{ background:rgba(255,255,255,0.22); color:#fff; transform:translateY(-1px); }

    .burger-btn{ display:none!important; background:transparent!important; border:none!important; padding:6px!important; cursor:pointer!important; align-items:center!important; justify-content:center!important; border-radius:10px!important; transition:all .25s ease!important; }
    @media (max-width:900px){
      .burger-btn{display:inline-flex!important}
      .top.at-top .burger-btn{ color:#000!important; background:rgba(0,0,0,0.06)!important; border:1px solid rgba(0,0,0,0.1)!important; }
      .top.at-top .burger-btn svg{ stroke:#000!important; }
      .top.at-bottom .burger-btn{ color:#fff!important; background:rgba(255,255,255,0.12)!important; border:1px solid rgba(255,255,255,0.18)!important; }
      .top.at-bottom .burger-btn svg{ stroke:#fff!important; }
    }
    .dot{width:7px;height:7px;background:#C8A45C!important;border-radius:50%!important;display:inline-block;box-shadow:0 0 8px rgba(200,164,92,0.8),0 0 14px rgba(200,164,92,0.4)!important;animation:blink-gold 1.5s infinite}
    @keyframes blink-gold{50%{opacity:.28;transform:scale(.7);box-shadow:0 0 4px rgba(200,164,92,0.4);}}

    /* Back To Top Button */
    .back-top-btn{ pointer-events:auto; width:52px; height:52px; border-radius:50%!important; background:rgba(18,18,18,0.92); backdrop-filter:blur(30px) saturate(1.8); -webkit-backdrop-filter:blur(30px) saturate(1.8); border:1px solid rgba(255,255,255,0.16); box-shadow:0 12px 36px rgba(0,0,0,0.25); color:#fff; display:inline-flex; align-items:center; justify-content:center; cursor:pointer; transition:all .3s cubic-bezier(.16,1,.3,1); }
    .back-top-btn:hover{ background:#222; transform:translateY(-2px); box-shadow:0 16px 44px rgba(0,0,0,0.35); color:#fff; }
    .top.at-top .back-top-btn{ display:none!important; }
    .top.at-bottom .back-top-btn{ display:inline-flex!important; }

    /* Mobile Drawer */
    .mobile-nav-drawer{ position:fixed; bottom:calc(68px + env(safe-area-inset-bottom, 0px))!important; top:auto; left:12px!important; right:12px!important; z-index:100000!important; background:rgba(18,18,18,0.95); backdrop-filter:blur(40px); -webkit-backdrop-filter:blur(40px); border-radius:32px; padding:24px 20px; opacity:0; transform:translateY(20px) scale(.96); pointer-events:none; transition:opacity .3s ease,transform .3s ease; box-shadow:0 24px 60px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.18); }
    .mobile-nav-drawer.open{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}
    .mobile-drawer-inner{display:flex;flex-direction:column;gap:12px}
    .mobile-drawer-inner > a{color:#fff;font-size:13.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:12px 18px;border-radius:9999px;background:rgba(255,255,255,0.08)}

    /* ── PAGE CONTAINER (MAX WIDTH 1380PX MATCHING HOME PAGE) ── */
    .page-container {
      max-width: 1380px;
      margin: 0 auto;
      padding: 140px 48px 0;
    }

    .section-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.12);
      border: 1px solid rgba(200, 164, 92, 0.28);
      padding: 5px 14px;
      border-radius: 999px;
      margin-bottom: 24px;
    }
    .section-badge::before { content:""; width:6px; height:6px; border-radius: 50%; background: #C8A45C; }

    .section-title {
      font-size: clamp(52px, 8vw, 118px);
      font-weight: 800;
      letter-spacing: -.078em;
      line-height: .84;
      text-transform: uppercase;
      margin: 0 0 48px;
      color: #000;
      user-select: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    .split-line { display: block; overflow: hidden; padding-bottom: .08em; }
    .split-word {
      display: block;
      transform: translate3d(0, 115%, 0);
      transition: transform .9s cubic-bezier(.16,1,.3,1);
    }
    .split-line:nth-child(2) .split-word { transition-delay: .12s; }
    .split-line:nth-child(3) .split-word { transition-delay: .24s; }
    .reveal-block.in .split-word, .reveal.in .split-word { transform: translate3d(0,0,0); }

    .about-story-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      margin-bottom: 80px;
      align-items: center;
    }
    .about-media-box { height: 520px; overflow: hidden; border: 1px solid rgba(0,0,0,0.08); border-radius: 24px; box-shadow: 0 8px 30px rgba(0,0,0,0.05); }
    .about-media-box img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s ease; }
    .about-media-box:hover img { transform: scale(1.05); }

    .about-copy h3 { font-size: clamp(32px, 4vw, 56px); font-weight: 800; letter-spacing: -.06em; line-height: .95; text-transform: uppercase; margin: 0 0 24px; }
    .about-copy p { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 17px; line-height: 1.6; color: rgba(0,0,0,0.78); margin-bottom: 20px; }

    /* Stats Bar */
    .stats-bar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      border-top: 1px solid rgba(0,0,0,0.1);
      border-bottom: 1px solid rgba(0,0,0,0.1);
      padding: 48px 0;
      margin-bottom: 80px;
    }
    .stat-item h4 { font-size: clamp(40px, 5vw, 72px); font-weight: 800; letter-spacing: -.07em; margin: 0 0 4px; }
    .stat-item p { font-family: 'Inter', -apple-system, sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: rgba(0,0,0,0.55); margin: 0; }

    .team-card-box {
      background: #fff;
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 24px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.04);
      padding: 48px;
      margin-bottom: 96px;
    }
    .team-card-box h3 { font-size: 28px; font-weight: 800; letter-spacing: -.04em; text-transform: uppercase; margin: 0 0 16px; }
    .team-card-box p { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.6; color: rgba(0,0,0,0.78); margin-bottom: 24px; }
    .office-info { font-size: 13px; font-weight: 700; line-height: 1.6; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 20px; color: rgba(0,0,0,0.6); }

    .see-more-btn { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 800; color: #000; }

    /* Bourdain Editorial Pillars Grid */
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      margin-bottom: 80px;
    }
    .pillar-card {
      background: #fff;
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 24px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.04);
      padding: 40px 32px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }
    .pillar-num {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.12);
      border: 1px solid rgba(200, 164, 92, 0.28);
      padding: 4px 10px;
      border-radius: 999px;
      display: inline-block;
      width: fit-content;
      margin-bottom: 14px;
    }
    .pillar-card h4 {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -.03em;
      text-transform: uppercase;
      margin: 0 0 16px;
      color: #000;
    }
    .pillar-card p {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 15px;
      line-height: 1.65;
      color: rgba(0,0,0,0.76);
      margin: 0;
    }

    /* Founders Grid */
    .guides-profiles-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
      margin: 28px 0 32px;
    }
    .guide-profile-card {
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
      padding: 24px;
      background: #faf8f5;
    }
    .guide-profile-card h5 {
      font-size: 18px;
      font-weight: 800;
      text-transform: uppercase;
      margin: 0 0 4px;
      color: #000;
    }
    .guide-tag {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 10px;
      font-weight: 700;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.15);
      border: 1px solid rgba(200, 164, 92, 0.28);
      padding: 3px 10px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: .06em;
      display: inline-block;
      width: fit-content;
      margin-bottom: 12px;
    }
    .guide-profile-card p {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 13.5px;
      line-height: 1.55;
      color: rgba(0,0,0,0.72);
      margin: 0;
    }

    /* Official Browser Companion Section */
    .extension-tools-box {
      background: #0d0d0d;
      color: #fff;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 24px;
      padding: 48px;
      margin-bottom: 80px;
    }
    .extension-tools-box .section-badge {
      color: #C8A45C;
      background: rgba(200, 164, 92, 0.18);
      border-color: rgba(200, 164, 92, 0.35);
    }
    .extension-tools-box h3 {
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 800;
      letter-spacing: -.05em;
      text-transform: uppercase;
      margin: 0 0 16px;
      color: #fff;
    }
    .extension-tools-box p {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      color: rgba(255,255,255,0.74);
      max-width: 820px;
      margin-bottom: 32px;
    }
    .extension-badges-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .ext-badge-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 18px;
      padding: 20px 18px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      transition: all .25s ease;
      text-decoration: none;
      color: #fff;
    }
    .ext-badge-card:hover {
      background: rgba(255,255,255,0.1);
      border-color: #C8A45C;
      transform: translateY(-2px);
    }
    .ext-store-name {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      color: #C8A45C;
      text-transform: uppercase;
      letter-spacing: .06em;
    }
    .ext-badge-title {
      font-size: 15px;
      font-weight: 800;
      color: #fff;
    }
    .ext-badge-sub {
      font-size: 11.5px;
      color: rgba(255,255,255,0.52);
    }

    /* Motion Scroll Classes */
    .reveal { opacity: 0; transform: translateY(40px); transition: opacity .8s ease, transform .8s cubic-bezier(.16,1,.3,1); }
    .reveal.in { opacity: 1; transform: translateY(0); }

    /* ── EXACT HOME PAGE RESERVE BANNER (1-TO-1 MATCH) ── */
    .journeys-reserve-banner {
      margin: 0;
      padding: 80px max(48px, calc((100vw - 1120px)/2));
      background: #000;
      color: #fff;
      border: 0;
      border-radius: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 64px;
      box-shadow: none;
      opacity: 0;
      transform: translateY(40px);
      transition: opacity .8s ease, transform .8s cubic-bezier(.16,1,.3,1);
    }
    .journeys-reserve-banner.in { opacity: 1; transform: translateY(0); }
    .journeys-reserve-copy { display: grid; gap: 12px; }
    .journeys-reserve-kicker { font-family: 'Inter', -apple-system, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #C8A45C; }
    .journeys-reserve-banner h3 { font-size: clamp(44px, 6.4vw, 92px); font-weight: 800; letter-spacing: -.07em; line-height: .86; text-transform: uppercase; margin: 0; max-width: 920px; }
    .journeys-reserve-banner p { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: rgba(255,255,255,.72); font-size: 18px; margin: 4px 0 0; max-width: 620px; line-height: 1.35; }
    .j-reserve-btn {
      color: #fff !important;
      background: transparent !important;
      border: 0 !important;
      border-radius: 0 !important;
      border-top: 1px solid rgba(255, 255, 255, 0.35) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.35) !important;
      padding: 18px 0 !important;
      min-width: 230px;
      justify-content: space-between !important;
      font-size: 15px !important;
      display: inline-flex !important;
      align-items: center !important;
      box-shadow: none !important;
      text-decoration: none !important;
    }
    .j-reserve-arrow { font-size: 22px; transition: transform .25s ease; }
    .j-reserve-btn:hover {
      color: #fff !important;
      background: transparent !important;
      border-top-color: rgba(255, 255, 255, 0.6) !important;
      border-bottom-color: rgba(255, 255, 255, 0.6) !important;
    }
    .j-reserve-btn:hover .j-reserve-arrow { transform: translateX(5px); }

    @media(max-width:850px){
      .page-container { padding: 100px 16px 0; }
      .section-title { font-size: clamp(32px, 8.5vw, 54px); line-height: 0.92; letter-spacing: -0.05em; margin-bottom: 28px; }
      .section-subtitle { font-size: 16px; line-height: 1.5; }
      .about-story-grid { grid-template-columns: 1fr; gap: 32px; }
      .about-media-box { height: 320px; }
      .pillars-grid, .guides-profiles-grid, .extension-badges-grid { grid-template-columns: 1fr!important; gap: 20px!important; }
      .extension-tools-box { padding: 32px 20px!important; }
      .stats-bar { grid-template-columns: repeat(2, 1fr); gap: 24px; }
      .team-card-box { padding: 24px; }
      .journeys-reserve-banner { padding: 40px 16px!important; grid-template-columns: 1fr!important; gap: 24px!important; }
      .j-reserve-btn { width: 100%!important; justify-content: center!important; }
    }
  
  </style>

  <main>
    <div class="page-container reveal-block">
      <div class="section-badge">03 / BRAND PHILOSOPHY & LOCAL ROOTS</div>

      <h1 class="section-title"><span class="split-line"><span class="split-word">EIN ORT IST MEHR</span></span>
        <span class="split-line"><span class="split-word">ALS WAS</span></span>
        <span class="split-line"><span class="split-word">Sie sehen.</span></span></h1>

      <div class="about-story-grid">
        <div class="about-media-box reveal">
          <img src="/img/wall-camp.jpg" alt="Roam Morocco Luxury Desert Camp">
        </div>
        <div class="about-copy reveal">
          <h3>Marokko ist nicht der Protagonist. Die Menschen, die dort leben, sind es.</h3>
          <p>Man kann ein Land besuchen, ohne viel darüber zu verstehen. Sie können die alten Medina-Mauern fotografieren, ohne mit jemandem zu sprechen, der dahinter wohnt, und hinterlassen Hunderte von Bildern und wissen nur sehr wenig über die Menschen, deren Haus Sie betreten haben.</p>
          <p>Roam Morocco wurde in Marrakesch von Hamza und Abdelhakim gegründet. Nachdem wir die gesamte Länge und Breite Marokkos bereist haben – von abgelegenen Pässen des Hohen Atlas bis in die tiefe Sahara – und die ganze Welt bereist haben, verstehen wir Reisen aus beiden Perspektiven: der Neugier, den Sicherheitsbedenken und den hohen Standards internationaler Reisender und dem tiefen Stolz und der Gastfreundschaft der lokalen marokkanischen Gemeinschaften.</p>
          <p>Wir haben Roam Morocco gegründet, um dem Massentourismus eine Absage zu erteilen. Wir verpacken Reiseziele nicht als touristische Ware – wir planen private, entspannte Reisen zu den Menschen, die dieses Land am besten kennen.</p>
