---
import Layout from '../../layouts/Layout.astro';

const title = "Tagesausflug nach Essaouira ab Marrakesch: Private Atlantiktour";
const description = "Tagesausflug von Marrakesch nach Essaouira mit privatem Chauffeur. Entdecken Sie portugiesische Meereswälle, frische Meeresfrüchte und Argan-Kooperativen an der Küste.";
const canonical = "https://roammorocco.tours/de/destination-essaouira.html";
const ogImage = "https://roammorocco.tours/img/rigel-ibisQEDxODo-unsplash.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css?v=20261012_sticky2"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "Essaouira (Mogador) Atlantic Coast",
      "description": "Morocco's UNESCO-listed coastal bastion, renowned for its 18th-century sea walls, bustling blue-boat fishing port, Thuya wood artisans, and relaxing seaside medina.",
      "url": "https://roammorocco.tours/destination-essaouira.html",
      "touristType": [
        "Coastal Vacationers",
        "Couples",
        "Seafood Lovers",
        "Art Collectors"
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 31.5085,
        "longitude": -9.7595
      }
    },
    {
      "@type": "TouristTrip",
      "name": "Private Day Trip from Marrakech to Essaouira",
      "description": "A private, unhurried coastal excursion from Marrakech with dedicated executive transport, flexible schedule, and fresh Atlantic seafood dining.",
      "provider": {
        "@type": "TravelAgency",
        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "telephone": "+212653506441"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long is the drive from Marrakech to Essaouira?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The drive takes approximately 2.5 to 3 hours in our private air-conditioned vehicle. Along the way, we pass through the endemic Argan forest, where you can see the famous tree-climbing goats and visit a certified women's argan oil cooperative."
          }
        },
        {
          "@type": "Question",
          "name": "Is Essaouira cooler than Marrakech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Essaouira benefits from Atlantic trade winds (the 'Aliz\u00e9s'), keeping temperatures moderate year-round (usually 20\u00b0C to 25\u00b0C). It is the perfect refreshing escape when Marrakech gets hot in late spring and summer."
          }
        },
        {
          "@type": "Question",
          "name": "Can we buy fresh seafood directly at the port?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! One of the greatest pleasures of Essaouira is selecting fresh sea bass, sardines, prawns, or calamari directly from the fishermen at the port and having them grilled fresh over hot charcoal right in front of you."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="de" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs & Badge -->
      <div class="dest-kicker-bar">
        <div class="dest-breadcrumb">
          <a href="/de/index.html">Home</a> &nbsp;/&nbsp; <a href="/de/destinations.html">Destinations</a> &nbsp;/&nbsp; <span>Essaouira</span>
        </div>
        <span class="dest-badge-tag">ATLANTIC BASTION</span>
      </div>

      <!-- Hero Banner -->
      <div class="dest-hero">
        <img src="/img/rigel-ibisQEDxODo-unsplash.jpg" alt="Essaouira Portuguese Sea Walls and Fishing Port" class="dest-hero-img">
        <div class="dest-hero-overlay">
          <h1 class="dest-hero-title">Privater Tagesausflug nach Essaouira: Ufermauern und frische Meeresfrüchte</h1>
          <p class="dest-hero-subtitle">Atmen Sie die Atlantikbrise ein. Schlendern Sie über die historischen portugiesischen Stadtmauern aus dem 18. Jahrhundert, beobachten Sie, wie blaue Fischerboote aus Holz ihren Fang ausladen, und stöbern Sie mit einem privaten Chauffeur durch duftende Kunst aus Thujaholz.</p>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> Full Day Excursion (or Overnight Riad Stay)</span>
        <span class="dest-metric-item">🛡 <strong>Style:</strong> Private Executive Mercedes Transport &amp; Chauffeur</span>
        <span class="dest-metric-item">📍 <strong>Departure:</strong> Marrakech (Door-to-Door Riad Pickup)</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985 Verified Reviews)</span>
      </div>

      <!-- 2-Column Core Layout -->
            <!-- GEO & AEO Destination Fast Facts (BLUF) -->
      <aside class="ai-quick-summary-card" aria-label="Essaouira Travel Fast Facts">
        <div class="ai-summary-header">
          <span class="ai-summary-kicker">⚡ ESSAOUIRA AT A GLANCE (QUICK SUMMARY)</span>
          <span class="ai-summary-badge">Atlantic Coastal Haven</span>
        </div>
        <p class="ai-summary-text"><strong>Essaouira</strong> ist ein Küstenparadies am Atlantik und liegt 175 km (2,5 Stunden) westlich von Marrakesch. Berühmt für sein luftiges Mikroklima, die portugiesischen Seewälle aus dem 18. Jahrhundert (Sqala du Port), frische, am Hafen gegrillte Meeresfrüchte und Ateliers für Kunsthandwerker aus Thujaholz, bietet es einen ruhigen Rückzugsort abseits der geschäftigen Medina von Marrakesch. Die empfohlene Aufenthaltsdauer beträgt <strong>1 bis 2 Tage</strong>, mit privaten Chauffeurtransfers zum Pauschalpreis von <strong>105 bis 120 €</strong> pro Fahrzeug.</p>
      </aside>

      <div class="dest-layout-grid">

        <!-- Left Main Column -->
        <div class="dest-content-col">

          <!-- Highlights Callout Box -->
          <div class="dest-highlights-box">
            <h2 class="dest-highlights-title">⚡ Essaouira-Highlights und private Vergünstigungen</h2>
            <ul class="dest-highlights-list">
              <li><strong>Skala de la Ville & Meeresmauern:</strong> Spazieren Sie entlang der Meereszinnen aus dem 18. Jahrhundert, die von holländischen Bronzekanonen gesäumt sind und einen Blick auf die tosenden Wellen bieten.</li>
              <li><strong>Lebhafter blauer Fischereihafen:</strong> Erleben Sie den lebhaften Hafen, in dem Fischer ihre Netze reparieren und jeden Tag glitzernde Fänge entladen.</li>
              <li><strong>Frische, auf Holzkohle gegrillte Meeresfrüchte:</strong> Genießen Sie gegrillte Dorade, Hummer und Sardinen an den Hafenständen unter freiem Himmel oder auf einer luftigen Terrasse am Meer.</li>
              <li><strong>Thuya Wood Artisans:</strong> Entdecken Sie den einzigartigen Duft und die Handwerkskunst der eingelegten Wurzelholzkisten in den historischen Wallgewölben.</li>
              <li><strong>Begegnung mit Arganbäumen und Ziegen:</strong> Entdecken Sie Ziegen, die in den Zweigen wilder Arganbäume sitzen, und besichtigen Sie eine Bio-Frauenkooperative.</li>
            </ul>
          </div>

          <!-- Deep Narrative Overview -->
          <div class="dest-narrative">
            <h2>Die böhmische Küstenseele Marokkos</h2>
            <p>Essaouira, früher unter dem portugiesischen Namen Mogador bekannt, ist Marokkos bezauberndster Küstenort. Im Gegensatz zum geschäftigen Labyrinth von Marrakesch wurde die weiß getünchte Medina von Essaouira mit ihren leuchtend blauen Fensterläden 1760 vom französischen Architekten Théodore Cornut mit breiten, luftigen Alleen angelegt, die die Meeresluft einfangen sollten.</p>
            <p>Es verzaubert seit langem Künstler, Musiker und Reisende – von Orson Welles (der <em>Othello</em> entlang seiner Stadtmauer drehte) bis hin zu Jimi Hendrix. Mit Roam Morocco verlassen Sie Marrakesch um 08:30 Uhr im Executive-Komfort und entfliehen der Hitze der Stadt und genießen die erfrischende Meeresbrise.</p>
            
            <div style="background:#faf8f5;border:1px solid rgba(0,0,0,0.06);border-left:4px solid var(--gold,#C8A45C);border-radius:16px;padding:24px;margin:24px 0;">
              <p style="font-style:italic;margin:0 0 8px;font-size:15px;color:#333;">„Essaouira riecht nach Salzlake, Holzspänen und frisch gegrillten Sardinen. Hier kann man langsamer werden, den Ozean einatmen und den atlantischen Möwen zusehen, wie sie über portugiesischen Stein schweben.“</p>
              <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— ROAM MOROCCO COASTAL DISPATCH</span>
            </div>
            
            <p>Sie haben völlige Freiheit: Verweilen Sie beim Mittagessen auf einer Terrasse am Meer, schlendern Sie durch die Kunstgalerien oder schlendern Sie über den breiten, halbmondförmigen Strand, bevor Sie am späten Nachmittag entspannt nach Marrakesch zurückkehren.</p>
          </div>

          <!-- Day-by-Day Detailed Itinerary -->
          <div class="dest-itinerary-timeline">
            <h3 class="dest-itinerary-header"><span>Ganztägige private Essaouira-Reiseroute</span>
              <span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:700;letter-spacing:0.06em;color:#8A6A23;background:rgba(200,164,92,0.12);border:1px solid rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;">ENTSPANNT UND OHNE Eile</span></h3>

            <!-- Timeline -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">08:30 AM // ARGAN FORESTS &amp; COASTAL DRIVE</span>
              <h4 class="dest-day-title">Marrakesch → Arganbaumziegen → Bio-Kooperative</h4>
              <p class="dest-day-desc">Ihr privater Chauffeur begrüßt Sie um 08:30 Uhr in Ihrem Riad. Reisen Sie nach Westen durch die halbtrockenen Ebenen in das UNESCO-geschützte Argan-Biosphärenreservat. Machen Sie eine Pause, um die berühmten Ziegen beim Fressen in den Arganzweigen zu beobachten und zu fotografieren. Besuchen Sie eine authentische, von Frauen geführte Arganöl-Kooperative und erfahren Sie, wie kosmetische und kulinarische Öle von Hand kaltgepresst werden.</p>
              <div class="dest-day-tags">
                <span>Distance: ~175 km</span>
                <span>Scenic 2.5-Hour Drive</span>
                <span>Argan Cooperative Visit</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">11:30 AM // BLUE HARBOR &amp; RAMPARTS</span>
              <h4 class="dest-day-title">Skala du Port → Gilden der Medina → Mittagessen mit gegrilltem Fisch</h4>
              <p class="dest-day-desc">Ankunft in Essaouira. Spazieren Sie entlang der historischen Hafenmauer, wo hölzerne blaue Fischtrawler sanft in der Flut schaukeln. Erkunden Sie Skala de la Ville und genießen Sie die atemberaubende Aussicht auf den Atlantik. Besuchen Sie die lebhaften Fischgrillstände oder ein gehobenes Restaurant am Meer, um an diesem Morgen frische Austern und gegrillten Wolfsbarsch zu genießen.</p>
              <div class="dest-day-tags">
                <span>4.5 Hours Free Time</span>
                <span>Portuguese Ramparts</span>
                <span>Fresh Seafood Feast</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">04:30 PM // BEACH STROLL &amp; SUNSET DRIVE HOME</span>
              <h4 class="dest-day-title">Strandspaziergang ODER Boutique-Shopping → Rückkehr nach Marrakesch</h4>
              <p class="dest-day-desc">Verbringen Sie den verbleibenden Nachmittag damit, Thujaholz, Gewürze und Berberschmuck einzukaufen, oder machen Sie einen gemütlichen Spaziergang am Sandstrand entlang. Ihr Chauffeur begrüßt Sie zurück in Ihrem Fahrzeug für eine entspannte Rückfahrt bei Sonnenuntergang nach Marrakesch und setzt Sie um 19:00 Uhr direkt an Ihrem Riad ab.</p>
              <div class="dest-day-tags">
                <span>Beach Stroll</span>
                <span>Door-to-Door Riad Drop-Off</span>
                <span>Back for Marrakech Dinner</span>
              </div>
            </div>
          </div>

          <!-- Inclusions & Exclusions Checklist -->
          <div class="dest-inclusions-card">
            <h3 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;margin:0 0 20px;">Was ist in Ihrer privaten Essaouira-Tour enthalten?</h3>
            <div class="dest-inclusions-grid">
              <div class="dest-inc-col">
                <h4 style="color:#25D366;">✔ INKLUSIVE</h4>
                <ul class="dest-inc-list">
                  <li>Privater Hin- und Rücktransfer in einem klimatisierten Executive-Fahrzeug</li>
                  <li>Professioneller englischsprachiger Berber-Chauffeur</li>
                  <li>Alle Kraftstoff-, Autobahn- und Parkgebühren</li>
                  <li>Besuchen Sie eine authentische Arganöl-Kooperative für Frauen</li>
                  <li>Abholung und Rückgabe von Tür zu Tür direkt in Ihrem Riad in Marrakesch</li>
                  <li>Gekühltes Mineralwasser an Bord</li>
                </ul>
              </div>
              <div class="dest-inc-col">
                <h4 style="color:#f10b18;">✕ NICHT ENTHALTEN</h4>
                <ul class="dest-exc-list">
                  <li>Mittagessen (wir bieten geprüfte Empfehlungen für den Strand)</li>
                  <li>Eintrittskarte für Skala du Port (~50 MAD)</li>
                  <li>Diskretionäres Chauffeur-Trinkgeld</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="dest-faq-box">
            <h3 class="dest-faq-title">Häufig gestellte Fragen: Essaouira Tours</h3>
            
            <div class="dest-faq-item active">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Können wir in Essaouira übernachten?</h4>
              <div class="dest-faq-a">
                <p>Ja, absolut! Ein oder zwei Nächte in einem Boutique-Riad an der Küste oder einer luxuriösen Villa am Meer zu verbringen, ist eine der entspannendsten Ergänzungen zu jeder Marokko-Reise. Wir können diese Tour als einfachen Transfer oder als mehrtägigen Küstenausflug anpassen.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Ist Essaouira leicht, ohne Führer herumzulaufen?</h4>
              <div class="dest-faq-a">
                <p>Ja! Im Gegensatz zu Fes oder Marrakesch ist die Medina von Essaouira kompakt und geradlinig mit breiten, geradlinigen Straßen. Es ist praktisch unmöglich, sich zu verlaufen, was die selbstgeführte Erkundung sehr angenehm macht. Auf Anfrage kann jedoch ein privater, lizenzierter Reiseführer arrangiert werden.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar -->
                <!-- Right Sticky Sidebar: Pre-Locked Route Card -->
        <aside class="dest-sidebar-col">
          <div class="dest-prelocked-widget"
               data-tour-name="Essaouira Atlantic Coast Private Excursion"
               data-price-1-4="120"
               data-price-5-7="160"
               data-price-8-12="220"
               data-tour-sub="Historic ramparts, fresh Atlantic seafood port &amp; argan forest route">
            
            <div class="dest-prelocked-badge"><span>●</span> INSTANT DIRECT BOOKING</div>
            <h3 class="dest-prelocked-title">Privater Ausflug zur Atlantikküste von Essaouira</h3>
            <p class="dest-prelocked-sub">Historische Stadtmauer, Hafen für frische Meeresfrüchte am Atlantik und Arganwaldroute</p>

            <label class="dest-form-label" style="margin-bottom:6px;display:block;">Group Size &amp; Vehicle</label>
            <div class="dest-tier-grid">
              <button type="button" class="dest-tier-btn active" data-tier="1_4">
                <span class="dest-tier-pax">1–4 Pax</span>
                <span class="dest-tier-veh">Sedan / 4x4</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="5_7">
                <span class="dest-tier-pax">5–7 Pax</span>
                <span class="dest-tier-veh">VIP Van</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="8_12">
                <span class="dest-tier-pax">8–12 Pax</span>
                <span class="dest-tier-veh">Minibus</span>
              </button>
            </div>

            <div class="dest-prelocked-fields">
              <div class="dest-form-field">
                <label class="dest-form-label" for="pickupCityEssaouira">Departure City</label>
                <select class="dest-form-select dest-prelocked-city" id="pickupCityEssaouira">
                  <option value="Marrakech (Medina / Riad)" selected>Marrakech (Medina / Riad)</option>
                  <option value="Marrakech (Palmeraie)">Marrakech (Palmeraie)</option>
                </select>
              </div>

              <div class="dest-form-field">
                <label class="dest-form-label" for="travelDateEssaouira">Approx. Travel Date</label>
                <input class="dest-form-input dest-prelocked-date" type="date" id="travelDateEssaouira">
              </div>
            </div>

            <div class="dest-prelocked-price-box">
              <div class="dest-prelocked-price-num">120€</div>
              <span class="dest-prelocked-price-sub">Total private group price (not per person)</span>
              <p class="dest-prelocked-price-note">Inklusive privater Hin- und Rückfahrt, Besuch der Argan-Kooperative, Treibstoff, Autobahngebühren und Zeit für die Stadtmauer.</p>
            </div>

            <a href="#" class="dest-prelocked-wa-btn">
              <img src="/img/whatsapp-logo.png" alt="WhatsApp">
              <span>Book via WhatsApp <span class="dest-prelocked-btn-price">— 120€</span></span>
            </a>

            <div class="dest-prelocked-trust">
              <span>🛡 <strong>100% Private:</strong> Dedicated vehicle &amp; local Berber driver.</span>
              <span>⚡ <strong>Fast Confirmation:</strong> Operations team replies &lt; 10 mins.</span>
              <span>🇲🇦 <strong>Zero Deposit:</strong> No upfront deposit needed to check dates.</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </main>

    <!-- Signature Footer -->

  <script is:inline>
    
    function scrollToBookingForm(e) {
      if (e) e.preventDefault();
      const formBox = document.querySelector('.dest-booking-widget') || document.querySelector('.dest-sidebar-col');
      if (formBox) {
        const yOffset = -80;
        const y = formBox.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        setTimeout(() => {
          const input = document.getElementById('clientName');
          if (input) input.focus();
        }, 500);
      }
    }

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.add("at-top");
          topEl.classList.remove("at-bottom");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-dark-bg.png';
        } else {
          topEl.classList.add("at-bottom");
          topEl.classList.remove("at-top");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-light-bg.png';
        }
      }
    }
    addEventListener("scroll", onScroll, {passive: true});
    onScroll();

    function toggleFaq(btn){
      const item = btn.closest('.dest-faq-item');
      if(item) item.classList.toggle('active');
    }

    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(burgerBtn && mobileDrawer){
      burgerBtn.addEventListener('click', function(e){
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      document.addEventListener('click', function(e){
        if(!mobileDrawer.contains(e.target) && !burgerBtn.contains(e.target)){
          mobileDrawer.classList.remove('open');
        }
      });
    }
    function closeDrawer(){
      if(mobileDrawer) mobileDrawer.classList.remove('open');
    }

    async function handleInquirySubmit(e, tourName){
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.dest-submit-btn');
      
      const name = (document.getElementById('clientName')?.value || '').trim();
      const email = (document.getElementById('clientEmail')?.value || '').trim();
      const phone = (document.getElementById('clientPhone')?.value || '').trim();
      const dates = (document.getElementById('travelDates')?.value || '').trim();
      const type = (document.getElementById('tripType')?.value || '').trim();
      const notes = (document.getElementById('notes')?.value || '').trim();

      const payload = {
        name: name,
        email: email,
        phone: phone,
        service: tourName + (type ? ` (${type})` : ''),
        pickup: 'Marrakech to Essaouira Coast',
        vehicle: type,
        date: dates,
        notes: notes,
        source: window.location.pathname
      };

      const waMsg = `Salam Roam Morocco! I would like to inquire about an ${tourName}:\n\n` +
        `👤 Name: ${name}\n` +
        `✉️ Email: ${email}\n` +
        `📱 WhatsApp: ${phone}\n` +
        (type ? `🌊 Trip Format: ${type}\n` : '') +
        (dates ? `📅 Travel Date: ${dates}\n` : '') +
        (notes ? `📝 Notes: ${notes}\n` : '') +
        `\nCan you please confirm private driver availability and send a quote?`;
      
      const waUrl = `https://wa.me/212653506441?text=${encodeURIComponent(waMsg)}`;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      let statusBox = document.getElementById('destFormStatus');
      if (!statusBox) {
        statusBox = document.createElement('div');
        statusBox.id = 'destFormStatus';
        statusBox.className = 'dest-form-status';
        form.appendChild(statusBox);
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: tourName,
          value: 200,
          currency: 'EUR'
        });
      }

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.innerHTML = `<strong>✓ Proposal Request Dispatched!</strong>Thank you, ${name}. Your inquiry for <strong>${tourName}</strong> has been sent to our team. We will check private vehicle and driver availability and email you at <strong>${email}</strong> within 30 minutes.<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Chat with Local Specialist on WhatsApp &rarr;</a>`;

        if (submitBtn) {
          submitBtn.textContent = '✓ REQUEST SENT TO OPERATIONS';
          submitBtn.style.background = '#16a34a';
          submitBtn.style.borderColor = '#16a34a';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 1000);

      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.innerHTML = `Connecting directly to our Marrakech WhatsApp desk...<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Open WhatsApp &rarr;</a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>

  <!-- Sticky Mobile Tour Bar (<900px) -->
  <div class="sticky-mobile-tour-bar">
