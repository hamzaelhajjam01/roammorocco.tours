---
import Layout from '../../layouts/Layout.astro';

const title = "Allgemeine Geschäftsbedingungen – RoamMorocco";
const description = "Offizielle Geschäftsbedingungen für Roam Morocco Tours. Überprüfen Sie Buchungsvereinbarungen, Zahlungsbedingungen, Verantwortlichkeiten der Reisenden und Richtlinien für private Touren.";
const canonical = "https://roammorocco.tours/de/terms-conditions.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/"
  },
  "publisher": {
    "@type": "TravelAgency",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png"
    }
  }
};
---
<Layout lang="de" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

        body {
            background-color: #060605;
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        h1 {
            color: #FFFFFF;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: 600;
        }
        h2 {
            color: #C8A45C;
            font-size: 1.5rem;
            margin-top: 40px;
            margin-bottom: 15px;
            font-weight: 500;
        }
        p {
            margin-bottom: 20px;
        }
        a {
            color: #C8A45C;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 40px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    
  </style>

  <div class="container">
        <a href="/de/" class="back-link">← Back to Home</a>
        <h1>Allgemeine Geschäftsbedingungen</h1>
        <p>Willkommen bei Roam Morocco Tours. Bei Buchung eines Transfers, Tagesausflugs oder einer Rundreise gelten unsere transparenten Geschäftsbedingungen.</p>
        
        <h2>1. Anzahlung & Buchungsrichtlinien</h2>
        <p><strong>• Fahrten bis $300 (€300):</strong> Wir verlangen <strong>0% Anzahlung</strong>. Flughafentransfers, Fernfahrten und Tagestouren bis 300 $ können sofort per WhatsApp oder E-Mail ohne Vorauszahlung bestätigt werden. Sie zahlen den Gesamtbetrag bequem bar beim Fahrer bei Ankunft.</p>
        <p><strong>• Mehrtägige Touren & Fahrten über $300 (€300):</strong> Für mehrtägige Rundreisen und Buchungen über 300 $ ist eine transparente <strong>Anzahlung von 30%</strong> erforderlich, um Fahrzeug, Chauffeur und Unterkünfte fest zu buchen. Die restlichen 70% begleichen Sie bei Ankunft in Marokko.</p>

        <h2>2. All-Inclusive Festpreise</h2>
        <p>Alle Angebote sind Endpreise inklusive lizenziertem Fahrzeug, Passagierversicherung, Kraftstoff, Autobahnmaut und Spesen des Fahrers.</p>

        <h2>3. Flugverfolgung bei Verspätungen</h2>
        <p>Wir überwachen Ihren Flug live. Auch bei Verspätungen wartet Ihr Fahrer ohne Zusatzgebühren im Terminal.</p>

        <h2>4. Kundenservice</h2>
        <p>Bei Fragen: <a href="mailto:contact@roammorocco.tours">contact@roammorocco.tours</a> oder WhatsApp <a href="https://wa.me/212760426269">+212 760 426 269</a>.</p></div>
  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->
</Layout>