---
import Layout from '../layouts/Layout.astro';

const title = "3-Day Marrakech to Fes Private Desert Tour | Erg Chebbi & Atlas | Roam Morocco";
const description = "Experience the classic 3-day Marrakech to Fes private desert tour. Cross the High Atlas, sleep in an Erg Chebbi luxury camp, and finish in Fes with a private chauffeur.";
const canonical = "https://roammorocco.tours/marrakech-to-fes-desert-tour-3-days.html";
const ogImage = "https://roammorocco.tours/img/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css", "/css/roam-toc.css?v=20260928_gold2"];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://roammorocco.tours/?s={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://roammorocco.tours/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tours",
        "item": "https://roammorocco.tours/tours.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "3-Day Marrakech to Fes Desert Tour",
        "item": canonical
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the route and driving time between Marrakech, Merzouga, and Fes?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The 3-day circuit covers approximately 1,020 km total. Day 1 is approximately 6 hours of driving from Marrakech to Dades Gorges with multiple scenic stops at Tizi n'Tichka and Ait Benhaddou. Day 2 is approximately 4.5 hours from Dades through Todra Gorge to Merzouga (arriving in time for sunset camel trekking). Day 3 is approximately 7 hours from Merzouga to Fes through the Ziz Valley, Midelt, Azrou cedar forests, and Ifrane, arriving in Fes by early evening."
        }
      },
      {
        "@type": "Question",
        "name": "Can this desert tour be done in reverse from Fes to Marrakech?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, absolutely! We run this exact private desert expedition in both directions: Marrakech to Fes or Fes to Marrakech. The highlights, luxury camps, and scenic pacing remain identical."
        }
      },
      {
        "@type": "Question",
        "name": "What luxury amenities are included in the Erg Chebbi desert camp?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our handpicked luxury desert camps feature spacious private canvas pavilions with plush King or Queen beds, handcrafted Moroccan carpets, private en-suite bathrooms with hot-water showers, flushing porcelain toilets, electricity, bedside USB charging, and heating or AC. You also enjoy a candlelit 4-course Moroccan dinner and live campfire Gnawa drum performances under the stars."
        }
      },
      {
        "@type": "Question",
        "name": "Do we have to ride camels to reach the desert camp?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. While the 45-minute sunset camel trek across the golden dunes is included and a signature experience, we also provide a private 4x4 dune transfer directly from the edge of the desert to your tent doorway at no additional charge for guests who prefer not to ride camels."
        }
      },
      {
        "@type": "Question",
        "name": "Why choose a private tour over a shared group bus tour for the Marrakech to Fes crossing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Shared bus tours pack 15 to 20 travelers into cramped commercial minibuses with rigid schedules, forced tourist shop stops, basic shared campsite toilets, and drop you off at a highway roundabout outside Fes. Roam Morocco provides a dedicated executive 4x4 or Mercedes VIP minivan, licensed private Berber chauffeur, flexibility to stop whenever you wish for photography and coffee, handpicked boutique Kasbah hotels, VIP luxury desert camp with private en-suite bathrooms, and door-to-door luggage drop-off directly at your riad gate in Fes."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": ["TouristTrip", "Product"],
    "@id": "https://roammorocco.tours/marrakech-to-fes-desert-tour-3-days.html#trip",
    "name": "3-Day Marrakech to Fes Private Desert Tour",
    "description": "Cross Morocco from Marrakech to Fes via the High Atlas mountains, UNESCO Ksar Ait Benhaddou, Dades Gorges, and Erg Chebbi luxury desert camp with a dedicated private chauffeur.",
    "url": canonical,
    "image": ogImage,
    "touristType": [
      "Adventure Travelers",
      "Couples",
      "Families",
      "Luxury Explorers"
    ],
    "duration": "P3D",
    "brand": {
      "@type": "Brand",
      "name": "Roam Morocco Tours"
    },
    "provider": {
      "@type": "TravelAgency",
      "name": "Roam Morocco Tours",
      "url": "https://roammorocco.tours/",
      "telephone": "+212 653-506441"
    },
    "offers": {
      "@type": "Offer",
      "url": canonical,
      "priceCurrency": "EUR",
      "price": "580.00",
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-01-01",
      "priceValidUntil": "2027-12-31"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "bestRating": "5",
      "worstRating": "1",
      "ratingCount": "985",
      "reviewCount": "985"
    }
  }
];

const waMessage = encodeURIComponent("Salam Roam Morocco! I'd like to book the 3-Day Marrakech to Fes Private Desert Tour.");
const waUrl = `https://wa.me/212653506441?text=${waMessage}`;
---

<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  
  <style is:inline slot="head">
    :root {
      --gold: #C8A45C;
      --gold-dark: #8A6A23;
      --gold-light: #faf8f5;
    }
    .m2f-hero {
      position: relative;
      background: #111;
      color: #fff;
      border-radius: 24px;
      overflow: hidden;
      margin-bottom: 32px;
      min-height: 440px;
      display: flex;
      align-items: flex-end;
    }
    .m2f-hero-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.62;
    }
    .m2f-hero-overlay {
      position: relative;
      z-index: 2;
      padding: 48px;
      background: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
      width: 100%;
    }
    .m2f-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #C8A45C;
      background: rgba(200,164,92,0.15);
      border: 1px solid rgba(200,164,92,0.35);
      padding: 6px 14px;
      border-radius: 9999px;
      margin-bottom: 14px;
    }
    .m2f-hero-title {
      font-size: clamp(28px, 4.2vw, 48px);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin: 0 0 14px;
      color: #ffffff;
    }
    .m2f-hero-sub {
      font-size: clamp(15px, 1.8vw, 18px);
      line-height: 1.6;
      color: rgba(255,255,255,0.88);
      max-width: 820px;
      margin: 0;
    }
    .vs-table-wrap {
      background: #ffffff;
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 20px;
      overflow: hidden;
      margin: 36px 0;
      box-shadow: 0 8px 30px rgba(0,0,0,0.04);
    }
    .vs-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 14px;
    }
    .vs-table th, .vs-table td {
      padding: 16px 20px;
      border-bottom: 1px solid rgba(0,0,0,0.06);
    }
    .vs-table th {
      background: #faf8f5;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .vs-table th.col-roam {
      background: #C8A45C;
      color: #000;
    }
    .vs-table tr:last-child td {
      border-bottom: none;
    }
    .vs-check { color: #25D366; font-weight: bold; }
    .vs-cross { color: #dc2626; font-weight: bold; }

    .itinerary-step {
      background: #ffffff;
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 18px;
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }
    .itinerary-step-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .itinerary-day-badge {
      background: #111;
      color: #C8A45C;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 8px;
    }
    .itinerary-step-header h3 {
      font-size: 20px;
      font-weight: 800;
      margin: 0;
      color: #111;
    }
    .itinerary-meta {
      font-size: 13px;
      color: rgba(0,0,0,0.5);
      margin-left: auto;
      font-weight: 600;
    }
    .pricing-grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin: 32px 0;
    }
    .price-box {
      background: #faf8f5;
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 18px;
      padding: 28px 24px;
      text-align: center;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .price-box:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 36px rgba(0,0,0,0.08);
    }
    .price-box.featured {
      background: #fff;
      border: 2px solid #C8A45C;
      box-shadow: 0 12px 40px rgba(200,164,92,0.18);
    }
    .price-box-title {
      font-size: 17px;
      font-weight: 800;
      margin-bottom: 8px;
    }
    .price-box-price {
      font-size: 38px;
      font-weight: 900;
      color: #111;
      margin: 12px 0;
    }
    .price-box-price span {
      font-size: 14px;
      color: rgba(0,0,0,0.5);
      font-weight: 600;
    }
    .price-box ul {
      list-style: none;
      padding: 0;
      margin: 16px 0 24px;
      font-size: 13.5px;
      color: rgba(0,0,0,0.7);
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .price-box-btn {
      display: block;
      width: 100%;
      padding: 12px 18px;
      background: #111;
      color: #fff;
      font-weight: 700;
      font-size: 14px;
      border-radius: 12px;
      text-decoration: none;
      transition: background 0.2s;
    }
    .price-box-btn:hover {
      background: #C8A45C;
      color: #000;
    }
  </style>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs -->
      <nav class="dest-breadcrumb" aria-label="Breadcrumb">
        <a href="/index.html">HOME</a> &nbsp;/&nbsp; <a href="/tours.html">TOURS</a> &nbsp;/&nbsp; <span>MARRAKECH TO FES DESERT TOUR (3 DAYS)</span>
      </nav>

      <!-- Hero Header -->
      <div class="m2f-hero">
        <img src="/img/hero-desert.jpg" alt="Erg Chebbi Merzouga Dunes at Sunset" class="m2f-hero-img">
        <div class="m2f-hero-overlay">
          <span class="m2f-badge">ONE-WAY CROSS-COUNTRY EXPEDITION · 100% PRIVATE</span>
          <h1 class="m2f-hero-title">3-Day Marrakech to Fes Private Desert Tour</h1>
          <p class="m2f-hero-sub">
            The quintessential Moroccan journey. Traverse the High Atlas via Tizi n'Tichka, explore UNESCO Ksar Aït Benhaddou and dramatic Todra canyons, sleep under the stars in a VIP luxury Erg Chebbi camp, and conclude with direct riad delivery in imperial Fes.
          </p>
        </div>
      </div>

      <!-- Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> 3 Days / 2 Nights</span>
        <span class="dest-metric-item">🗺 <strong>Routing:</strong> Marrakech → Sahara → Fes</span>
        <span class="dest-metric-item">🚙 <strong>Vehicle:</strong> Toyota Prado 4x4 or Mercedes Van</span>
        <span class="dest-metric-item">⛺ <strong>Camp:</strong> Luxury Private Tent (Ensuite Bath)</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985+ Reviews)</span>
      </div>

      <!-- Quick Action CTA -->
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin:24px 0 40px;">
        <a href={waUrl} target="_blank" rel="noopener" class="primary-wa-cta" style="background:#25D366;color:#fff;display:inline-flex;align-items:center;gap:10px;padding:14px 28px;border-radius:12px;font-weight:700;text-decoration:none;">
          <img src="/img/whatsapp-logo.png" alt="WhatsApp" width="20" height="20">
          <span>Inquire &amp; Book on WhatsApp (Zero Prepayment)</span>
        </a>
        <a href="#itinerary" style="display:inline-flex;align-items:center;padding:14px 24px;border-radius:12px;font-weight:700;text-decoration:none;background:#fff;border:1px solid rgba(0,0,0,0.15);color:#111;">
          <span>View 3-Day Itinerary ↓</span>
        </a>
      </div>

      <!-- 2-Column Content Layout -->
      <div class="dest-layout-grid">
        <div class="dest-content-col">

          <!-- Private vs Shared Bus Comparison -->
          <div class="vs-table-wrap">
            <table class="vs-table">
              <thead>
                <tr>
                  <th>Trip Feature</th>
                  <th class="col-roam">Roam Morocco Private Tour</th>
                  <th>Generic Shared Bus Tours</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Vehicle Comfort</strong></td>
                  <td><span class="vs-check">✓</span> Dedicated Toyota Prado 4x4 or Mercedes Minivan</td>
                  <td><span class="vs-cross">✗</span> Crowded 17-seat minibus with 16 strangers</td>
                </tr>
                <tr>
                  <td><strong>Travel Schedule</strong></td>
                  <td><span class="vs-check">✓</span> 100% Flexible — stop whenever you want for photos &amp; tea</td>
                  <td><span class="vs-cross">✗</span> Rigid schedule with forced commercial pottery/carpet shops</td>
                </tr>
                <tr>
                  <td><strong>Desert Camp Standards</strong></td>
                  <td><span class="vs-check">✓</span> VIP Luxury Camp: King bed, private ensuite hot shower &amp; toilet</td>
                  <td><span class="vs-cross">✗</span> Basic shared camp: Shared cold-water outdoor toilets</td>
                </tr>
                <tr>
                  <td><strong>Fes Drop-Off</strong></td>
                  <td><span class="vs-check">✓</span> Door-to-door at your Riad gate with luggage assistance</td>
                  <td><span class="vs-cross">✗</span> Dropped at an unfamiliar petrol station outside the city</td>
                </tr>
                <tr>
                  <td><strong>Booking &amp; Payment</strong></td>
                  <td><span class="vs-check">✓</span> €0 Prepayment — pay cash to driver on arrival</td>
                  <td><span class="vs-cross">✗</span> 100% upfront non-refundable card payment</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Day by Day Itinerary -->
          <section id="itinerary" style="margin-top:40px;">
            <span class="section-kicker" style="font-size:11px;font-weight:800;letter-spacing:0.12em;color:#C8A45C;text-transform:uppercase;">THE JOURNEY</span>
            <h2 style="font-size:clamp(24px,3vw,34px);font-weight:900;letter-spacing:-0.02em;margin:8px 0 24px;">Day-by-Day Expedition Itinerary</h2>

            <!-- Day 1 -->
            <div class="itinerary-step">
              <div class="itinerary-step-header">
                <span class="itinerary-day-badge">DAY 01</span>
                <h3>Marrakech → High Atlas (Tizi n'Tichka) → Aït Benhaddou → Dades Gorges</h3>
                <span class="itinerary-meta">~310 km · 6 hours driving</span>
              </div>
              <p style="font-size:15px;line-height:1.65;color:rgba(0,0,0,0.75);margin:0 0 16px;">
                Your private chauffeur greets you directly at your Marrakech riad or hotel at 08:00 AM in your sanitized 4x4 or executive Mercedes minivan. Ascend into the High Atlas Mountains via the famous Tizi n'Tichka pass, reaching an elevation of 2,260 meters. Enjoy panoramic pauses for crisp mountain air and photos over terraced Berber mountain villages.
              </p>
              <p style="font-size:15px;line-height:1.65;color:rgba(0,0,0,0.75);margin:0 0 16px;">
                Descend the southern slopes to the UNESCO World Heritage fortress of <strong>Ksar Aït Benhaddou</strong>, an extraordinary mudbrick citadel backdrop for films like <em>Gladiator</em>, <em>Kingdom of Heaven</em>, and <em>Game of Thrones</em>. Enjoy lunch overlooking the riverbed before continuing through Ouarzazate, the Skoura palm oasis, and the fragrant Valley of the Roses to the dramatic limestone canyon of <strong>Dades Gorges</strong>.
              </p>
              <div style="background:#faf8f5;border-left:3px solid #C8A45C;padding:12px 18px;border-radius:8px;font-size:13.5px;">
                <strong>Night 1 Stay:</strong> Boutique Kasbah Hotel in Dades Valley (e.g. Chez Pierre or Hotel Xaluca Dades). Private room, ensuite bathroom, and authentic 4-course dinner included.
              </div>
            </div>

            <!-- Day 2 -->
            <div class="itinerary-step">
              <div class="itinerary-step-header">
                <span class="itinerary-day-badge">DAY 02</span>
                <h3>Dades Gorges → Todra Gorge Canyons → Erfoud Fossils → Merzouga Dunes (Erg Chebbi)</h3>
                <span class="itinerary-meta">~250 km · 4.5 hours driving</span>
              </div>
              <p style="font-size:15px;line-height:1.65;color:rgba(0,0,0,0.75);margin:0 0 16px;">
                After a fresh breakfast, depart Dades toward Tinghir and enter the jaw-dropping <strong>Todra Gorges</strong>, where 300-meter sheer red limestone walls rise vertically above a crystal-clear mountain stream. Take a refreshing riverside walk through the narrow canyon floor before continuing east across desert plateaus toward Tinjdad and Erfoud, famous for its ancient marine fossils.
              </p>
              <p style="font-size:15px;line-height:1.65;color:rgba(0,0,0,0.75);margin:0 0 16px;">
                By mid-afternoon, arrive at the edge of the Sahara in <strong>Merzouga</strong>, where the monumental golden dunes of <strong>Erg Chebbi</strong> emerge on the horizon. Mount your private camel caravan for an unforgettable sunset trek across the golden dunes, led by experienced Berber guides. (4x4 dune transfer directly to camp is also available upon request).
              </p>
              <div style="background:#faf8f5;border-left:3px solid #C8A45C;padding:12px 18px;border-radius:8px;font-size:13.5px;">
                <strong>Night 2 Stay:</strong> Erg Chebbi Luxury Tented Desert Camp. Private canvas suite featuring King-size bed, authentic Moroccan rugs, private ensuite flushing toilet and hot shower, electricity, 4-course dinner, campfire, and live Gnawa acoustic drum performance under the Milky Way.
              </div>
            </div>

            <!-- Day 3 -->
            <div class="itinerary-step">
              <div class="itinerary-step-header">
                <span class="itinerary-day-badge">DAY 03</span>
                <h3>Erg Chebbi Sunrise → Ziz Valley Gorges → Midelt → Azrou Cedar Forest → Ifrane → Fes</h3>
                <span class="itinerary-meta">~460 km · 7 hours driving</span>
              </div>
              <p style="font-size:15px;line-height:1.65;color:rgba(0,0,0,0.75);margin:0 0 16px;">
                Wake up early for an optional breathtaking sunrise as the morning light turns the dunes deep orange and gold. Enjoy a full gourmet breakfast at camp before boarding your private vehicle to begin the northbound crossing to Fes.
              </p>
              <p style="font-size:15px;line-height:1.65;color:rgba(0,0,0,0.75);margin:0 0 16px;">
                Drive through the sweeping palm oases of the <strong>Ziz Valley</strong>, stopping at scenic canyon viewpoints. Cross the Middle Atlas mountain passes to the town of Midelt for a relaxing lunch. In the afternoon, explore the ancient cedar forests of <strong>Azrou</strong>, home to troops of wild native Barbary macaque monkeys. Pass through <strong>Ifrane</strong>, known as "The Switzerland of Morocco" for its clean alpine architecture, before descending into the historic imperial capital of <strong>Fes</strong>.
              </p>
              <div style="background:#faf8f5;border-left:3px solid #C8A45C;padding:12px 18px;border-radius:8px;font-size:13.5px;">
                <strong>Arrival in Fes (~18:00):</strong> Your private driver delivers you directly to your hotel or riad gate in Fes el-Bali, assisting with all luggage.
              </div>
            </div>

          </section>

          <!-- Transparent Pricing Tiers -->
          <section style="margin:48px 0;">
            <span class="section-kicker" style="font-size:11px;font-weight:800;letter-spacing:0.12em;color:#C8A45C;text-transform:uppercase;">TRANSPARENT RATES</span>
            <h2 style="font-size:clamp(24px,3vw,34px);font-weight:900;letter-spacing:-0.02em;margin:8px 0 12px;">Private Vehicle Pricing (Total per Group)</h2>
            <p style="color:rgba(0,0,0,0.6);font-size:15px;margin:0 0 24px;">Flat transparent rates per vehicle, not per person. Zero credit card needed today — pay your chauffeur upon arrival.</p>

            <div class="pricing-grid-3">
              <!-- Tier 1 -->
              <div class="price-box">
                <div class="price-box-title">Comfort Sedan / SUV</div>
                <div style="font-size:12px;color:#C8A45C;font-weight:700;">1 TO 2 PASSENGERS</div>
                <div class="price-box-price">€580 <span>total group</span></div>
                <ul>
                  <li>✓ Private dedicated chauffeur</li>
                  <li>✓ Modern AC Sedan or SUV</li>
                  <li>✓ 1 Night Dades Kasbah + 1 Night Luxury Camp</li>
                  <li>✓ 2 Dinners, 2 Breakfasts &amp; Camel Trek</li>
                  <li>✓ All fuel, tolls &amp; Fes drop-off</li>
                </ul>
                <a href={`https://wa.me/212653506441?text=${encodeURIComponent("Salam Roam Morocco! I'd like to book the 3-Day Marrakech to Fes Private Tour (1-2 pax - €580).")}`} target="_blank" rel="noopener" class="price-box-btn">Book on WhatsApp (€580)</a>
              </div>

              <!-- Tier 2 (Featured) -->
              <div class="price-box featured">
                <div style="background:#C8A45C;color:#000;font-size:10px;font-weight:800;padding:4px 10px;border-radius:9999px;display:inline-block;margin-bottom:8px;">MOST POPULAR · 4X4 OR VAN</div>
                <div class="price-box-title">Toyota Prado 4x4 / Minivan</div>
                <div style="font-size:12px;color:#C8A45C;font-weight:700;">3 TO 4 PASSENGERS</div>
                <div class="price-box-price">€720 <span>total group (~€180/pax)</span></div>
                <ul>
                  <li>✓ Luxury Toyota Prado TXL 4x4 or Van</li>
                  <li>✓ Experienced native Berber chauffeur</li>
                  <li>✓ 1 Night Dades Kasbah + 1 Night Luxury Camp</li>
