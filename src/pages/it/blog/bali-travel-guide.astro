      border-radius: 16px;
      padding: 28px;
      margin: 36px 0;
      border-left: 4px solid var(--gold, #C8A45C) !important;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .roam-area-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
