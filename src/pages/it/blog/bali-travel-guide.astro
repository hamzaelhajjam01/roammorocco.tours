      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 700;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.12);
      border: 1px solid rgba(200, 164, 92, 0.28);
      padding: 3px 10px;
      border-radius: 999px;
