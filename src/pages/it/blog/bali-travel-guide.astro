      border-radius: 16px;
      padding: 28px;
      margin: 40px 0;
      position: relative;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .roam-field-note-quote {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 19px;
      font-style: italic;
      line-height: 1.6;
      margin: 0 0 12px 0;
      color: #000000;
    }

    .roam-field-note-author {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
