    }

    .roam-hotel-list h4 {
      margin: 0 0 12px 0;
      font-size: 15px;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--gold);
    }

    .hotel-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      padding: 10px 0;
      border-bottom: 1px dashed var(--border);
      font-size: 15px;
    }

    .hotel-item:last-child {
      border-bottom: none;
    }

    .hotel-link {
      color: #000000;
      font-weight: 700;
      text-decoration: underline;
