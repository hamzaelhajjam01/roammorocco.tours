      font-family: 'Playfair Display', Georgia, serif;
      font-size: 19px;
      font-style: italic;
      line-height: 1.6;
      margin: 0 0 12px 0;
      color: #000000;
    }

    .roam-field-note-author {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #8A6A23;
      font-weight: 700;
