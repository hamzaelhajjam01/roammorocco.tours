---
import Layout from '../../layouts/Layout.astro';

const title = "Tour privati ​​nel deserto del Sahara Marocco: campi di lusso Erg Chebbi";
const description = "Tour privati ​​personalizzati nel deserto del Sahara da Marrakech o Fes a Erg Chebbi. Goditi campi tendati di lusso, gite in cammello al tramonto e trasporto privato 4x4.";
const canonical = "https://roammorocco.tours/it/destination-sahara-desert.html";
const ogImage = "https://roammorocco.tours/img/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css?v=20261012_sticky2"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "Sahara Desert & Erg Chebbi Dunes",
      "description": "Morocco's iconic sea of golden sand dunes in Merzouga, offering luxury desert glamping, Berber stargazing, and private 4x4 overland expeditions.",
      "url": "https://roammorocco.tours/destination-sahara-desert.html",
      "touristType": [
        "Adventure Seekers",
        "Luxury Travelers",
        "Couples",
        "Photographers"
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 31.0988,
        "longitude": -4.0113
      }
    },
    {
      "@type": "TouristTrip",
      "name": "3-Day Private Sahara Desert Expedition (Marrakech to Merzouga & Fes)",
      "description": "A fully tailored private desert circuit crossing the High Atlas mountains, Dades Valley, Todra Gorge, and two nights of Saharan luxury.",
      "provider": {
        "@type": "TravelAgency",
        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "telephone": "+212760426269"
      },
      "itinerary": [
        {
          "@type": "City",
          "name": "Marrakech"
        },
        {
          "@type": "LandmarksOrHistoricalBuildings",
          "name": "A\u00eft Benhaddou"
        },
        {
          "@type": "City",
          "name": "Dades Valley"
        },
        {
          "@type": "TouristAttraction",
          "name": "Erg Chebbi Dunes"
        },
        {
          "@type": "City",
          "name": "Fes"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does it take to drive from Marrakech to Erg Chebbi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The drive from Marrakech to Erg Chebbi (Merzouga) takes approximately 9 to 10 hours of driving time. Because of this, our private tours break the journey with an overnight stop in the stunning Dades Valley or Skoura Oasis, ensuring an unhurried, comfortable voyage."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a shared bus tour and a private Sahara tour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Shared bus tours pack 15 to 20 travelers into cramped minibuses with rigid schedules, forced tourist shop stops, and basic tents. Roam Morocco provides a dedicated air-conditioned 4x4 or VIP minivan, personal English-speaking Berber chauffeur, luxury private tents with en-suite hot showers, and flexible photo stops."
          }
        },
        {
          "@type": "Question",
          "name": "Can we finish the Sahara tour in Fes instead of returning to Marrakech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! The Marrakech to Fes desert circuit is our most popular route. You travel from Marrakech through the desert to Erg Chebbi, and on Day 3 or Day 4 continue north through the Ziz Valley, Midelt, and the Middle Atlas cedar forests to conclude directly at your riad in Fes."
          }
        },
        {
          "@type": "Question",
          "name": "What are luxury desert camps like in Erg Chebbi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our partner luxury camps feature spacious canvas pavilions with plush King-sized beds, authentic Moroccan rugs, private flushing toilets, heated water showers, electricity, and fine dining multi-course dinners served under the Saharan stars."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="it" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs & Badge -->
      <div class="dest-kicker-bar">
        <div class="dest-breadcrumb">
          <a href="/it/">Home</a> &nbsp;/&nbsp; <a href="/it/destinations.html">Destinations</a> &nbsp;/&nbsp; <span>Sahara Desert</span>
        </div>
        <span class="dest-badge-tag">SIGNATURE PRIVATE EXPEDITION</span>
      </div>

      <!-- Hero Banner -->
      <div class="dest-hero">
        <img src="/img/hero-desert.jpg" alt="Erg Chebbi Merzouga Sahara Desert Dunes" class="dest-hero-img">
        <div class="dest-hero-overlay">
          <h1 class="dest-hero-title">Tour privati ​​nel deserto del Sahara: spedizioni di lusso sull'Erg Chebbi</h1>
          <p class="dest-hero-subtitle">Attraversa le vette dell'Alto Atlante, attraversa i canyon della Kasbah e dormi sotto un baldacchino di miliardi di stelle nei nostri campi desertici VIP selezionati con cura.</p>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> 3 or 4 Days (Customizable)</span>
        <span class="dest-metric-item">🛡 <strong>Style:</strong> 100% Private Chauffeur &amp; 4x4</span>
        <span class="dest-metric-item">📍 <strong>Departures:</strong> Marrakech, Fes, or Casablanca</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985 Verified Reviews)</span>
      </div>

      <!-- GEO & AEO Destination Fast Facts (BLUF) -->
      <aside class="ai-quick-summary-card" aria-label="Sahara Desert Travel Fast Facts">
        <div class="ai-summary-header">
          <span class="ai-summary-kicker">⚡ SAHARA EXPEDITION AT A GLANCE (QUICK SUMMARY)</span>
          <span class="ai-summary-badge">Erg Chebbi Glamping</span>
        </div>
        <p class="ai-summary-text">Un <strong>tour privato nel deserto del Sahara</strong> con Roam Morocco è una spedizione via terra su misura di 3 o 4 giorni che collega Marrakech o Fes alle dune dorate di 150 metri dell'<strong>Erg Chebbi (Merzouga)</strong>. Il viaggio attraversa l'Alto Atlante passando per Tizi n'Tichka (2.260 m), Ksar Ait Benhaddou, patrimonio dell'UNESCO, e la gola del Dades, culminando in un lussuoso glamping VIP nel deserto con bagno privato privato, letti king size, docce calde, trekking sui cammelli al tramonto e musica Gnawa sul falò. I circuiti privati ​​all-inclusive includono un autista berbero dedicato di lingua inglese, un minivan privato Toyota Prado 4x4 o Mercedes, carburante, pernottamenti in una kasbah boutique e colazioni/cene.</p>
      </aside>

      <!-- 2-Column Core Layout -->
      <div class="dest-layout-grid">

        <!-- Left Main Column -->
        <div class="dest-content-col">

          <!-- Tour Highlights Callout Box -->
          <div class="dest-highlights-box">
            <h2 class="dest-highlights-title">⚡ Punti salienti del viaggio e cose da vedere</h2>
            <ul class="dest-highlights-list">
              <li><strong>Le grandi dune dell'Erg Chebbi:</strong> sali sulle imponenti dune di sabbia dorata alte 150 metri per indimenticabili albe e tramonti sahariani.</li>
              <li><strong>Glamping privato di lusso:</strong> ampi padiglioni in tela con morbidi letti King, bagni privati ​​con scarico, docce calde ed elettricità.</li>
              <li><strong>Escursioni in cammello al tramonto e all'alba:</strong> gentili e tranquille carovane di cammelli guidate dai nomadi nativi Amazigh attraverso creste di sabbia incontaminate.</li>
              <li><strong>UNESCO Ksar Aït Benhaddou:</strong> esplorazione guidata privata dell'antica fortezza di terra vista in <em>Il Gladiatore</em> e <em>Il Trono di Spade</em>.</li>
              <li><strong>Valle del Dades e canyon del Todra:</strong> ammira le pareti calcaree a strapiombo di 300 metri e le lussureggianti oasi di palme da dattero.</li>
              <li><strong>Tradizionale falò berbero:</strong> tamburi sahariani dal vivo, melodie Gnawa e autentici banchetti di tagine sotto la Via Lattea.</li>
            </ul>
          </div>

          <!-- Deep Narrative Overview -->
          <div class="dest-narrative">
            <h2>La vera esperienza del Sahara: senza fretta, privata, autentica</h2>
            <p>Il deserto del Sahara non è solo una destinazione; è un risveglio dei sensi. Vaste, silenziose e affascinantemente antiche, le dune dell'Erg Chebbi fuori Merzouga rappresentano il Marocco nella sua forma più senza tempo. Tuttavia, il percorso via terra di 500 chilometri da Marrakech o Fes può diventare rapidamente estenuante se intrapreso su un autobus di gruppo rigido e affollato.</p>
            <p>Con Roam Morocco, la tua avventura nel deserto è <strong>100% privata</strong>. Viaggia in un veicolo 4x4 executive, dotato di aria condizionata, con un autista berbero nativo dedicato, il cui inglese parla fluentemente e la cui profonda ospitalità trasforma il viaggio stesso in un momento clou. Decidi tu quando fermarti per le fotografie panoramiche lungo il passo Tizi n'Tichka, dove fermarti per un tè alla menta fresca e per quanto tempo assaporare il pranzo nella valle del Draa.</p>
            
            <div style="background:#faf8f5;border:1px solid rgba(0,0,0,0.06);border-left:4px solid var(--gold,#C8A45C);border-radius:16px;padding:24px;margin:24px 0;">
              <p style="font-style:italic;margin:0 0 8px;font-size:15px;color:#333;">"Nel deserto, il silenzio è così immenso da sembrare fisico. Sedersi in cima all'Erg Chebbi mentre il sole tramonta sotto il Sahara è uno dei ricordi di viaggio più grandi sulla terra."</p>
              <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— ROAM MOROCCO FIELD DISPATCH</span>
            </div>
            
            <p>Sia che tu scelga il nostro classico <strong>circuito di 3 giorni da Marrakech a Merzouga</strong> o la nostra grande <strong>traversata da Marrakech a Fes</strong>, eviterai le trappole per turisti e sperimenterai l'autentico impulso del sud del Marocco.</p>
          </div>

          <!-- Day-by-Day Detailed Itinerary -->
          <div class="dest-itinerary-timeline">
            <h3 class="dest-itinerary-header"><span>Itinerario del percorso giorno per giorno</span>
              <span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:700;letter-spacing:0.06em;color:#8A6A23;sfondo:rgba(200,164,92,0.12);bordo:1px solido rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;">ESEMPIO DI CIRCUITO DI 3 GIORNI</span></h3>

            <!-- Day 1 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 01 // OVER THE HIGH ATLAS TO DADES VALLEY</span>
              <h4 class="dest-day-title">Marrakech → Passo Tizi n'Tichka → Aït Benhaddou → Gole del Dades</h4>
              <p class="dest-day-desc">Il tuo autista privato ti accoglie nel tuo riad di Marrakech alle 08:00. Saliamo le spettacolari strade tortuose delle montagne dell'Alto Atlante attraverso il passo Tizi n'Tichka (2.260 m), fermandoci per spettacolari foto di montagna. Scendi nel sito patrimonio mondiale dell'UNESCO di Ksar Aït Benhaddou per un autentico tour a piedi. Proseguiremo attraverso Ouarzazate (la Hollywood del Marocco) e la profumata Valle delle Rose prima di sistemarci per la cena in un boutique hotel Kasbah nella Valle del Dades.</p>
              <div class="dest-day-tags">
                <span>Distance: ~310 km</span>
                <span>Drive Time: ~6 hrs scenic</span>
                <span>Overnight: Luxury Kasbah Hotel</span>
                <span>Meals: Dinner Included</span>
              </div>
            </div>

            <!-- Day 2 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 02 // INTO THE GOLDEN DUNES</span>
              <h4 class="dest-day-title">Valle del Dades → Gola del Todra → Oasi di Tinghir → Dune dell'Erg Chebbi</h4>
              <p class="dest-day-desc">Dopo la colazione con vista sulle frastagliate formazioni rocciose del Dades, ci dirigiamo verso l'imponente gola del Todra. Cammina attraverso il canyon di 300 metri dove gli scalatori mettono alla prova la loro abilità insieme ai pastori locali. Dopo un pranzo tranquillo a Tinghir, navigheremo verso sud oltre i laboratori di fossili di Erfoud nelle sabbie di Merzouga. Monta sul tuo dromedario per un'escursione al tramonto sulle dune dorate nel tuo lussuoso accampamento nel deserto VIP. Goditi una cena marocchina a lume di candela, ascolta musica berbera dal vivo attorno al fuoco e osserva le stelle.</p>
              <div class="dest-day-tags">
                <span>Distance: ~250 km</span>
                <span>Drive Time: ~4.5 hrs</span>
                <span>Overnight: Private Luxury Tent</span>
                <span>Meals: Breakfast &amp; Dinner</span>
              </div>
            </div>

            <!-- Day 3 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 03 // SAHARAN SUNRISE &amp; JOURNEY FORWARD</span>
              <h4 class="dest-day-title">Erg Chebbi → Valle del Draa → Marrakech (O Valle dello Ziz → Fes)</h4>
              <p class="dest-day-desc">Alzati presto per un'alba maestosa sulla tranquilla cresta sahariana. Dopo un'abbondante colazione da campo e una doccia calda, il tuo 4x4 ti riporterà dalle dune. Puoi scegliere di tornare a Marrakech attraverso la valle del Draa, ricca di milioni di palme, OPPURE procedere verso nord verso Fes attraverso la maestosa gola di Ziz, le foreste di cedri del Medio Atlante (che ospitano selvagge bertucce) e il villaggio di sci alpino di Ifrane, arrivando in serata al tuo riad.</p>
              <div class="dest-day-tags">
                <span>Flexible Ending: Marrakech or Fes</span>
                <span>Drop-off: Direct at Riad Door</span>
                <span>Meals: Breakfast</span>
              </div>
            </div>
          </div>

          <!-- Morocco Route Map Illustration -->
          <div class="dest-map-box">
            <h3 class="dest-map-title">🗺️ Il Viaggio sulla Mappa</h3>
            <p style="font-size:14px;color:rgba(0,0,0,0.7);margin-bottom:16px;">Questo circuito attraversa direttamente la drammatica spina dorsale geografica del Marocco: dai giardini imperiali di Marrakech alle cime innevate dell'Atlante fino alle dune del Sahara.</p>
            <img src="/img/morocco-map-new.png" alt="Morocco Desert Tour Route Map" class="dest-map-img">
          </div>

          <!-- Inclusions & Exclusions Checklist -->
          <div class="dest-inclusions-card">
            <h3 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;margin:0 0 20px;">Cosa è incluso nel tuo tour privato</h3>
            <div class="dest-inclusions-grid">
              <div class="dest-inc-col">
                <h4 style="color:#25D366;">✔ INCLUSO NEL TUO PACCHETTO</h4>
                <ul class="dest-inc-list">
                  <li>Minivan executive 4x4 o Mercedes VIP dedicato con aria condizionata</li>
                  <li>Autista berbero professionista di lingua inglese</li>
                  <li>Tutto il carburante dei veicoli, i pedaggi autostradali e le tariffe di parcheggio</li>
                  <li>1 notte in boutique Kasbah-hotel a Dades (camera privata)</li>
                  <li>1 notte nel lussuoso campo nel deserto del Sahara (tenda privata con bagno privato)</li>
                  <li>Escursione privata in cammello per il tramonto e l'alba sull'Erg Chebbi</li>
                  <li>Colazioni e cene tradizionali a più portate</li>
                  <li>Guida locale certificata presso l'UNESCO Aït Benhaddou</li>
                  <li>Ritiro e riconsegna porta a porta presso il tuo riad o l'aeroporto</li>
                </ul>
              </div>
              <div class="dest-inc-col">
                <h4 style="color:#f10b18;">✕ NON INCLUSO</h4>
                <ul class="dest-exc-list">
                  <li>Biglietti aerei internazionali da/per il Marocco</li>
                  <li>Pranzi di mezzogiorno e bevande personali</li>
                  <li>Mance discrezionali per autisti e guide locali</li>
                  <li>Viaggio personale e assicurazione medica</li>
                  <li>Noleggio facoltativo di quad o buggy tra le dune</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Social Proof / Reviews -->
          <div style="background:#ffffff;border:1px solid rgba(0,0,0,0.08);border-radius:16px;box-shadow:0 4px 20px rgba(0,0,0,0.03);padding:32px;margin-bottom:40px;">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
              <span style="background:linear-gradient(135deg, #25D366 0%, #1EBE5D 100%);color:#fff;font-weight:800;padding:4px 10px;font-size:12px;border-radius:999px;font-family:'Inter',sans-serif;">5.0 ★</span>
              <strong style="font-family:'Inter',sans-serif;font-size:14px;text-transform:uppercase;letter-spacing:0.04em;color:#18181B;">Verified Guest Experience</strong>
            </div>
            <p style="font-style:italic;font-size:16px;line-height:1.7;color:#333;margin:0 0 12px;">"Il nostro tour privato nel deserto con Roam Morocco ha superato ogni aspettativa. Il nostro autista era premuroso, competente ed esperto attraverso l'Atlante. Il campo di lusso a Merzouga sembrava uscito da un sogno: acqua calda in mezzo alle dune e un'ospitalità incredibile!"</p>
            <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— MARK &amp; EMILY D., SAN FRANCISCO (USA)</span>
          </div>

          <!-- FAQ Accordion (Targets People Also Ask) -->
          <div class="dest-faq-box">
            <h3 class="dest-faq-title">Domande frequenti: tour nel deserto del Sahara</h3>
            
            <div class="dest-faq-item active">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Quanto tempo ci vuole per guidare da Marrakech a Erg Chebbi?</h4>
              <div class="dest-faq-a">
                <p>La distanza di guida totale è di circa 560 km (circa 9-10 ore di strada). Piuttosto che fare l'estenuante trekking in un giorno, i nostri tour privati ​​dividono sempre il percorso con una sosta notturna nella splendida valle del Dades o nell'oasi di Skoura, trasformando il viaggio in una piacevole avventura turistica.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Possiamo terminare il nostro tour a Fes invece di tornare a Marrakech?</h4>
              <div class="dest-faq-a">
                <p>Sì, assolutamente! Il circuito nel deserto da Marrakech a Fes (o viceversa) è uno dei nostri percorsi più consigliati. Ti permette di vivere le Kasbah del sud, il Sahara, le montagne del Medio Atlante e di arrivare nella capitale spirituale di Fes senza tornare indietro.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Quali servizi ci sono all'interno delle lussuose tende del campo nel deserto?</h4>
              <div class="dest-faq-a">
                <p>I nostri lussuosi campi nel deserto offrono comfort di alto livello: veri letti king size o letti gemelli con biancheria pregiata, bagni privati ​​privati ​​con servizi igienici occidentali, docce calde pressurizzate, arredi artigianali e illuminazione elettrica a energia solare per caricare fotocamere e telefoni.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Qual è il periodo migliore dell'anno per visitare Erg Chebbi?</h4>
              <div class="dest-faq-a">
                <p>I mesi ideali vanno da ottobre a maggio, quando le temperature diurne sono piacevoli (20°C–28°C) e le notti sono fresche. In piena estate (luglio e agosto) si può verificare un caldo estremo che supera i 45°C, motivo per cui durante i mesi estivi consigliamo attività nel deserto al mattino presto e nel tardo pomeriggio.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar: Pre-Locked Route Card -->
        <aside class="dest-sidebar-col">
          <div class="dest-prelocked-widget"
               data-tour-name="3-Day Merzouga Luxury Sahara Expedition"
               data-price-1-4="390"
               data-price-5-7="520"
               data-price-8-12="720"
               data-tour-sub="Dedicated 4x4 Prado &amp; driver · Luxury desert camp · Door-to-door">
            
            <div class="dest-prelocked-badge"><span>●</span> INSTANT DIRECT BOOKING</div>
            <h3 class="dest-prelocked-title">Spedizione di lusso nel Sahara di Merzouga di 3 giorni</h3>
            <p class="dest-prelocked-sub">Prado 4x4 dedicato e autista · Accampamento nel deserto di lusso · Porta a porta</p>

            <label class="dest-form-label" style="margin-bottom:6px;display:block;">Group Size &amp; Vehicle</label>
            <div class="dest-tier-grid">
              <button type="button" class="dest-tier-btn active" data-tier="1_4">
                <span class="dest-tier-pax">1–4 Pax</span>
                <span class="dest-tier-veh">4x4 Prado</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="5_7">
                <span class="dest-tier-pax">5–7 Pax</span>
                <span class="dest-tier-veh">VIP Van</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="8_12">
                <span class="dest-tier-pax">8–12 Pax</span>
                <span class="dest-tier-veh">Minibus</span>
              </button>
            </div>

            <div class="dest-prelocked-fields">
              <div class="dest-form-field">
                <label class="dest-form-label" for="pickupCitySahara">Departure City</label>
                <select class="dest-form-select dest-prelocked-city" id="pickupCitySahara">
                  <option value="Marrakech (Hotel or Riad)" data-surcharge="0" selected>Marrakech (Hotel or Riad)</option>
                  <option value="Fes (Hotel or Riad)" data-surcharge="0">Fes (Hotel or Riad)</option>
                  <option value="Casablanca (Airport or Hotel)" data-surcharge="120">Casablanca (Airport or Hotel) (+120€)</option>
                </select>
              </div>

              <div class="dest-form-field">
                <label class="dest-form-label" for="travelDateSahara">Approx. Travel Date</label>
                <input class="dest-form-input dest-prelocked-date" type="date" id="travelDateSahara">
              </div>
            </div>

            <div class="dest-prelocked-price-box">
              <div class="dest-prelocked-price-num">390€</div>
              <span class="dest-prelocked-price-sub">Total private group price (not per person)</span>
              <p class="dest-prelocked-price-note">Include autista dedicato, carburante, tenda in tela di lusso, cene e trekking in cammello.</p>
            </div>

            <a href="#" class="dest-prelocked-wa-btn">
              <img src="/img/whatsapp-logo.png" alt="WhatsApp">
              <span>Book via WhatsApp <span class="dest-prelocked-btn-price">— 390€</span></span>
            </a>

            <div class="dest-prelocked-trust">
              <span>🛡 <strong>100% Private:</strong> Dedicated vehicle &amp; local Berber driver.</span>
              <span>⚡ <strong>Fast Confirmation:</strong> Operations team replies &lt; 10 mins.</span>
              <span>🇲🇦 <strong>Zero Deposit:</strong> No upfront deposit needed to check dates.</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </main>

    <!-- Signature Footer -->

  <script is:inline>
    
    function scrollToBookingForm(e) {
      if (e) e.preventDefault();
      const formBox = document.querySelector('.dest-booking-widget') || document.querySelector('.dest-sidebar-col');
      if (formBox) {
        const yOffset = -80;
        const y = formBox.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        setTimeout(() => {
          const input = document.getElementById('clientName');
          if (input) input.focus();
        }, 500);
      }
    }

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.add("at-top");
          topEl.classList.remove("at-bottom");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-dark-bg.png';
        } else {
          topEl.classList.add("at-bottom");
          topEl.classList.remove("at-top");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-light-bg.png';
        }
      }
    }
    addEventListener("scroll", onScroll, {passive: true});
    onScroll();

    function toggleFaq(btn){
      const item = btn.closest('.dest-faq-item');
      if(item) item.classList.toggle('active');
    }

    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(burgerBtn && mobileDrawer){
      burgerBtn.addEventListener('click', function(e){
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      document.addEventListener('click', function(e){
        if(!mobileDrawer.contains(e.target) && !burgerBtn.contains(e.target)){
          mobileDrawer.classList.remove('open');
        }
      });
    }
    function closeDrawer(){
      if(mobileDrawer) mobileDrawer.classList.remove('open');
    }

    async function handleInquirySubmit(e, tourName){
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.dest-submit-btn');
      
      const name = (document.getElementById('clientName')?.value || '').trim();
      const email = (document.getElementById('clientEmail')?.value || '').trim();
      const phone = (document.getElementById('clientPhone')?.value || '').trim();
      const dates = (document.getElementById('travelDates')?.value || '').trim();
      const guests = (document.getElementById('groupSize')?.value || '').trim();
      const notes = (document.getElementById('notes')?.value || '').trim();

      const payload = {
        name: name,
        email: email,
        phone: phone,
        service: tourName,
        pickup: tourName,
        date: dates,
        passengers: guests,
        notes: notes,
        source: window.location.pathname
      };

      const waMsg = `Salam Roam Morocco! I would like to inquire about the ${tourName}:\n\n` +
        `👤 Name: ${name}\n` +
        `✉️ Email: ${email}\n` +
        `📱 WhatsApp: ${phone}\n` +
        (dates ? `📅 Travel Dates: ${dates}\n` : '') +
        (guests ? `👥 Group Size: ${guests}\n` : '') +
        (notes ? `📝 Special Requests: ${notes}\n` : '') +
        `\nCan you please confirm availability and send a detailed itinerary proposal?`;
      
      const waUrl = `https://wa.me/212760426269?text=${encodeURIComponent(waMsg)}`;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      let statusBox = document.getElementById('destFormStatus');
      if (!statusBox) {
        statusBox = document.createElement('div');
        statusBox.id = 'destFormStatus';
        statusBox.className = 'dest-form-status';
        form.appendChild(statusBox);
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: tourName,
          value: 200,
          currency: 'EUR'
        });
      }

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.innerHTML = `<strong>✓ Proposal Request Dispatched!</strong>Thank you, ${name}. Your inquiry for <strong>${tourName}</strong> has been sent to our Marrakech team. We will review riad and route availability and email you at <strong>${email}</strong> within 30 minutes.<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Chat with Local Specialist on WhatsApp &rarr;</a>`;

        if (submitBtn) {
          submitBtn.textContent = '✓ REQUEST SENT TO OPERATIONS';
          submitBtn.style.background = '#16a34a';
          submitBtn.style.borderColor = '#16a34a';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 1000);

      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.innerHTML = `Connecting directly to our Marrakech WhatsApp desk...<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Open WhatsApp &rarr;</a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>

