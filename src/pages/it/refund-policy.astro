---
import Layout from '../../layouts/Layout.astro';

const title = "Politica di rimborso - RoamMorocco";
const description = "Consulta la politica ufficiale di rimborso e cancellazione per Roam Morocco Tours. Linee guida chiare su depositi di prenotazione, modifiche delle date e rimborsi del tour.";
const canonical = "https://roammorocco.tours/it/refund-policy.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/"
  },
  "publisher": {
    "@type": "TravelAgency",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png"
    }
  }
};
---
<Layout lang="it" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

        body {
            background-color: #060605;
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        h1 {
            color: #FFFFFF;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: 600;
        }
        h2 {
            color: #C8A45C;
            font-size: 1.5rem;
            margin-top: 40px;
            margin-bottom: 15px;
            font-weight: 500;
        }
        p {
            margin-bottom: 20px;
        }
        a {
            color: #C8A45C;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 40px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    
  </style>

  <div class="container">
        <a href="/it/" class="back-link">← Back to Home</a>
        <h1>Politica di Rimborso e Cancellazione</h1>
        <p>Su Roam Morocco Tours adottiamo condizioni di cancellazione chiare e flessibili per viaggiare in totale tranquillità.</p>
        
        <h2>1. Servizi fino a $300 (€300) — Zero Anticipo e Cancellazione Gratuita</h2>
        <p>Per transfer ed escursioni fino a 300 $, <strong>non è richiesto alcun acconto (0% acconto)</strong>. Puoi modificare le date o cancellare gratuitamente fino a 24 ore prima del servizio con un semplice messaggio WhatsApp.</p>

        <h2>2. Tour di più giorni e prenotazioni superiori a $300 (€300)</h2>
        <p>Per prenotazioni superiori a 300 $ con acconto del 30%:</p>
        <ul>
          <li><strong>Cancellazione con oltre 14 giorni di anticipo:</strong> Rimborso dell'acconto detratte le eventuali spese non rimborsabili di riad o campi.</li>
          <li><strong>Cancellazione entro 14 giorni:</strong> Il tuo acconto del 30% viene convertito in un credito di viaggio 100% flessibile valido per 18 mesi.</li>
          <li><strong>Voli cancellati:</strong> Riprogrammazione gratuita senza penali.</li>
        </ul>

        <h2>3. Assistenza Clienti</h2>
        <p>Contattaci all'indirizzo <a href="mailto:contact@roammorocco.tours">contact@roammorocco.tours</a> o via WhatsApp al <a href="https://wa.me/212760426269">+212 760 426 269</a>.</p></div>
  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->
</Layout>