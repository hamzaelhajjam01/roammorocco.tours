        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5",
          "worstRating": "1"
        },
        "reviewBody": "An absolutely incredible experience. The guides were knowledgeable, the Toubkal Refuge stay was memorable, and everything was planned perfectly."
