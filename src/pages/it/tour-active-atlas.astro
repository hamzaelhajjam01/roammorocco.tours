      font-size: 16px !important;
      line-height: 1.65 !important;
      color: rgba(0, 0, 0, 0.76) !important;
      max-width: 680px !important;
      margin: 0 auto 26px !important;
    }

    /* Human-Centered Storytelling: Bourdain Field Note Card */
    .roam-field-note {
