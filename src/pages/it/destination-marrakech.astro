---
import Layout from '../../layouts/Layout.astro';

const title = "Tour privati ​​di Marrakech: passeggiate guidate nella Medina e gite di un giorno";
const description = "Vivi Marrakech nel lusso: tour guidati privati ​​a piedi della Medina, palazzi segreti, giardini Majorelle, glamping nel deserto di Agafay e gite di un giorno sull'Atlante.";
const canonical = "https://roammorocco.tours/it/destination-marrakech.html";
const ogImage = "https://roammorocco.tours/img/dest-marrakech.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css?v=20261012_sticky2"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "Marrakech Medina & The Red City",
      "description": "Morocco's vibrant imperial metropolis famous for Jemaa el-Fnaa square, opulent riads, artisan souks, and stunning backdrop of the snow-capped Atlas Mountains.",
      "url": "https://roammorocco.tours/destination-marrakech.html",
      "touristType": [
        "Cultural Travelers",
        "Luxury Vacationers",
        "Couples",
        "Culinary Explorers"
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 31.6295,
        "longitude": -7.9811
      }
    },
    {
      "@type": "TouristTrip",
      "name": "3-Day Curated Marrakech & Agafay Private Experience",
      "description": "A tailored private experience featuring insider Medina walking tours, private chauffeur excursions to the Agafay stone desert, and lush High Atlas valleys.",
      "provider": {
        "@type": "TravelAgency",
        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "telephone": "+212760426269"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why do I need a private guide in the Marrakech Medina?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The ancient Medina of Marrakech has over 9,000 alleys and a bustling souk culture. A licensed private guide shields you from aggressive street touts, takes you to authentic master artisans away from tourist shops, and reveals hidden historical riads and courtyards you would never find on your own."
          }
        },
        {
          "@type": "Question",
          "name": "How far is the Agafay Desert from Marrakech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Agafay stone desert is just 45 minutes south of Marrakech. It offers sweeping lunar hills, luxury desert camps, sunset camel rides, and fine dining under the stars without requiring a multi-day journey to the Sahara."
          }
        },
        {
          "@type": "Question",
          "name": "What are the best day trips starting from Marrakech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The top private day trips from Marrakech are: (1) The High Atlas Mountains & Imlil Berber villages, (2) Essaouira on the Atlantic coast, (3) The Agafay Desert for sunset dinners, and (4) The cinematic UNESCO fortress of A\u00eft Benhaddou."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="it" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs & Badge -->
      <div class="dest-kicker-bar">
        <div class="dest-breadcrumb">
          <a href="/it/">Home</a> &nbsp;/&nbsp; <a href="/it/destinations.html">Destinations</a> &nbsp;/&nbsp; <span>Marrakech</span>
        </div>
        <span class="dest-badge-tag">THE OCHRE CITY</span>
      </div>

      <!-- Hero Banner -->
      <div class="dest-hero">
        <img src="/img/dest-marrakech.jpg" alt="Marrakech Medina and Koutoubia Mosque" class="dest-hero-img">
        <div class="dest-hero-overlay">
          <h1 class="dest-hero-title">Tour privati ​​di Marrakech: segreti della Medina, palazzi e oltre</h1>
          <p class="dest-hero-subtitle">Supera le folle di turisti in tranquilli riad nascosti, atelier artigianali, giardini botanici e il deserto lunare di Agafay con un esperto host privato.</p>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> 2 to 4 Days (Customizable)</span>
        <span class="dest-metric-item">🛡 <strong>Style:</strong> Private Licensed Historian &amp; Chauffeur</span>
        <span class="dest-metric-item">📍 <strong>Base:</strong> Handpicked Luxury Medina Riad</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985 Verified Reviews)</span>
      </div>

      <!-- GEO & AEO Destination Fast Facts (BLUF) -->
      <aside class="ai-quick-summary-card" aria-label="Marrakech Travel Fast Facts">
        <div class="ai-summary-header">
          <span class="ai-summary-kicker">⚡ MARRAKECH AT A GLANCE (QUICK SUMMARY)</span>
          <span class="ai-summary-badge">The Ochre City Guide</span>
        </div>
        <p class="ai-summary-text"><strong>Marrakech</strong> è la vivace capitale culturale del Marocco, famosa per la sua Medina del XII secolo, patrimonio dell'UNESCO, il Palazzo Bahia, le Tombe Saadiane e la piazza Jemaa el-Fnaa. La durata ideale della visita è di <strong>3-4 giorni</strong>, combinando passeggiate storiche nella Medina con brevi escursioni sulle montagne dell'Alto Atlante (valle dell'Ourika, 45 min) o nel deserto di Agafay (40 min). Roam Morocco offre guide storiche locali autorizzate private, trasferimenti riad porta a porta e gite giornaliere con autista Mercedes senza trappole per turisti di gruppo.</p>
      </aside>

      <!-- 2-Column Core Layout -->
      <div class="dest-layout-grid">

        <!-- Left Main Column -->
        <div class="dest-content-col">

          <!-- Highlights Callout Box -->
          <div class="dest-highlights-box">
            <h2 class="dest-highlights-title">⚡ Punti salienti di Marrakech ed esclusive private</h2>
            <ul class="dest-highlights-list">
              <li><strong>Tour a piedi della Medina:</strong> sblocca cortili segreti secolari, il Palazzo Bahia del XIX secolo e le Tombe Saadiane con uno storico autorizzato.</li>
              <li><strong>Incontri nei souk dei maestri artigiani:</strong> incontra autentici falegnami, conciatori di pelle e artigiani del rame senza tattiche di vendita ad alta pressione.</li>
              <li><strong>Jardin Majorelle e Museo YSL:</strong> Accesso VIP salta fila al giardino botanico cobalto di Jacques Majorelle e all'archivio haute couture di Yves Saint Laurent.</li>
              <li><strong>Cena al tramonto nel deserto di Agafay:</strong> viaggio privato di 45 minuti nel deserto di pietra per passeggiate a dorso di cammello al tramonto e una festa nomade a lume di candela.</li>
              <li><strong>Fughe di un giorno nell'Alto Atlante:</strong> gita di un giorno facoltativa nella pittoresca valle dell'Ourika o Imlil per l'aria fresca di montagna e la tradizionale cucina casalinga berbera.</li>
            </ul>
          </div>

          <!-- Deep Narrative Overview -->
          <div class="dest-narrative">
            <h2>Vivi Marrakech senza stress</h2>
            <p>Marrakech è un'esaltante esplosione sensoriale: il profumo del legno di cedro e dei fiori d'arancio, la chiamata alla preghiera che riecheggia dal minareto della Koutoubia del XII secolo e l'inebriante teatro di piazza Jemaa el-Fnaa. Eppure, per molti viaggiatori che viaggiano per la prima volta, navigare da soli nella Medina può diventare travolgente.</p>
            <p>Il nostro approccio trasforma il tuo soggiorno a Marrakech da caotico a semplice. Ti abbiniamo a un host locale articolato e autorizzato che è cresciuto all'interno delle mura della Medina. Cammini al tuo ritmo personale, imparando la profonda architettura islamica e l'eredità ebraica del Mellah che la maggior parte dei turisti perde completamente.</p>
            
            <div style="background:#faf8f5;border:1px solid rgba(0,0,0,0.06);border-left:4px solid var(--gold,#C8A45C);border-radius:16px;padding:24px;margin:24px 0;">
              <p style="font-style:italic;margin:0 0 8px;font-size:15px;color:#333;">"Marrakech è una città dagli interni nascosti. Le ruvide mura di argilla all'esterno non danno alcun accenno alle fontane di marmo mozzafiato e ai profumati cortili zellige nascosti proprio dietro le porte di cedro."</p>
              <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— ROAM MOROCCO MEDINA JOURNAL</span>
            </div>
            
            <p>Oltre le antiche mura, il nostro autista privato è a bordo di un veicolo executive con aria condizionata per portarti alla Palmeraie, alle basi artistiche di Gueliz o alle dune lunari del deserto di Agafay per un cocktail al tramonto.</p>
          </div>

          <!-- Day-by-Day Detailed Itinerary -->
          <div class="dest-itinerary-timeline">
            <h3 class="dest-itinerary-header"><span>Esempio di circuito di Marrakech curato di 3 giorni</span>
              <span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:700;letter-spacing:0.06em;color:#8A6A23;sfondo:rgba(200,164,92,0.12);bordo:1px solido rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;">IMBALLAGGIO HOTEL ZERO</span></h3>

            <!-- Day 1 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 01 // PALACES, MEDINA ALLEYS &amp; JEMAA EL-FNAA</span>
              <h4 class="dest-day-title">Il patrimonio imperiale e i suk segreti</h4>
              <p class="dest-day-desc">Incontra la tua guida privata autorizzata dopo una colazione sul tetto del tuo riad. Esplora le splendide piastrelle zellige del Palazzo Bahia, le Tombe Saadiane del XVI secolo e la storica Mellah ebraica. Passeggia più in profondità nei quartieri degli artigiani specializzati, dal suk dei tintori al mercato delle spezie di Rahba Kedima. Assapora il pranzo su un'esclusiva terrazza nel cortile prima di ammirare il tramonto su Jemaa el-Fnaa.</p>
              <div class="dest-day-tags">
                <span>Walking Tour: 4–5 Hours</span>
                <span>Licensed Private Guide</span>
                <span>Skip-the-Line Monument Entry</span>
              </div>
            </div>

            <!-- Day 2 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 02 // BOTANICAL GARDENS &amp; AGAFAY DESERT SUNSET</span>
              <h4 class="dest-day-title">Giardini Majorelle → Museo YSL → Agafay Luxury Camp</h4>
              <p class="dest-day-desc">Il tuo autista verrà a prenderti alle 09:30 per una visita mattutina al Giardino Majorelle e al Museo Yves Saint Laurent. Nel pomeriggio, goditi il ​​tempo libero nella piscina del riad o in un tradizionale hammam marocchino. Alle 16:00, guida per 45 minuti nel deserto lunare di Agafay. Fai un giro in cammello al tramonto attraverso le dune di pietra, seguito da una cucina raffinata e musica berbera acustica dal vivo sotto la costellazione del Sahara.</p>
              <div class="dest-day-tags">
                <span>Private Mercedes Chauffeur</span>
                <span>Agafay Desert 4x4 Excursion</span>
                <span>Sunset Dinner Included</span>
              </div>
            </div>

            <!-- Day 3 -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">DAY 03 // HIGH ATLAS FOOTHILLS &amp; BERBER CULTURE</span>
              <h4 class="dest-day-title">Valle dell'Ourika e cascate Setti Fatma OPPURE Partenza</h4>
              <p class="dest-day-desc">Fuggi dal caldo della città con un viaggio panoramico di 1 ora ai piedi dell'Alto Atlante. Segui il fiume Ourika, esplora i frutteti di noci terrazzati e visita una tradizionale casa di famiglia berbera per un tè alla menta fresco e pane fatto in casa con olio d'oliva e miele. Rientro a Marrakech nel tardo pomeriggio per lo shopping in boutique o il trasferimento senza interruzioni all'aeroporto.</p>
              <div class="dest-day-tags">
                <span>Scenic Mountain Drive: 1 Hour</span>
                <span>Traditional Berber Tea Experience</span>
                <span>Airport Drop-Off Ready</span>
              </div>
            </div>
          </div>

          <!-- Inclusions & Exclusions Checklist -->
          <div class="dest-inclusions-card">
            <h3 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;margin:0 0 20px;">Cosa è incluso nel tuo pacchetto privato Marrakech</h3>
            <div class="dest-inclusions-grid">
              <div class="dest-inc-col">
                <h4 style="color:#25D366;">✔ INCLUSO</h4>
                <ul class="dest-inc-list">
                  <li>Guida storica autorizzata di Marrakech di lingua inglese</li>
                  <li>Trasporto e autista privati ​​dedicati con aria condizionata</li>
                  <li>Ingressi salta fila ai monumenti (Bahia, Tombe Saadiane)</li>
                  <li>Trasferimento privato di andata e ritorno nel deserto di Agafay e cena al tramonto</li>
                  <li>Trasferimento gratuito all'aeroporto e assistenza bagagli nel riad</li>
                  <li>Consigli utili per riad e ristoranti selezionati</li>
                </ul>
              </div>
              <div class="dest-inc-col">
                <h4 style="color:#f10b18;">✕ NON INCLUSO</h4>
                <ul class="dest-exc-list">
                  <li>Biglietti a tempo Giardini Majorelle (prenotati in anticipo su richiesta)</li>
                  <li>Pranzi di mezzogiorno e alcolici personali</li>
                  <li>Mance discrezionali per guide, autisti e personale del riad</li>
                  <li>Trattamenti spa/hammam personali</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="dest-faq-box">
            <h3 class="dest-faq-title">Domande frequenti: tour privati ​​a Marrakech</h3>
            
            <div class="dest-faq-item active">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Quanti giorni dovrei trascorrere a Marrakech?</h4>
              <div class="dest-faq-a">
                <p>Si consigliano almeno 3 giorni interi. Ciò consente 1 giorno intero per l'antica Medina e i palazzi storici, 1 giorno per la moderna Marrakech (Majorelle, Gueliz) e il tramonto nel deserto di Agafay e 1 giorno per una rinfrescante gita di un giorno sulle montagne dell'Alto Atlante o Essaouira.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">È sicuro passeggiare per Marrakech di notte?</h4>
              <div class="dest-faq-a">
                <p>SÌ. Marrakech è generalmente molto sicura e Jemaa el-Fnaa si anima dopo il tramonto con famiglie, musicisti e bancarelle di cibo. Le strade principali sono ben illuminate e fortemente sorvegliate. Come in ogni destinazione importante, tieni le tue cose a portata di mano nelle aree affollate.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">Possiamo personalizzare questo tour per includere lezioni di cucina o un hammam?</h4>
              <div class="dest-faq-a">
                <p>Assolutamente. Ogni itinerario che progettiamo è personalizzato al 100%. Possiamo facilmente organizzare un'autentica lezione di cucina nel riad, un lussuoso rituale dell'hammam reale o un giro in mongolfiera al mattino presto sulle pianure desertiche.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar -->
                <!-- Right Sticky Sidebar: Pre-Locked Route Card -->
        <aside class="dest-sidebar-col">
          <div class="dest-prelocked-widget"
               data-tour-name="Marrakech & Agafay Desert Private Tour"
               data-price-1-4="140"
               data-price-5-7="180"
               data-price-8-12="240"
               data-tour-sub="Private luxury chauffeur · Sunset camel ride &amp; Berber dinner">
            
            <div class="dest-prelocked-badge"><span>●</span> INSTANT DIRECT BOOKING</div>
            <h3 class="dest-prelocked-title">Tour privato del deserto di Marrakech e Agafay</h3>
            <p class="dest-prelocked-sub">Autista privato di lusso · Giro in cammello al tramonto e cena berbera</p>

            <label class="dest-form-label" style="margin-bottom:6px;display:block;">Group Size &amp; Vehicle</label>
            <div class="dest-tier-grid">
              <button type="button" class="dest-tier-btn active" data-tier="1_4">
                <span class="dest-tier-pax">1–4 Pax</span>
                <span class="dest-tier-veh">Sedan / 4x4</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="5_7">
                <span class="dest-tier-pax">5–7 Pax</span>
                <span class="dest-tier-veh">VIP Van</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="8_12">
                <span class="dest-tier-pax">8–12 Pax</span>
                <span class="dest-tier-veh">Minibus</span>
              </button>
            </div>

            <div class="dest-prelocked-fields">
              <div class="dest-form-field">
                <label class="dest-form-label" for="pickupCityMarrakech">Departure City</label>
                <select class="dest-form-select dest-prelocked-city" id="pickupCityMarrakech">
                  <option value="Marrakech (Medina / Riad)" selected>Marrakech (Medina / Riad)</option>
                  <option value="Marrakech (Palmeraie)">Marrakech (Palmeraie)</option>
                  <option value="Marrakech (Gueliz / City)">Marrakech (Gueliz / City)</option>
                </select>
              </div>

              <div class="dest-form-field">
                <label class="dest-form-label" for="travelDateMarrakech">Approx. Travel Date</label>
                <input class="dest-form-input dest-prelocked-date" type="date" id="travelDateMarrakech">
              </div>
            </div>

            <div class="dest-prelocked-price-box">
              <div class="dest-prelocked-price-num">140€</div>
              <span class="dest-prelocked-price-sub">Total private group price (not per person)</span>
              <p class="dest-prelocked-price-note">Include autista dedicato, carburante, escursione in cammello al tramonto, cena con tagine marocchino e falò.</p>
            </div>

            <a href="#" class="dest-prelocked-wa-btn">
              <img src="/img/whatsapp-logo.png" alt="WhatsApp">
              <span>Book via WhatsApp <span class="dest-prelocked-btn-price">— 140€</span></span>
            </a>

            <div class="dest-prelocked-trust">
              <span>🛡 <strong>100% Private:</strong> Dedicated vehicle &amp; local Berber driver.</span>
              <span>⚡ <strong>Fast Confirmation:</strong> Operations team replies &lt; 10 mins.</span>
              <span>🇲🇦 <strong>Zero Deposit:</strong> No upfront deposit needed to check dates.</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </main>

    <!-- Signature Footer -->

  <script is:inline>
    
    function scrollToBookingForm(e) {
      if (e) e.preventDefault();
      const formBox = document.querySelector('.dest-booking-widget') || document.querySelector('.dest-sidebar-col');
      if (formBox) {
        const yOffset = -80;
        const y = formBox.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        setTimeout(() => {
          const input = document.getElementById('clientName');
          if (input) input.focus();
        }, 500);
      }
    }

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.add("at-top");
          topEl.classList.remove("at-bottom");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-dark-bg.png';
        } else {
          topEl.classList.add("at-bottom");
          topEl.classList.remove("at-top");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-light-bg.png';
        }
      }
    }
    addEventListener("scroll", onScroll, {passive: true});
    onScroll();

    function toggleFaq(btn){
      const item = btn.closest('.dest-faq-item');
      if(item) item.classList.toggle('active');
    }

    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(burgerBtn && mobileDrawer){
      burgerBtn.addEventListener('click', function(e){
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      document.addEventListener('click', function(e){
        if(!mobileDrawer.contains(e.target) && !burgerBtn.contains(e.target)){
          mobileDrawer.classList.remove('open');
        }
      });
    }
    function closeDrawer(){
      if(mobileDrawer) mobileDrawer.classList.remove('open');
    }

    async function handleInquirySubmit(e, tourName){
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.dest-submit-btn');
      
      const name = (document.getElementById('clientName')?.value || '').trim();
      const email = (document.getElementById('clientEmail')?.value || '').trim();
      const phone = (document.getElementById('clientPhone')?.value || '').trim();
      const dates = (document.getElementById('travelDates')?.value || '').trim();
      const guests = (document.getElementById('groupSize')?.value || '').trim();
      const notes = (document.getElementById('notes')?.value || '').trim();

      const payload = {
        name: name,
        email: email,
        phone: phone,
        service: tourName,
        pickup: tourName,
        date: dates,
        passengers: guests,
        notes: notes,
        source: window.location.pathname
      };

      const waMsg = `Salam Roam Morocco! I would like to inquire about the ${tourName}:\n\n` +
        `👤 Name: ${name}\n` +
        `✉️ Email: ${email}\n` +
        `📱 WhatsApp: ${phone}\n` +
        (dates ? `📅 Travel Dates: ${dates}\n` : '') +
        (guests ? `👥 Group Size: ${guests}\n` : '') +
        (notes ? `📝 Special Requests: ${notes}\n` : '') +
        `\nCan you please confirm availability and send a detailed itinerary proposal?`;
      
      const waUrl = `https://wa.me/212760426269?text=${encodeURIComponent(waMsg)}`;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      let statusBox = document.getElementById('destFormStatus');
      if (!statusBox) {
        statusBox = document.createElement('div');
        statusBox.id = 'destFormStatus';
        statusBox.className = 'dest-form-status';
        form.appendChild(statusBox);
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: tourName,
          value: 200,
          currency: 'EUR'
        });
      }

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.innerHTML = `<strong>✓ Proposal Request Dispatched!</strong>Thank you, ${name}. Your inquiry for <strong>${tourName}</strong> has been sent to our Marrakech team. We will review riad and route availability and email you at <strong>${email}</strong> within 30 minutes.<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Chat with Local Specialist on WhatsApp &rarr;</a>`;

        if (submitBtn) {
          submitBtn.textContent = '✓ REQUEST SENT TO OPERATIONS';
          submitBtn.style.background = '#16a34a';
          submitBtn.style.borderColor = '#16a34a';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 1000);

      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.innerHTML = `Connecting directly to our Marrakech WhatsApp desk...<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Open WhatsApp &rarr;</a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>

