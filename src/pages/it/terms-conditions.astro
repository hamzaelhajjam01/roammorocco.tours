---
import Layout from '../../layouts/Layout.astro';

const title = "Termini e condizioni - RoamMorocco";
const description = "Termini e condizioni ufficiali per Roam Morocco Tours. Esamina gli accordi di prenotazione, i termini di pagamento, le responsabilità del viaggiatore e le politiche dei tour privati.";
const canonical = "https://roammorocco.tours/it/terms-conditions.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/"
  },
  "publisher": {
    "@type": "TravelAgency",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png"
    }
  }
};
---
<Layout lang="it" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

        body {
            background-color: #060605;
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        h1 {
            color: #FFFFFF;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: 600;
        }
        h2 {
            color: #C8A45C;
            font-size: 1.5rem;
            margin-top: 40px;
            margin-bottom: 15px;
            font-weight: 500;
        }
        p {
            margin-bottom: 20px;
        }
        a {
            color: #C8A45C;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 40px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    
  </style>

  <div class="container">
        <a href="/it/" class="back-link">← Back to Home</a>
        <h1>Termini e Condizioni</h1>
        <p>Benvenuti su Roam Morocco Tours. Prenotando un transfer privato, un'escursione o un tour con noi, accetti i nostri termini e condizioni trasparenti.</p>
        
        <h2>1. Politica di Acconto e Prenotazione</h2>
        <p><strong>• Servizi fino a $300 (€300):</strong> Richiediamo <strong>0% di acconto iniziale</strong>. I transfer aeroportuali, collegamenti intercity ed escursioni giornaliere fino a 300 $ si confermano subito via WhatsApp o email senza anticipo. Paghi il 100% in contanti direttamente al tuo autista all'arrivo.</p>
        <p><strong>• Tour di più giorni e servizi superiori a $300 (€300):</strong> Per tour privati di più giorni e itinerari superiori a 300 $, è richiesto un <strong>acconto del 30%</strong> per bloccare veicolo dedicato, autista autorizzato e hotel/campi tendati. Il restante 70% viene saldato all'arrivo in Marocco.</p>

        <h2>2. Tariffe Tutto Incluso</h2>
        <p>Tutti i preventivi includono veicolo privato, assicurazione passeggeri, carburante, pedaggi autostradali, parcheggi e spese dell'autista.</p>

        <h2>3. Monitoraggio Voli</h2>
        <p>Tracciamo il tuo volo in tempo reale. In caso di ritardo, il tuo autista ti aspetta all'uscita con cartello personalizzato senza costi extra.</p>

        <h2>4. Contatti Concierge</h2>
        <p>Per chiarimenti: <a href="mailto:contact@roammorocco.tours">contact@roammorocco.tours</a> o WhatsApp <a href="https://wa.me/212760426269">+212 760 426 269</a>.</p></div>
  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->
</Layout>