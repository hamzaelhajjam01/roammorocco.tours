---
import Layout from '../layouts/Layout.astro';

const title = "Destinations | Roam Morocco Tours: Custom Travel Circuits";
const description = "Explore custom Morocco travel destinations: Sahara Desert, Marrakech, Fes Medina, High Atlas Mountains, Chefchaouen, Essaouira & Agafay Desert.";
const canonical = "https://roammorocco.tours/destinations.html";
const ogImage = "https://roammorocco.tours/img/dest-marrakech.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Morocco Travel Destinations",
  "url": "https://roammorocco.tours/destinations.html",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Sahara Desert & Erg Chebbi",
      "url": "https://roammorocco.tours/destination-sahara-desert.html"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Marrakech Medina & Souks",
      "url": "https://roammorocco.tours/destination-marrakech.html"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Fes el-Bali Medina",
      "url": "https://roammorocco.tours/destination-fes.html"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "High Atlas Mountains & Toubkal",
      "url": "https://roammorocco.tours/destination-high-atlas.html"
    },
    {
      "@type": "ListItem",
      "position": 5,
      "name": "Chefchaouen Blue City",
      "url": "https://roammorocco.tours/destination-chefchaouen.html"
    },
    {
      "@type": "ListItem",
      "position": 6,
      "name": "Essaouira Atlantic Coast",
      "url": "https://roammorocco.tours/destination-essaouira.html"
    },
    {
      "@type": "ListItem",
      "position": 7,
      "name": "Casablanca & Imperial Gateway",
      "url": "https://roammorocco.tours/destination-casablanca.html"
    },
    {
      "@type": "ListItem",
      "position": 8,
      "name": "A\u00eft Benhaddou & Ouarzazate",
      "url": "https://roammorocco.tours/destination-ait-benhaddou.html"
    }
  ]
};
---
<Layout title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

    :root{
      --white:#fff;--black:#000;--soft:#f4f4f4;--muted:#d9d9d9;--red:#f10b18;
    }
    *, *::before, *::after {
      box-sizing: border-box;
    }
    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #f2eee6;
      color: #000000;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }

    /* Announcement Bar */
    .announcement-bar {
      background: #f8f8f8;
      border-bottom: 1px solid rgba(0,0,0,0.08);
      padding: 8px 0;
      overflow: hidden;
      white-space: nowrap;
    }
    .announcement-track {
      display: flex;
      width: max-content;
      animation: announcementScroll 36s linear infinite;
    }
    .announcement-content {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 12px;
      font-weight: 500;
      color: #333;
      padding-right: 20px;
    }
    .announcement-content strong { font-weight: 800; color: #000; }
    @keyframes announcementScroll { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

    /* ── HEADER NAVIGATION — DYNAMIC MORPH ── */
    .top{
      position:fixed; z-index:200; display:flex; align-items:center; pointer-events:none; transition: top .48s cubic-bezier(.16,1,.3,1), bottom .48s cubic-bezier(.16,1,.3,1), left .48s cubic-bezier(.16,1,.3,1), right .48s cubic-bezier(.16,1,.3,1), transform .48s cubic-bezier(.16,1,.3,1), opacity .35s ease, gap .45s ease;
    }
    .top.at-top{ top:56px; bottom:auto; left:16px; right:16px; transform:translateY(0); justify-content:space-between; width:auto; }
    .top.at-top .navbox{ pointer-events:auto; background:rgba(255,255,255,0.78); backdrop-filter:blur(30px) saturate(1.8); -webkit-backdrop-filter:blur(30px) saturate(1.8); border:1px solid rgba(255,255,255,0.9); box-shadow:0 10px 32px rgba(0,0,0,0.05); border-radius:9999px; display:flex; align-items:center; color:#000; transition:all .45s cubic-bezier(.16,1,.3,1); }
    .top.at-top .navbox{ gap:22px; padding:10px 24px 10px 20px; min-height:52px; }
    .top .wordmark img{ height:40px; width:auto; display:block; transition:opacity .3s ease; }
    .top.at-top .burger-btn{color:#000}
    .top.at-top nav.desktop-nav{display:flex;gap:20px}
    .top.at-top nav.desktop-nav a{ font-size:13px; font-weight:700; letter-spacing:-.2px; color:#000; padding:6px 12px; border-radius:9999px; background:transparent; border:none; transition:all .25s ease; }
    .top.at-top nav.desktop-nav a:hover, .top.at-top nav.desktop-nav a.active{ background:rgba(0,0,0,0.06); color:#000; }

    .top.at-bottom{ top:auto; bottom:24px; left:50%; right:auto; transform:translateX(-50%); justify-content:center; gap:10px; width:max-content; }
    .top.at-bottom .navbox{ pointer-events:auto; background:rgba(18,18,18,0.92); backdrop-filter:blur(30px) saturate(1.8); -webkit-backdrop-filter:blur(30px) saturate(1.8); border:1px solid rgba(255,255,255,0.16); box-shadow:0 16px 48px rgba(0,0,0,0.32); border-radius:9999px; display:flex; align-items:center; color:#fff; transition:all .45s cubic-bezier(.16,1,.3,1); }
    .top.at-bottom .navbox{ gap:14px; padding:8px 10px 8px 18px; min-height:52px; }
    .top.at-bottom .burger-btn{color:#fff}
    .top.at-bottom nav.desktop-nav{display:flex;gap:4px}
    .top.at-bottom nav.desktop-nav a{ font-size:12px; font-weight:700; letter-spacing:.01em; color:rgba(255,255,255,0.85); padding:8px 14px; border-radius:9999px; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.08); transition:all .25s ease; }
    .top.at-bottom nav.desktop-nav a:hover, .top.at-bottom nav.desktop-nav a.active{ background:rgba(255,255,255,0.22); color:#fff; transform:translateY(-1px); }

    .burger-btn{ display:none!important; background:transparent!important; border:none!important; padding:6px!important; cursor:pointer!important; align-items:center!important; justify-content:center!important; border-radius:10px!important; transition:all .25s ease!important; }
    @media (max-width:900px){
      .burger-btn{display:inline-flex!important}
      .top.at-top .burger-btn{ color:#000!important; background:rgba(0,0,0,0.06)!important; border:1px solid rgba(0,0,0,0.1)!important; }
      .top.at-top .burger-btn svg{ stroke:#000!important; }
      .top.at-bottom .burger-btn{ color:#fff!important; background:rgba(255,255,255,0.12)!important; border:1px solid rgba(255,255,255,0.18)!important; }
      .top.at-bottom .burger-btn svg{ stroke:#fff!important; }
    }
    .dot{width:7px;height:7px;background:#C8A45C!important;border-radius:50%!important;display:inline-block;box-shadow:0 0 8px rgba(200,164,92,0.8),0 0 14px rgba(200,164,92,0.4)!important;animation:blink-gold 1.5s infinite}
    @keyframes blink-gold{50%{opacity:.28;transform:scale(.7);box-shadow:0 0 4px rgba(200,164,92,0.4);}}

    /* Back To Top Button */
    .back-top-btn{ pointer-events:auto; width:52px; height:52px; border-radius:50%!important; background:rgba(18,18,18,0.92); backdrop-filter:blur(30px) saturate(1.8); -webkit-backdrop-filter:blur(30px) saturate(1.8); border:1px solid rgba(255,255,255,0.16); box-shadow:0 12px 36px rgba(0,0,0,0.25); color:#fff; display:inline-flex; align-items:center; justify-content:center; cursor:pointer; transition:all .3s cubic-bezier(.16,1,.3,1); }
    .back-top-btn:hover{ background:#222; transform:translateY(-2px); box-shadow:0 16px 44px rgba(0,0,0,0.35); color:#fff; }
    .top.at-top .back-top-btn{ display:none!important; }
    .top.at-bottom .back-top-btn{ display:inline-flex!important; }

    /* Mobile Drawer */
    .mobile-nav-drawer{ position:fixed; bottom:calc(68px + env(safe-area-inset-bottom, 0px))!important; top:auto; left:12px!important; right:12px!important; z-index:100000!important; background:rgba(18,18,18,0.95); backdrop-filter:blur(40px); -webkit-backdrop-filter:blur(40px); border-radius:32px; padding:24px 20px; opacity:0; transform:translateY(20px) scale(.96); pointer-events:none; transition:opacity .3s ease,transform .3s ease; box-shadow:0 24px 60px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.18); }
    .mobile-nav-drawer.open{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}
    .mobile-drawer-inner{display:flex;flex-direction:column;gap:12px}
    .mobile-drawer-inner > a{color:#fff;font-size:13.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:12px 18px;border-radius:9999px;background:rgba(255,255,255,0.08)}

    /* ── PAGE CONTAINER (MAX WIDTH 1380PX MATCHING HOME PAGE) ── */
    .page-container {
      max-width: 1380px;
      margin: 0 auto;
      padding: 140px 48px 0;
    }

    .dest-breadcrumb {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(0, 0, 0, 0.45);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    .dest-breadcrumb a {
      color: rgba(0, 0, 0, 0.55);
      text-decoration: none;
      transition: color 0.2s ease;
    }
    .dest-breadcrumb a:hover {
      color: #C8A45C;
    }
    .dest-breadcrumb span {
      color: #000000;
      font-weight: 700;
    }

    .section-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #8A6A23;
      background: rgba(200, 164, 92, 0.12);
      border: 1px solid rgba(200, 164, 92, 0.28);
      border-radius: 999px;
      padding: 6px 16px;
      margin-bottom: 24px;
    }
    .section-badge::before { content:""; width:6px; height:6px; border-radius:50%; background:#C8A45C; }

    .section-title {
      font-size: clamp(52px, 8vw, 118px);
      font-weight: 800;
      letter-spacing: -.078em;
      line-height: .84;
      text-transform: uppercase;
      margin: 0 0 48px;
      color: #000;
      user-select: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    .split-line { display: block; overflow: hidden; padding-bottom: .08em; }
    .split-word {
      display: block;
      transform: translate3d(0, 115%, 0);
      transition: transform .9s cubic-bezier(.16,1,.3,1);
    }
    .split-line:nth-child(2) .split-word { transition-delay: .12s; }
    .split-line:nth-child(3) .split-word { transition-delay: .24s; }
    .reveal-block.in .split-word, .reveal.in .split-word { transform: translate3d(0,0,0); }

    .section-header-bottom {
      display: grid;
      grid-template-columns: minmax(260px, 460px) 1fr;
      gap: 64px;
      align-items: end;
      border-top: 1px solid rgba(0,0,0,.18);
      padding-top: 28px;
      margin-bottom: 60px;
    }
    .section-subtitle {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: clamp(19px, 1.8vw, 25px);
      letter-spacing: -.03em;
      line-height: 1.25;
      color: rgba(0,0,0,.82);
      margin: 0;
    }
    .principles-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .principle-item { display: grid; gap: 6px; font-size: 12px; }
    .principle-item span { font-family: 'Inter', -apple-system, sans-serif; font-size: 11px; font-weight: 600; color: #8A6A23; }
    .principle-item strong { font-size: 14px; letter-spacing: -.02em; }

    /* Filter Bar */
    .filter-bar {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 48px;
    }
    .filter-btn {
      background: rgba(0,0,0,0.05);
      border: 1px solid rgba(0,0,0,0.14);
      padding: 12px 24px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .04em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all .25s ease;
    }
    .filter-btn.active, .filter-btn:hover {
      background: #000;
      color: #fff;
      border-color: #000;
    }

    /* Grid & Cards */
    .dest-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 40px;
      margin-bottom: 96px;
    }
    .dest-card {
      background: #fff;
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      opacity: 0;
      transform: translateY(40px);
      transition: opacity .8s ease, transform .8s cubic-bezier(.16,1,.3,1), box-shadow .35s ease;
    }
    .dest-card.in { opacity: 1; transform: translateY(0); }
    .dest-card:hover { transform: translateY(-6px); box-shadow: 0 24px 60px rgba(0,0,0,0.12); }
    .dest-media { position: relative; width: 100%; height: 300px; overflow: hidden; background: #111; }
    .dest-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.16,1,.3,1); }
    .dest-card:hover .dest-media img { transform: scale(1.08); }
    .dest-badge-tag { position: absolute; top: 16px; left: 16px; background: rgba(18, 18, 18, 0.88); backdrop-filter: blur(8px); color: #fff; font-family: 'Inter', -apple-system, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.15); }
    .dest-body { padding: 28px; display: flex; flex-direction: column; justify-content: space-between; flex-grow: 1; }
    .dest-body h3 { font-size: 28px; font-weight: 800; letter-spacing: -.055em; line-height: .95; text-transform: uppercase; margin: 0 0 14px; }
    .dest-body p { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.5; color: rgba(0,0,0,0.76); margin: 0 0 24px; }
    .dest-footer-meta { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 20px; }
    .see-more-btn { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; color: #000; transition: color .25s ease, transform .25s ease; }
    .see-more-btn:hover { color: #C8A45C; transform: translateX(4px); }

    /* ── EXACT HOME PAGE RESERVE BANNER (1-TO-1 MATCH) ── */
    .journeys-reserve-banner {
      margin: 0;
      padding: 80px max(48px, calc((100vw - 1120px)/2));
      background: #000;
      color: #fff;
      border: 0;
      border-radius: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 64px;
      box-shadow: none;
      opacity: 0;
      transform: translateY(40px);
      transition: opacity .8s ease, transform .8s cubic-bezier(.16,1,.3,1);
    }
    .journeys-reserve-banner.in { opacity: 1; transform: translateY(0); }
    .journeys-reserve-copy { display: grid; gap: 12px; }
    .journeys-reserve-kicker { font-family: 'Inter', -apple-system, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #C8A45C; }
    .journeys-reserve-banner h3 { font-size: clamp(44px, 6.4vw, 92px); font-weight: 800; letter-spacing: -.07em; line-height: .86; text-transform: uppercase; margin: 0; max-width: 920px; }
    .journeys-reserve-banner p { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: rgba(255,255,255,.72); font-size: 18px; margin: 4px 0 0; max-width: 620px; line-height: 1.35; }
    .j-reserve-btn { color: #fff!important; border-top: 1px solid rgba(255,255,255,.35)!important; border-bottom: 1px solid rgba(255,255,255,.35)!important; padding: 18px 0!important; min-width: 230px; justify-content: space-between!important; font-size: 15px!important; display: inline-flex!important; align-items: center!important; }
    .j-reserve-arrow { font-size: 22px; transition: transform .25s ease; }
    .j-reserve-btn:hover .j-reserve-arrow { transform: translateX(5px); }

    @media(max-width:850px){
      .page-container { padding: 110px 16px 0; }
      .section-header-bottom { grid-template-columns: 1fr; gap: 24px; }
      .principles-bar { grid-template-columns: 1fr; gap: 12px; }
      .journeys-reserve-banner { padding: 40px 16px!important; grid-template-columns: 1fr!important; gap: 24px!important; }
      .j-reserve-btn { width: 100%!important; justify-content: center!important; }
    }
  
  </style>

  <main>
    <div class="page-container reveal-block">
      <nav class="dest-breadcrumb" aria-label="Breadcrumb">
        <a href="/index.html">HOME</a> &nbsp;/&nbsp; <span>DESTINATIONS</span>
      </nav>

      <div class="section-badge">01 / DESTINATIONS OF THE KINGDOM</div>
      
      <h1 class="section-title">
        <span class="split-line"><span class="split-word">EXPLORE THE</span></span>
        <span class="split-line"><span class="split-word">KINGDOM'S FINEST</span></span>
        <span class="split-line"><span class="split-word">DESTINATIONS.</span></span>
      </h1>

      <div class="section-header-bottom">
        <p class="section-subtitle">From golden Saharan dunes to cobalt medinas and mountain peaks, experience Morocco in 100% private comfort.</p>
        <div class="principles-bar">
          <div class="principle-item"><span>01</span><strong>Dedicated 4x4 Transport</strong></div>
          <div class="principle-item"><span>02</span><strong>Your Tailored Pacing</strong></div>
          <div class="principle-item"><span>03</span><strong>Local Berber Hosts</strong></div>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="filter-bar">
        <button class="filter-btn active" onclick="filterDest('all', this)">All Destinations</button>
        <button class="filter-btn" onclick="filterDest('free', this)">Free Tour</button>
        <button class="filter-btn" onclick="filterDest('desert', this)">Sahara & South</button>
        <button class="filter-btn" onclick="filterDest('imperial', this)">Imperial Cities</button>
        <button class="filter-btn" onclick="filterDest('atlas', this)">High Atlas</button>
        <button class="filter-btn" onclick="filterDest('coast-north', this)">Coast & North</button>
      </div>

      <!-- Destinations Grid -->
      <div class="dest-grid">
        <!-- 1. Sahara Desert -->
        <article class="dest-card reveal" data-cat="desert">
          <div class="dest-media">
            <span class="dest-badge-tag">SAHARA DESERT</span>
            <img src="/img/hero-desert.jpg" alt="Erg Chebbi Merzouga Dunes">
          </div>
          <div class="dest-body">
            <h3>Erg Chebbi & Merzouga</h3>
            <p>Endless golden dunes, sunset camel treks, and luxury nomad camps under starry Saharan skies.</p>
            <div class="dest-footer-meta">
              <span style="font-family:'Inter', -apple-system, sans-serif;font-size:11px;font-weight:600;color:#8A6A23;background:rgba(200,164,92,0.1);padding:4px 10px;border-radius:6px;letter-spacing:0.04em;">BEST: OCT – MAY</span>
              <a href="/destination-sahara-desert.html" class="see-more-btn"><span>View Itinerary</span> <span>↳</span></a>
            </div>
          </div>
        </article>

        <!-- 2. Marrakech -->
        <article class="dest-card reveal" data-cat="imperial">
          <div class="dest-media">
            <span class="dest-badge-tag">IMPERIAL CITY</span>
            <img src="/img/review-marrakech.jpg" alt="Marrakech Medina">
          </div>
          <div class="dest-body">
            <h3>Marrakech Medina</h3>
            <p>The vibrant Red City, secret riad courtyards, Majorelle Gardens, and Jemaa el-Fnaa square.</p>
            <div class="dest-footer-meta">
              <span style="font-family:'Inter', -apple-system, sans-serif;font-size:11px;font-weight:600;color:#8A6A23;background:rgba(200,164,92,0.1);padding:4px 10px;border-radius:6px;letter-spacing:0.04em;">BEST: YEAR-ROUND</span>
              <a href="/destination-marrakech.html" class="see-more-btn"><span>View Itinerary</span> <span>↳</span></a>
            </div>
          </div>
        </article>

        <!-- 3. Marrakech Medina Sunset Free Tour -->
        <article class="dest-card reveal" data-cat="imperial free">
          <div class="dest-media">
            <span class="dest-badge-tag" style="background:#16a34a;color:#ffffff;font-weight:700;">★ 100% FREE TOUR</span>
            <img src="/img/marrakech.webp" alt="Marrakech Medina Sunset Free Walking Tour" loading="lazy" decoding="async">
          </div>
          <div class="dest-body">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;">
              <span style="font-size:11px;font-weight:800;letter-spacing:1px;color:#16a34a;text-transform:uppercase;">OFFICIAL LICENSED GUIDE</span>
            </div>
            <h3>Marrakech Medina Sunset Free Tour</h3>
            <p>Daily 2-hour guided walking tour from Koutoubia Mosque through the souks &amp; Saadian quarters, ending at sunset over Jemaa el-Fna.</p>
            <div class="dest-footer-meta">
              <span style="font-family:'Inter', -apple-system, sans-serif;font-size:11px;font-weight:600;color:#8A6A23;background:rgba(200,164,92,0.1);padding:4px 10px;border-radius:6px;letter-spacing:0.04em;">DAILY: 5PM / 6PM</span>
              <a href="/marrakech-medina-sunset-free-tour.html" class="see-more-btn"><span>View Free Tour</span> <span>↳</span></a>
            </div>
          </div>
        </article>

        <!-- 4. Chefchaouen -->
        <article class="dest-card reveal" data-cat="coast-north">
          <div class="dest-media">
