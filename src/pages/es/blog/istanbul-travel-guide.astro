      border-color: var(--gold, #C8A45C);
      color: #000000 !important;
      box-shadow: 0 4px 12px rgba(200, 164, 92, 0.35);
    }

    @media (max-width: 580px) {
      .roam-toolkit-grid {
        grid-template-columns: 1fr;
