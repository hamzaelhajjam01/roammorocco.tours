    .roam-morocco-bridge {
      background: #000000;
      color: #ffffff;
      padding: 40px 32px;
      margin: 50px 0;
      border-radius: 20px;
      border: 1px solid rgba(200, 164, 92, 0.45);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
    }

    .roam-morocco-bridge h3 {
      color: #ffffff;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(22px, 3vw, 30px);
      margin: 0 0 14px 0;
