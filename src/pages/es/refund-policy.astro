---
import Layout from '../../layouts/Layout.astro';

const title = "Política de reembolso - RoamMorocco";
const description = "Revise la política oficial de reembolso y cancelación de Roam Marruecos Tours. Directrices claras sobre depósitos de reserva, cambios de fecha y reembolsos de tours.";
const canonical = "https://roammorocco.tours/es/refund-policy.html";
const ogImage = "https://roammorocco.tours/images/hero-desert.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = [];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  "url": canonical,
  "name": title,
  "description": description,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/"
  },
  "publisher": {
    "@type": "TravelAgency",
    "name": "Roam Morocco Tours",
    "url": "https://roammorocco.tours/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://roammorocco.tours/images/Logos/newlogo-roammorocco.png"
    }
  }
};
---
<Layout lang="es" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>
  <style is:inline slot="head">

        body {
            background-color: #060605;
            color: rgba(255, 255, 255, 0.7);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        h1 {
            color: #FFFFFF;
            font-size: 2.5rem;
            margin-bottom: 30px;
            font-weight: 600;
        }
        h2 {
            color: #C8A45C;
            font-size: 1.5rem;
            margin-top: 40px;
            margin-bottom: 15px;
            font-weight: 500;
        }
        p {
            margin-bottom: 20px;
        }
        a {
            color: #C8A45C;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 40px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    
  </style>

  <div class="container">
        <a href="/es/" class="back-link">← Back to Home</a>
        <h1>Política de Reembolso y Cancelación</h1>
        <p>En Roam Morocco Tours ofrecemos una política de cancelación clara y flexible.</p>
        
        <h2>1. Servicios de $300 (€300) o Menos — Sin Prepago y Cancelación Gratuita</h2>
        <p>Para traslados y excursiones de $300 o menos, <strong>no se requiere depósito previo (0% depósito)</strong>. Puedes cancelar o cambiar fechas gratis hasta 24h antes del servicio vía WhatsApp.</p>

        <h2>2. Tours de varios días y reservas superiores a $300 (€300)</h2>
        <p>Para reservas de más de $300 con depósito del 30%:</p>
        <ul>
          <li><strong>Cancelación con más de 14 días de antelación:</strong> Reembolso del depósito descontando gastos no recuperables de riads/campamentos.</li>
          <li><strong>Cancelación dentro de los 14 días:</strong> El 30% de depósito se convierte en un bono de viaje 100% flexible válido durante 18 meses.</li>
          <li><strong>Vuelos cancelados:</strong> Cambio de fechas sin penalización.</li>
        </ul>

        <h2>3. Atención al Cliente</h2>
        <p>Contáctanos en <a href="mailto:contact@roammorocco.tours">contact@roammorocco.tours</a> o en WhatsApp al <a href="https://wa.me/212760426269">+212 760 426 269</a>.</p></div>
  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->
</Layout>