        <p>Comparte tus fechas, estilo de viaje y lugares imperdibles. Los convertiremos en un itinerario privado y viable por Marruecos.</p>
      </div>
      <a href="/es/custom-morocco-tour.html" class="j-reserve-btn">
        <span>Start planning</span><span class="j-reserve-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- FAQ SECTION (ARCHITECTURAL LUXURY) -->
    <section class="news-faq-section">
      <div class="news-faq-head">
        <p class="journeys-badge" style="margin-bottom: 16px;">Preguntas frecuentes // CONSEJOS IMPRESCINDIBLES PARA VIAJAR</p>
        <h2>Preguntas frecuentes</h2>
      </div>
      <div class="faq-list">
        <div class="faq-card" onclick="toggleFaq(this)">
          <div class="faq-head">
            <h4>¿Cuál es la mejor época para visitar Marruecos?</h4>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-body">
            Spring (mid-March to May) and autumn (September to October) are ideal, offering pleasant warm weather ideal for medinas and the Sahara.
          </div>
        </div>
        <div class="faq-card" onclick="toggleFaq(this)">
          <div class="faq-head">
            <h4>¿Necesito una visa para visitar Marruecos?</h4>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-body">
            Citizens of the US, UK, Canada, Australia, and EU countries do not require a visa for stays up to 90 days. Always verify passport validity.
          </div>
        </div>
        <div class="faq-card" onclick="toggleFaq(this)">
          <div class="faq-head">
            <h4>¿Es Marruecos seguro para los turistas?</h4>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-body">
            Yes, Morocco is considered very safe for international travelers. The local government prioritizes tourism safety and hospitality.
          </div>
        </div>
        <div class="faq-card" onclick="toggleFaq(this)">
          <div class="faq-head">
            <h4>¿Qué deben llevar las mujeres viajeras en Marruecos?</h4>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-body">
            Dressing modestly (covering shoulders and knees) is recommended out of respect for local customs, especially in historical medinas and rural villages.
          </div>
        </div>
        <div class="faq-card" onclick="toggleFaq(this)">
          <div class="faq-head">
            <h4>¿Se puede beber alcohol en Marruecos?</h4>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-body">
            Alcohol is available in licensed hotels, boutique riads, bars, and tourist restaurants, though drinking in public streets is prohibited.
          </div>
        </div>
        <div class="faq-card" onclick="toggleFaq(this)">
          <div class="faq-head">
            <h4>¿Cuál es la moneda en Marruecos?</h4>
            <span class="faq-icon">+</span>
          </div>
          <div class="faq-body">
            The Moroccan Dirham (MAD). While major hotels accept credit cards, carrying cash is recommended for souk purchases and small cafes.
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- EXACT HOMEPAGE SIGNATURE FOOTER -->
    <!-- Signature Footer -->

  <script is:inline>

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.remove("at-bottom");
          topEl.classList.add("at-top");
        } else {
          topEl.classList.remove("at-top");
          topEl.classList.add("at-bottom");
        }
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // FAQ Accordion
    function toggleFaq(card) {
      card.classList.toggle('open');
    }

    // Category Filter Functionality
    function filterCategory(cat, btn) {
      const buttons = document.querySelectorAll('.filter-btn');
      buttons.forEach(b => b.classList.remove('active'));
      if(btn) btn.classList.add('active');

      const entries = document.querySelectorAll('.news-entry');
      let visibleIdx = 1;
      entries.forEach(entry => {
        const itemCat = entry.getAttribute('data-category');
        if (cat === 'all' || itemCat === cat) {
          entry.style.display = 'grid';
          const idxEl = entry.querySelector('.news-index');
          if (idxEl) {
            idxEl.textContent = (visibleIdx < 10 ? '0' : '') + visibleIdx;
          }
          visibleIdx++;
        } else {
          entry.style.display = 'none';
        }
      });
    }
  </script>
</Layout>