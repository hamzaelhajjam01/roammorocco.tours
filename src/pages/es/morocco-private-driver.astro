  <!-- Scripts -->
  <script is:inline>
    // Driver Quote Form Handler
    async function handleDriverQuoteSubmit(e) {
      e.preventDefault();
      const btn = document.getElementById('submitQuoteBtn');
      const statusBox = document.getElementById('quoteStatusBox');
      
      const pickup = document.getElementById('pickupLocation').value;
      const service = document.getElementById('serviceType').value;
      const date = document.getElementById('startDate').value;
      const days = document.getElementById('durationDays').value;
      const pax = document.getElementById('passengers').value;
      const vehicle = document.getElementById('vehicleClass').value;
      const name = document.getElementById('fullName').value;
      const phone = document.getElementById('phoneWhatsApp').value;
      const email = document.getElementById('emailAddress').value;
      const notes = document.getElementById('specialNotes').value;

      const payload = {
        name: name,
        email: email,
        phone: phone,
        pickup: pickup,
        service: service,
        date: date,
        duration: days,
        passengers: pax,
        vehicle: vehicle,
        notes: notes
      };

      btn.disabled = true;
      btn.style.opacity = '0.7';
      btn.innerHTML = 'Sending Your Inquiry...';

      // WhatsApp message URL for direct messaging option
      const message = `Salam Roam Morocco! I just submitted a private driver quote request:%0A%0A` +
        `👤 *Name:* ${encodeURIComponent(name)}%0A` +
        `📍 *Pickup:* ${encodeURIComponent(pickup)}%0A` +
        `🛣 *Route/Service:* ${encodeURIComponent(service)}%0A` +
        `📅 *Date:* ${encodeURIComponent(date)}%0A` +
        `⏱ *Duration:* ${encodeURIComponent(days)}%0A` +
        `👥 *Passengers:* ${encodeURIComponent(pax)}%0A` +
        `🚗 *Vehicle:* ${encodeURIComponent(vehicle)}%0A` +
        `📱 *WhatsApp:* ${encodeURIComponent(phone)}%0A` +
        `✉️ *Email:* ${encodeURIComponent(email)}%0A` +
        (notes ? `📝 *Notes:* ${encodeURIComponent(notes)}%0A` : '');
      const waUrl = `https://wa.me/212760426269?text=${message}`;

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.style.background = '#f0fdf4';
        statusBox.style.border = '1px solid #86efac';
        statusBox.style.borderLeft = '4px solid #16a34a';
        statusBox.style.color = '#14532d';
        statusBox.innerHTML = `<strong>✓ Quote Request Received!</strong><br>Thank you, ${name}. Your inquiry has been sent to our operations desk. We will review your route and reply directly to <strong>${email}</strong> within 30 minutes.<br><br><a href="${waUrl}" target="_blank" rel="noopener" class="btn-wa-solid" style="display:inline-flex; align-items:center; margin-top:8px; padding:12px 20px; font-size:12px; color:#ffffff !important;"><img src="/img/whatsapp-logo.png" alt="WhatsApp" class="wa-btn-icon" width="18" height="18" style="vertical-align:middle; margin-right:8px;"><span style="color:#ffffff !important;">Plan on WhatsApp</span></a>`;

        btn.innerHTML = '✓ Request Sent to Our Team';
        btn.style.background = '#16a34a';
        btn.style.borderColor = '#16a34a';

        if (typeof gtag === 'function') {
          gtag('event', 'generate_lead', {
            'event_category': 'conversion',
            'event_label': 'private_driver_form',
            'value': 180,
            'currency': 'EUR'
          });
        }
      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.style.background = '#fefce8';
        statusBox.style.border = '1px solid #fde047';
        statusBox.style.borderLeft = '4px solid #ca8a04';
        statusBox.style.color = '#713f12';
        statusBox.innerHTML = `Connecting directly to our WhatsApp operations desk...<br><br><a href="${waUrl}" target="_blank" rel="noopener" class="btn-wa-solid" style="display:inline-flex; align-items:center; margin-top:8px; padding:12px 20px; font-size:12px; color:#ffffff !important;"><img src="/img/whatsapp-logo.png" alt="WhatsApp" class="wa-btn-icon" width="18" height="18" style="vertical-align:middle; margin-right:8px;"><span style="color:#ffffff !important;">Plan on WhatsApp</span></a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>
