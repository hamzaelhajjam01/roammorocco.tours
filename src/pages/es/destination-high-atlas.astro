---
import Layout from '../../layouts/Layout.astro';

const title = "Tours privados a las montañas del Alto Atlas: Imlil y el monte Toubkal";
const description = "Excursiones privadas de un día desde Marrakech a las montañas del Alto Atlas. Explore Imlil, los valles del Monte Toubkal y disfrute de un almuerzo tradicional bereber con un guía local.";
const canonical = "https://roammorocco.tours/es/destination-high-atlas.html";
const ogImage = "https://roammorocco.tours/img/tour_active_atlas_toubkal.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css?v=20261012_sticky2"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "High Atlas Mountains & Imlil Valley",
      "description": "North Africa's highest mountain range, crowned by Mount Toubkal (4,167m), featuring historic Berber villages, alpine streams, and majestic terraced valleys just 90 minutes from Marrakech.",
      "url": "https://roammorocco.tours/destination-high-atlas.html",
      "touristType": [
        "Hikers",
        "Nature Lovers",
        "Culture Enthusiasts",
        "Families"
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 31.1364,
        "longitude": -7.9197
      }
    },
    {
      "@type": "TouristTrip",
      "name": "Private High Atlas & Imlil Berber Valley Day Tour",
      "description": "A private day excursion from Marrakech into the heart of the High Atlas with dedicated 4x4 transport, licensed local Berber mountain guide, and traditional rooftop lunch.",
      "provider": {
        "@type": "TravelAgency",
        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "telephone": "+212760426269"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How far is Imlil and the Atlas Mountains from Marrakech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Imlil is approximately 65 km south of Marrakech, which takes around 1 hour and 30 minutes in our comfortable private vehicle. The drive winds scenic mountain passes past Asni, Moulay Brahim, and Apple orchards."
          }
        },
        {
          "@type": "Question",
          "name": "Is hiking experience required for the High Atlas day trip?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No! Our private walks are 100% customized to your fitness level. You can choose a gentle 1-hour stroll through terraced walnut groves and Berber villages, a moderate hike to Armed village, or relax on a panoramic riad terrace with mint tea."
          }
        },
        {
          "@type": "Question",
          "name": "What should I wear for a day trip to the Atlas Mountains?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We recommend sturdy walking shoes or sneakers with good grip, comfortable layered clothing (as mountain temperatures are 5\u00b0C to 10\u00b0C cooler than Marrakech), sunglasses, and sun protection."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="es" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs & Badge -->
      <div class="dest-kicker-bar">
        <div class="dest-breadcrumb">
          <a href="/es/index.html">Home</a> &nbsp;/&nbsp; <a href="/es/destinations.html">Destinations</a> &nbsp;/&nbsp; <span>High Atlas Mountains</span>
        </div>
        <span class="dest-badge-tag">ROOF OF NORTH AFRICA</span>
      </div>

      <!-- Hero Banner -->
      <div class="dest-hero">
        <img src="/img/tour_active_atlas_toubkal.jpg" alt="High Atlas Mountains and Mount Toubkal Trail" class="dest-hero-img">
        <div class="dest-hero-overlay">
          <h1 class="dest-hero-title">Tours privados a las montañas del Atlas: Imlil, Toubkal y valles bereberes</h1>
          <p class="dest-hero-subtitle">Respire el fresco aire alpino bajo el monte Toubkal. Huertos de nogales en terrazas, antiguos pueblos de piedra y almuerzos caseros tradicionales con anfitriones nativos amazigh.</p>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> Full Day Excursion (or 2-Day Trek)</span>
        <span class="dest-metric-item">🛡 <strong>Style:</strong> Private 4x4 Chauffeur &amp; Mountain Guide</span>
        <span class="dest-metric-item">📍 <strong>Departure:</strong> Marrakech (90 Min Drive)</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985 Verified Reviews)</span>
      </div>

      <!-- 2-Column Core Layout -->
            <!-- GEO & AEO Destination Fast Facts (BLUF) -->
      <aside class="ai-quick-summary-card" aria-label="High Atlas Mountains Fast Facts">
        <div class="ai-summary-header">
          <span class="ai-summary-kicker">⚡ HIGH ATLAS MOUNTAINS AT A GLANCE (QUICK SUMMARY)</span>
          <span class="ai-summary-badge">Alpine Morocco</span>
        </div>
        <p class="ai-summary-text">Las <strong>Montañas del Alto Atlas</strong> forman la cadena montañosa más alta del norte de África, coronada por el <strong>monte Toubkal (4.167 m)</strong>. Ubicado a solo 60 a 90 minutos al sur de Marrakech, los puntos de acceso clave incluyen <strong>Imlil</strong> (el principal sendero para caminatas y cumbres) y el exuberante <strong>valle de Ourika</strong> (famoso por los arroyos glaciares a lo largo de la carretera y las cascadas de Setti Fatma). Roam Marruecos organiza guías de montaña bereberes certificados por la UIAGM, transporte privado en 4x4 y auténticas visitas familiares para tomar el té.</p>
      </aside>

      <div class="dest-layout-grid">

        <!-- Left Main Column -->
        <div class="dest-content-col">

          <!-- Highlights Callout Box -->
          <div class="dest-highlights-box">
            <h2 class="dest-highlights-title">⚡ Aspectos destacados del Alto Atlas y exclusivas privadas</h2>
            <ul class="dest-highlights-list">
              <li><strong>Imlil y Armed Valley:</strong> explore el icónico sendero de montaña debajo del monte Toubkal (4167 metros), el pico más alto del norte de África.</li>
              <li><strong>Auténtico almuerzo bereber en la azotea:</strong> Saboree un cordero de montaña cocinado a fuego lento o un tagine de verduras en una terraza panorámica con vistas a los picos nevados.</li>
              <li><strong>Senderismo de montaña personalizado:</strong> personalizado, desde una caminata suave de 1,5 horas hasta una vigorosa caminata por la cresta de 4 horas dirigida por un guía bereber local certificado.</li>
              <li><strong>Gargantas pintorescas de Moulay Brahim:</strong> Espectaculares acantilados de piedra caliza, arroyos de montaña y cooperativas de aceite de argán al borde de la carretera.</li>
              <li><strong>Pueblos tradicionales vírgenes:</strong> Camine por pueblos centenarios de piedra y barro que no han sido modificados por la modernidad.</li>
            </ul>
          </div>

          <!-- Deep Narrative Overview -->
          <div class="dest-narrative">
            <h2>Escápese de la Ciudad Roja hacia Pure Mountain Majesty</h2>
            <p>A sólo 90 minutos al sur de la bulliciosa Medina de Marrakech se encuentra un mundo completamente diferente. Las montañas del Alto Atlas se elevan como un impenetrable muro de granito y albergan a antiguas comunidades bereberes (amazigh) cuya hospitalidad es legendaria en todo el norte de África.</p>
            <p>Nuestra excursión privada al Valle de Imlil ofrece el contraste perfecto con la vida de la ciudad. Dejarás atrás la ciudad en un 4x4 ejecutivo y ascenderás por los exuberantes valles verdes de Asni. En Imlil, será recibido por su dedicado guía de montaña nativo, alguien cuya familia ha vivido en estos picos durante generaciones.</p>
            
            <div style="background:#faf8f5;border:1px solid rgba(0,0,0,0.06);border-left:4px solid var(--gold,#C8A45C);border-radius:16px;padding:24px;margin:24px 0;">
              <p style="font-style:italic;margin:0 0 8px;font-size:15px;color:#333;">"Sentarse en una sencilla azotea bereber, beber té de menta caliente mientras escuchas el agua de deshielo del Monte Toubkal, es cuando la verdadera paz de Marruecos se hunde en tu alma".</p>
              <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— ROAM MOROCCO MOUNTAIN LOG</span>
            </div>
            
            <p>Puede caminar a lo largo de antiguos canales de riego entre nogales centenarios, visitar el pueblo alto de Armed o simplemente relajarse y disfrutar de un festín de pan recién horneado, aceite de oliva prensado en frío y tajines de montaña orgánicos.</p>
          </div>

          <!-- Day-by-Day Detailed Itinerary -->
          <div class="dest-itinerary-timeline">
            <h3 class="dest-itinerary-header"><span>Itinerario de día completo del Alto Atlas e Imlil</span>
              <span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:700;letter-spacing:0.06em;color:#8A6A23;background:rgba(200,164,92,0.12);border:1px solid rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;">TOUR PRIVADO PUERTA A PUERTA</span></h3>

            <!-- Timeline -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">09:00 AM // SCENIC ASCENT FROM MARRAKECH</span>
              <h4 class="dest-day-title">Marrakech → Gargantas de Moulay Brahim → Valle de Asni</h4>
              <p class="dest-day-desc">Su conductor privado lo recibirá en su riad de Marrakech a las 09:00 a.m. Viaje hacia el sur a través de la llanura de Haouz antes de subir al cañón de Moulay Brahim. Disfrute de paradas panorámicas para tomar fotografías de montaña y vea la cerámica tradicional bereber a lo largo del camino. Los sábados, visita semanalmente el bullicioso zoco de montaña de Asni.</p>
              <div class="dest-day-tags">
                <span>Distance: 65 km</span>
                <span>Executive 4x4 Transport</span>
                <span>Scenic Valley Views</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">10:45 AM // IMLIL VALLEY TREK &amp; BERBER VILLAGES</span>
              <h4 class="dest-day-title">Imlil (1.740 m) → Pueblo Armado → Inicio del sendero Toubkal</h4>
              <p class="dest-day-desc">Conozca a su guía de montaña bereber local certificado en Imlil. Embárquese en un paseo personalizado por senderos de piedra a través de manzanos y nogales. Pase las cascadas de montaña y visite el pueblo de Armed, junto al acantilado, que ofrece vistas asombrosas de la escarpada cumbre nevada del Monte Toubkal.</p>
              <div class="dest-day-tags">
                <span>Licensed Mountain Guide</span>
                <span>Pacing Tailored to You</span>
                <span>Mule Support for Children/Seniors</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">01:30 PM // AUTHENTIC BERBER ROOFTOP LUNCH</span>
              <h4 class="dest-day-title">Fiesta de montaña casera y regreso relajante</h4>
              <p class="dest-day-desc">Sea bienvenido en una auténtica casa bereber local o en una boutique de montaña Kasbah para disfrutar de un almuerzo de varios platos: ensaladas marroquíes recién hechas, tierno tagine de montaña, cuscús, frutas de temporada y aromático té de menta en una terraza panorámica en la azotea. Relájese con la limpia brisa de la montaña antes de regresar tranquilamente a Marrakech a última hora de la tarde a las 17:30.</p>
              <div class="dest-day-tags">
                <span>Multi-Course Lunch Included</span>
                <span>Panoramic Rooftop Views</span>
                <span>Back in Marrakech for Dinner</span>
              </div>
            </div>
          </div>

          <!-- Inclusions & Exclusions Checklist -->
          <div class="dest-inclusions-card">
            <h3 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;margin:0 0 20px;">¿Qué está incluido en su recorrido por las montañas del Atlas?</h3>
            <div class="dest-inclusions-grid">
              <div class="dest-inc-col">
                <h4 style="color:#25D366;">✔ INCLUIDO</h4>
                <ul class="dest-inc-list">
                  <li>Traslado privado ida y vuelta en 4x4 o minivan ejecutiva con aire acondicionado.</li>
                  <li>Chofer bereber profesional de habla inglesa.</li>
                  <li>Guía de montaña local certificado en el valle de Imlil.</li>
                  <li>Almuerzo tradicional bereber de 3 platos en una terraza panorámica de montaña.</li>
                  <li>Agua embotellada fresca durante todo el día.</li>
                  <li>Recogida y regreso al riad puerta a puerta en Marrakech.</li>
                </ul>
              </div>
              <div class="dest-inc-col">
                <h4 style="color:#f10b18;">✕ NO INCLUIDO</h4>
                <ul class="dest-exc-list">
                  <li>Propinas discrecionales para chofer y guía de montaña.</li>
                  <li>Seguro de viaje personal</li>
                  <li>Alquiler de paseo en mula opcional para no excursionistas (~100 MAD)</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="dest-faq-box">
            <h3 class="dest-faq-title">Preguntas frecuentes: Tours al Alto Atlas</h3>
            
            <div class="dest-faq-item active">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">¿Podemos hacer este recorrido si alguien de nuestro grupo tiene movilidad limitada?</h4>
              <div class="dest-faq-a">
                <p>¡Sí! Podemos organizar un suave paseo en mula con un guía experimentado para que los huéspedes de todas las edades (o niños pequeños) puedan disfrutar de los pintorescos senderos sin esfuerzo físico. Alternativamente, podemos conducir directamente a alojamientos panorámicos de montaña como Kasbah Toubkal, donde podrá relajarse en cómodos salones con terraza.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">¿Nieva en las montañas del Atlas?</h4>
              <div class="dest-faq-a">
                <p>Sí. Los picos más altos alrededor del monte Toubkal están cubiertos de nieve de noviembre a abril. Los caminos a Imlil se mantienen abiertos y accesibles durante todo el año, y las vistas cubiertas de nieve desde el valle durante el invierno y la primavera son realmente espectaculares.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar -->
                <!-- Right Sticky Sidebar: Pre-Locked Route Card -->
        <aside class="dest-sidebar-col">
          <div class="dest-prelocked-widget"
               data-tour-name="High Atlas Mountains & Imlil Valley Trek"
               data-price-1-4="120"
               data-price-5-7="165"
               data-price-8-12="230"
               data-tour-sub="Toubkal National Park · Local Berber guide &amp; traditional rooftop lunch">
            
            <div class="dest-prelocked-badge"><span>●</span> INSTANT DIRECT BOOKING</div>
            <h3 class="dest-prelocked-title">Caminata por las montañas del Alto Atlas y el valle de Imlil</h3>
            <p class="dest-prelocked-sub">Parque Nacional Toubkal · Guía local bereber y almuerzo tradicional en la azotea</p>

            <label class="dest-form-label" style="margin-bottom:6px;display:block;">Group Size &amp; Vehicle</label>
            <div class="dest-tier-grid">
              <button type="button" class="dest-tier-btn active" data-tier="1_4">
                <span class="dest-tier-pax">1–4 Pax</span>
                <span class="dest-tier-veh">Sedan / 4x4</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="5_7">
                <span class="dest-tier-pax">5–7 Pax</span>
                <span class="dest-tier-veh">VIP Van</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="8_12">
                <span class="dest-tier-pax">8–12 Pax</span>
                <span class="dest-tier-veh">Minibus</span>
              </button>
            </div>

            <div class="dest-prelocked-fields">
              <div class="dest-form-field">
                <label class="dest-form-label" for="pickupCityAtlas">Departure City</label>
                <select class="dest-form-select dest-prelocked-city" id="pickupCityAtlas">
                  <option value="Marrakech (Medina / Riad)" selected>Marrakech (Medina / Riad)</option>
                  <option value="Marrakech (Palmeraie)">Marrakech (Palmeraie)</option>
                </select>
              </div>

              <div class="dest-form-field">
                <label class="dest-form-label" for="travelDateAtlas">Approx. Travel Date</label>
                <input class="dest-form-input dest-prelocked-date" type="date" id="travelDateAtlas">
              </div>
            </div>

            <div class="dest-prelocked-price-box">
              <div class="dest-prelocked-price-num">120€</div>
              <span class="dest-prelocked-price-sub">Total private group price (not per person)</span>
              <p class="dest-prelocked-price-note">Incluye vehículo privado y conductor, guía de montaña certificado, almuerzo bereber de 3 platos y apoyo en mula.</p>
            </div>

            <a href="#" class="dest-prelocked-wa-btn">
              <img src="/img/whatsapp-logo.png" alt="WhatsApp">
              <span>Book via WhatsApp <span class="dest-prelocked-btn-price">— 120€</span></span>
            </a>

            <div class="dest-prelocked-trust">
              <span>🛡 <strong>100% Private:</strong> Dedicated vehicle &amp; local Berber driver.</span>
              <span>⚡ <strong>Fast Confirmation:</strong> Operations team replies &lt; 10 mins.</span>
              <span>🇲🇦 <strong>Zero Deposit:</strong> No upfront deposit needed to check dates.</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </main>

    <!-- Signature Footer -->

  <script is:inline>
    
    function scrollToBookingForm(e) {
      if (e) e.preventDefault();
      const formBox = document.querySelector('.dest-booking-widget') || document.querySelector('.dest-sidebar-col');
      if (formBox) {
        const yOffset = -80;
        const y = formBox.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        setTimeout(() => {
          const input = document.getElementById('clientName');
          if (input) input.focus();
        }, 500);
      }
    }

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.add("at-top");
          topEl.classList.remove("at-bottom");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-dark-bg.png';
        } else {
          topEl.classList.add("at-bottom");
          topEl.classList.remove("at-top");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-light-bg.png';
        }
      }
    }
    addEventListener("scroll", onScroll, {passive: true});
    onScroll();

    function toggleFaq(btn){
      const item = btn.closest('.dest-faq-item');
      if(item) item.classList.toggle('active');
    }

    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(burgerBtn && mobileDrawer){
      burgerBtn.addEventListener('click', function(e){
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      document.addEventListener('click', function(e){
        if(!mobileDrawer.contains(e.target) && !burgerBtn.contains(e.target)){
          mobileDrawer.classList.remove('open');
        }
      });
    }
    function closeDrawer(){
      if(mobileDrawer) mobileDrawer.classList.remove('open');
    }

    async function handleInquirySubmit(e, tourName){
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.dest-submit-btn');
      
      const name = (document.getElementById('clientName')?.value || '').trim();
      const email = (document.getElementById('clientEmail')?.value || '').trim();
      const phone = (document.getElementById('clientPhone')?.value || '').trim();
      const dates = (document.getElementById('travelDates')?.value || '').trim();
      const guests = (document.getElementById('groupSize')?.value || '').trim();
      const notes = (document.getElementById('notes')?.value || '').trim();

      const payload = {
        name: name,
        email: email,
        phone: phone,
        service: tourName,
        pickup: tourName,
        date: dates,
        passengers: guests,
        notes: notes,
        source: window.location.pathname
      };

      const waMsg = `Salam Roam Morocco! I would like to inquire about the ${tourName}:\n\n` +
        `👤 Name: ${name}\n` +
        `✉️ Email: ${email}\n` +
        `📱 WhatsApp: ${phone}\n` +
        (dates ? `📅 Travel Date: ${dates}\n` : '') +
        (guests ? `👥 Group Size: ${guests}\n` : '') +
        (notes ? `📝 Notes: ${notes}\n` : '') +
        `\nCan you please confirm guide & 4x4 availability and send a detailed proposal?`;
      
      const waUrl = `https://wa.me/212760426269?text=${encodeURIComponent(waMsg)}`;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      let statusBox = document.getElementById('destFormStatus');
      if (!statusBox) {
        statusBox = document.createElement('div');
        statusBox.id = 'destFormStatus';
        statusBox.className = 'dest-form-status';
        form.appendChild(statusBox);
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: tourName,
          value: 200,
          currency: 'EUR'
        });
      }

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.innerHTML = `<strong>✓ Proposal Request Dispatched!</strong>Thank you, ${name}. Your inquiry for <strong>${tourName}</strong> has been sent to our Marrakech team. We will review vehicle and guide availability and email you at <strong>${email}</strong> within 30 minutes.<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Chat with Local Specialist on WhatsApp &rarr;</a>`;

        if (submitBtn) {
          submitBtn.textContent = '✓ REQUEST SENT TO OPERATIONS';
          submitBtn.style.background = '#16a34a';
          submitBtn.style.borderColor = '#16a34a';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 1000);

      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.innerHTML = `Connecting directly to our Marrakech WhatsApp desk...<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Open WhatsApp &rarr;</a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>

  <!-- Sticky Mobile Tour Bar (<900px) -->
  <div class="sticky-mobile-tour-bar">
    <div class="smt-info">
      <div class="smt-title">High Atlas &amp; Imlil Trek</div>
      <div class="smt-price">From <span class="smt-price-num">120€</span> <span>per vehicle</span></div>
    </div>
    <a href="https://wa.me/212760426269?text=Salam%20Roam%20Morocco!%20I'm%20interested%20in%20the%20High%20Atlas%20Mountains%20&%20Imlil%20Valley%20Trek." target="_blank" rel="noopener" class="smt-btn">
      <img src="/img/whatsapp-logo.png" alt="WhatsApp">
      <span>Book on WhatsApp</span>
    </a>
  </div>
</Layout>