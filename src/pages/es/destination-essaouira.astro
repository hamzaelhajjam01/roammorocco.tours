---
import Layout from '../../layouts/Layout.astro';

const title = "Excursión de un día a Essaouira desde Marrakech: tour privado por el Atlántico";
const description = "Excursión de un día desde Marrakech a Essaouira con chófer privado. Descubra las murallas marinas portuguesas, el marisco fresco y las cooperativas de argán en la costa.";
const canonical = "https://roammorocco.tours/es/destination-essaouira.html";
const ogImage = "https://roammorocco.tours/img/rigel-ibisQEDxODo-unsplash.jpg";
const bodyClass = "roam-light-theme";
const extraStyles = ["/css/destination-itinerary.css?v=20261012_sticky2"];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TouristDestination",
      "name": "Essaouira (Mogador) Atlantic Coast",
      "description": "Morocco's UNESCO-listed coastal bastion, renowned for its 18th-century sea walls, bustling blue-boat fishing port, Thuya wood artisans, and relaxing seaside medina.",
      "url": "https://roammorocco.tours/destination-essaouira.html",
      "touristType": [
        "Coastal Vacationers",
        "Couples",
        "Seafood Lovers",
        "Art Collectors"
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 31.5085,
        "longitude": -9.7595
      }
    },
    {
      "@type": "TouristTrip",
      "name": "Private Day Trip from Marrakech to Essaouira",
      "description": "A private, unhurried coastal excursion from Marrakech with dedicated executive transport, flexible schedule, and fresh Atlantic seafood dining.",
      "provider": {
        "@type": "TravelAgency",
        "name": "Roam Morocco Tours",
        "url": "https://roammorocco.tours/",
        "telephone": "+212760426269"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long is the drive from Marrakech to Essaouira?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The drive takes approximately 2.5 to 3 hours in our private air-conditioned vehicle. Along the way, we pass through the endemic Argan forest, where you can see the famous tree-climbing goats and visit a certified women's argan oil cooperative."
          }
        },
        {
          "@type": "Question",
          "name": "Is Essaouira cooler than Marrakech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Essaouira benefits from Atlantic trade winds (the 'Aliz\u00e9s'), keeping temperatures moderate year-round (usually 20\u00b0C to 25\u00b0C). It is the perfect refreshing escape when Marrakech gets hot in late spring and summer."
          }
        },
        {
          "@type": "Question",
          "name": "Can we buy fresh seafood directly at the port?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! One of the greatest pleasures of Essaouira is selecting fresh sea bass, sardines, prawns, or calamari directly from the fishermen at the port and having them grilled fresh over hot charcoal right in front of you."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="es" title={title} description={description} canonical={canonical} ogImage={ogImage} bodyClass={bodyClass} extraStyles={extraStyles} schema={schema}>

  <main class="dest-itinerary-main">
    <div class="dest-container">

      <!-- Breadcrumbs & Badge -->
      <div class="dest-kicker-bar">
        <div class="dest-breadcrumb">
          <a href="/es/index.html">Home</a> &nbsp;/&nbsp; <a href="/es/destinations.html">Destinations</a> &nbsp;/&nbsp; <span>Essaouira</span>
        </div>
        <span class="dest-badge-tag">ATLANTIC BASTION</span>
      </div>

      <!-- Hero Banner -->
      <div class="dest-hero">
        <img src="/img/rigel-ibisQEDxODo-unsplash.jpg" alt="Essaouira Portuguese Sea Walls and Fishing Port" class="dest-hero-img">
        <div class="dest-hero-overlay">
          <h1 class="dest-hero-title">Excursión privada de un día a Essaouira: malecones y mariscos frescos</h1>
          <p class="dest-hero-subtitle">Respire la brisa del Atlántico. Pasee por las históricas murallas portuguesas del siglo XVIII, observe cómo los barcos pesqueros de madera azul descargan sus capturas y explore las fragantes obras de arte en madera de thuya con un chofer privado.</p>
        </div>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="dest-metrics-bar">
        <span class="dest-metric-item">⏱ <strong>Duration:</strong> Full Day Excursion (or Overnight Riad Stay)</span>
        <span class="dest-metric-item">🛡 <strong>Style:</strong> Private Executive Mercedes Transport &amp; Chauffeur</span>
        <span class="dest-metric-item">📍 <strong>Departure:</strong> Marrakech (Door-to-Door Riad Pickup)</span>
        <span class="dest-metric-item">⭐ <strong>Rating:</strong> 5.0 / 5.0 (985 Verified Reviews)</span>
      </div>

      <!-- 2-Column Core Layout -->
            <!-- GEO & AEO Destination Fast Facts (BLUF) -->
      <aside class="ai-quick-summary-card" aria-label="Essaouira Travel Fast Facts">
        <div class="ai-summary-header">
          <span class="ai-summary-kicker">⚡ ESSAOUIRA AT A GLANCE (QUICK SUMMARY)</span>
          <span class="ai-summary-badge">Atlantic Coastal Haven</span>
        </div>
        <p class="ai-summary-text"><strong>Essaouira</strong> es un paraíso costero atlántico situado a 175 km (2,5 horas) al oeste de Marrakech. Famoso por su microclima ventoso, sus murallas marítimas portuguesas del siglo XVIII (Sqala du Port), mariscos frescos a la parrilla junto al puerto y talleres artesanales de madera de thuya, ofrece un retiro tranquilo de la bulliciosa medina de Marrakech. La estancia recomendada es de <strong>1 a 2 días</strong>, con tarifa plana de traslados privados con chófer de <strong>95 € (excursiones/ausflüge 140 €)</strong> por vehículo.</p>
      </aside>

      <div class="dest-layout-grid">

        <!-- Left Main Column -->
        <div class="dest-content-col">

          <!-- Highlights Callout Box -->
          <div class="dest-highlights-box">
            <h2 class="dest-highlights-title">⚡ Aspectos destacados de Essaouira y ventajas privadas</h2>
            <ul class="dest-highlights-list">
              <li><strong>Skala de la Ville y Sea Walls:</strong> Camine a lo largo de almenas oceánicas del siglo XVIII bordeadas de cañones de bronce holandeses con vista a las olas rompientes.</li>
              <li><strong>El bullicioso puerto pesquero azul:</strong> experimente el animado puerto donde los pescadores reparan las redes y descargan relucientes capturas diarias.</li>
              <li><strong>Mariscos frescos a la parrilla al carbón:</strong> Saboree besugo, langosta y sardinas a la parrilla en los puestos al aire libre del puerto o en una terraza junto al mar con brisa.</li>
              <li><strong>Artesanos de madera de Thuya:</strong> Descubra el aroma único y la artesanía de las cajas de madera de nudo con incrustaciones en las históricas bóvedas de las murallas.</li>
              <li><strong>Encuentro con árboles de argán y cabras:</strong> observe cabras posadas en las ramas de árboles de argán silvestres y recorra una cooperativa de mujeres orgánicas.</li>
            </ul>
          </div>

          <!-- Deep Narrative Overview -->
          <div class="dest-narrative">
            <h2>El alma costera bohemia de Marruecos</h2>
            <p>Essaouira, anteriormente conocida por su nombre portugués Mogador, es el paraíso costero más encantador de Marruecos. A diferencia del bullicioso laberinto de Marrakech, la medina encalada de Essaouira con sus contraventanas de color azul brillante fue diseñada por el arquitecto francés Théodore Cornut en 1760 con avenidas amplias y ventosas diseñadas para capturar el aire del océano.</p>
            <p>Durante mucho tiempo ha encantado a artistas, músicos y viajeros, desde Orson Welles (quien filmó <em>Otelo</em> a lo largo de sus murallas) hasta Jimi Hendrix. Con Roam Marruecos, saldrás de Marrakech a las 08:30 a. m. en comodidad ejecutiva, escapando del calor de la ciudad para disfrutar de la refrescante brisa marítima.</p>
            
            <div style="background:#faf8f5;border:1px solid rgba(0,0,0,0.06);border-left:4px solid var(--gold,#C8A45C);border-radius:16px;padding:24px;margin:24px 0;">
              <p style="font-style:italic;margin:0 0 8px;font-size:15px;color:#333;">"Essaouira huele a salmuera, a virutas de madera y a sardinas recién asadas. Es donde uno reduce el paso, respira el océano y observa cómo las gaviotas del Atlántico vuelan sobre la piedra portuguesa".</p>
              <span style="font-family:'Inter',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#8A6A23;">— ROAM MOROCCO COASTAL DISPATCH</span>
            </div>
            
            <p>Tienes total libertad: almuerza en una terraza frente al mar, pasea por las galerías artesanales o pasea por la amplia playa en forma de media luna antes de un relajado regreso a Marrakech por la tarde.</p>
          </div>

          <!-- Day-by-Day Detailed Itinerary -->
          <div class="dest-itinerary-timeline">
            <h3 class="dest-itinerary-header"><span>Itinerario privado de día completo en Essaouira</span>
              <span style="font-size:11px;font-family:'Inter',sans-serif;font-weight:700;letter-spacing:0.06em;color:#8A6A23;background:rgba(200,164,92,0.12);border:1px solid rgba(200,164,92,0.28);padding:4px 12px;border-radius:999px;">RELAJADO Y SIN PRISA</span></h3>

            <!-- Timeline -->
            <div class="dest-day-card">
              <span class="dest-day-kicker">08:30 AM // ARGAN FORESTS &amp; COASTAL DRIVE</span>
              <h4 class="dest-day-title">Marrakech → Cabras de árbol de argán → Cooperativa ecológica</h4>
              <p class="dest-day-desc">Su chofer privado lo recibirá en su riad a las 08:30 a.m. Viaje hacia el oeste a través de las llanuras semiáridas hasta la Reserva de la Biosfera de Argán, protegida por la UNESCO. Haga una pausa para observar y fotografiar las famosas cabras alimentándose en las ramas de argán. Visite una auténtica cooperativa de aceite de argán dirigida por mujeres para aprender cómo se prensan en frío a mano los aceites cosméticos y culinarios.</p>
              <div class="dest-day-tags">
                <span>Distance: ~175 km</span>
                <span>Scenic 2.5-Hour Drive</span>
                <span>Argan Cooperative Visit</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">11:30 AM // BLUE HARBOR &amp; RAMPARTS</span>
              <h4 class="dest-day-title">Skala du Port → Gremios de la Medina → Almuerzo de pescado a la parrilla</h4>
              <p class="dest-day-desc">Llegada a Essaouira. Camine a lo largo de las históricas murallas del puerto, donde los barcos pesqueros de madera azul se mecen suavemente con la marea. Explore Skala de la Ville para disfrutar de espectaculares vistas del océano Atlántico. Dirígete a los bulliciosos puestos de parrilladas de pescado o a un exclusivo restaurante junto al mar para disfrutar de ostras frescas y lubina a la parrilla capturadas esa mañana.</p>
              <div class="dest-day-tags">
                <span>4.5 Hours Free Time</span>
                <span>Portuguese Ramparts</span>
                <span>Fresh Seafood Feast</span>
              </div>
            </div>

            <div class="dest-day-card">
              <span class="dest-day-kicker">04:30 PM // BEACH STROLL &amp; SUNSET DRIVE HOME</span>
              <h4 class="dest-day-title">Paseo por la playa O compras en boutiques → Marrakech Volver</h4>
              <p class="dest-day-desc">Pase el resto de la tarde comprando madera de tuya, especias y joyas bereberes, o dé un agradable paseo por la playa de arena. Su chófer le dará la bienvenida a su vehículo para un relajado viaje al atardecer de regreso a Marrakech y le dejará directamente en su riad a las 19:00.</p>
              <div class="dest-day-tags">
                <span>Beach Stroll</span>
                <span>Door-to-Door Riad Drop-Off</span>
                <span>Back for Marrakech Dinner</span>
              </div>
            </div>
          </div>

          <!-- Inclusions & Exclusions Checklist -->
          <div class="dest-inclusions-card">
            <h3 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;margin:0 0 20px;">¿Qué está incluido en su tour privado de Essaouira?</h3>
            <div class="dest-inclusions-grid">
              <div class="dest-inc-col">
                <h4 style="color:#25D366;">✔ INCLUIDO</h4>
                <ul class="dest-inc-list">
                  <li>Traslado privado ida y vuelta en vehículo ejecutivo con aire acondicionado.</li>
                  <li>Chofer bereber profesional de habla inglesa.</li>
                  <li>Todo el combustible del vehículo, peajes de autopistas y tarifas de estacionamiento.</li>
                  <li>Parada en la auténtica cooperativa de mujeres de aceite de argán</li>
                  <li>Recogida y regreso puerta a puerta directamente en su riad de Marrakech</li>
                  <li>Agua mineral helada a bordo.</li>
                </ul>
              </div>
              <div class="dest-inc-col">
                <h4 style="color:#f10b18;">✕ NO INCLUIDO</h4>
                <ul class="dest-exc-list">
                  <li>Almuerzo (brindamos recomendaciones de playa examinadas)</li>
                  <li>Entrada a Skala du Port (~50 MAD)</li>
                  <li>Propina discrecional del chófer</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="dest-faq-box">
            <h3 class="dest-faq-title">Preguntas frecuentes: Tours en Esauira</h3>
            
            <div class="dest-faq-item active">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">¿Podemos pasar la noche en Essaouira?</h4>
              <div class="dest-faq-a">
                <p>¡Sí, absolutamente! Pasar 1 o 2 noches en un riad costero boutique o en una villa de lujo frente al mar es una de las adiciones más relajantes a cualquier itinerario por Marruecos. Podemos adaptar este recorrido como un traslado de ida o una escapada costera de varios días.</p>
              </div>
            </div>

            <div class="dest-faq-item">
              <h4 class="dest-faq-q" onclick="toggleFaq(this)">¿Es fácil caminar por Essaouira sin guía?</h4>
              <div class="dest-faq-a">
                <p>¡Sí! A diferencia de Fez o Marrakech, la medina de Essaouira es compacta y sencilla, con amplias calles rectilíneas. Es prácticamente imposible perderse, lo que hace que la exploración autoguiada sea muy placentera. Sin embargo, se puede contratar un guía privado con licencia previa solicitud.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar -->
                <!-- Right Sticky Sidebar: Pre-Locked Route Card -->
        <aside class="dest-sidebar-col">
          <div class="dest-prelocked-widget"
               data-tour-name="Essaouira Atlantic Coast Private Excursion"
               data-price-1-4="140"
               data-price-5-7="185"
               data-price-8-12="250"
               data-tour-sub="Historic ramparts, fresh Atlantic seafood port &amp; argan forest route">
            
            <div class="dest-prelocked-badge"><span>●</span> INSTANT DIRECT BOOKING</div>
            <h3 class="dest-prelocked-title">Excursión privada a la costa atlántica de Essaouira</h3>
            <p class="dest-prelocked-sub">Murallas históricas, puerto de mariscos frescos del Atlántico y ruta del bosque de argán</p>

            <label class="dest-form-label" style="margin-bottom:6px;display:block;">Group Size &amp; Vehicle</label>
            <div class="dest-tier-grid">
              <button type="button" class="dest-tier-btn active" data-tier="1_4">
                <span class="dest-tier-pax">1–4 Pax</span>
                <span class="dest-tier-veh">Sedan / 4x4</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="5_7">
                <span class="dest-tier-pax">5–7 Pax</span>
                <span class="dest-tier-veh">VIP Van</span>
              </button>
              <button type="button" class="dest-tier-btn" data-tier="8_12">
                <span class="dest-tier-pax">8–12 Pax</span>
                <span class="dest-tier-veh">Minibus</span>
              </button>
            </div>

            <div class="dest-prelocked-fields">
              <div class="dest-form-field">
                <label class="dest-form-label" for="pickupCityEssaouira">Departure City</label>
                <select class="dest-form-select dest-prelocked-city" id="pickupCityEssaouira">
                  <option value="Marrakech (Medina / Riad)" selected>Marrakech (Medina / Riad)</option>
                  <option value="Marrakech (Palmeraie)">Marrakech (Palmeraie)</option>
                </select>
              </div>

              <div class="dest-form-field">
                <label class="dest-form-label" for="travelDateEssaouira">Approx. Travel Date</label>
                <input class="dest-form-input dest-prelocked-date" type="date" id="travelDateEssaouira">
              </div>
            </div>

            <div class="dest-prelocked-price-box">
              <div class="dest-prelocked-price-num">140€</div>
              <span class="dest-prelocked-price-sub">Total private group price (not per person)</span>
              <p class="dest-prelocked-price-note">Incluye transporte privado ida y vuelta, visita a la cooperativa de argán, combustible, peajes de autopistas y tiempo en las murallas.</p>
            </div>

            <a href="#" class="dest-prelocked-wa-btn">
              <img src="/img/whatsapp-logo.png" alt="WhatsApp">
              <span>Book via WhatsApp <span class="dest-prelocked-btn-price">— 140€</span></span>
            </a>

            <div class="dest-prelocked-trust">
              <span>🛡 <strong>100% Private:</strong> Dedicated vehicle &amp; local Berber driver.</span>
              <span>⚡ <strong>Fast Confirmation:</strong> Operations team replies &lt; 10 mins.</span>
              <span>🇲🇦 <strong>Zero Deposit:</strong> No upfront deposit needed to check dates.</span>
            </div>
          </div>
        </aside>

      </div>

    </div>
  </main>

    <!-- Signature Footer -->

  <script is:inline>
    
    function scrollToBookingForm(e) {
      if (e) e.preventDefault();
      const formBox = document.querySelector('.dest-booking-widget') || document.querySelector('.dest-sidebar-col');
      if (formBox) {
        const yOffset = -80;
        const y = formBox.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        setTimeout(() => {
          const input = document.getElementById('clientName');
          if (input) input.focus();
        }, 500);
      }
    }

    function scrollToTop(e){ if(e) e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function onScroll(){
      const currentY = window.scrollY;
      const topEl = document.querySelector(".top");
      if(topEl){
        if(currentY < 70){
          topEl.classList.add("at-top");
          topEl.classList.remove("at-bottom");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-dark-bg.png';
        } else {
          topEl.classList.add("at-bottom");
          topEl.classList.remove("at-top");
          const logo = document.getElementById('navLogo');
          if(logo) logo.src = '/img/logo-for-light-bg.png';
        }
      }
    }
    addEventListener("scroll", onScroll, {passive: true});
    onScroll();

    function toggleFaq(btn){
      const item = btn.closest('.dest-faq-item');
      if(item) item.classList.toggle('active');
    }

    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if(burgerBtn && mobileDrawer){
      burgerBtn.addEventListener('click', function(e){
        e.stopPropagation();
        mobileDrawer.classList.toggle('open');
      });
      document.addEventListener('click', function(e){
        if(!mobileDrawer.contains(e.target) && !burgerBtn.contains(e.target)){
          mobileDrawer.classList.remove('open');
        }
      });
    }
    function closeDrawer(){
      if(mobileDrawer) mobileDrawer.classList.remove('open');
    }

    async function handleInquirySubmit(e, tourName){
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.dest-submit-btn');
      
      const name = (document.getElementById('clientName')?.value || '').trim();
      const email = (document.getElementById('clientEmail')?.value || '').trim();
      const phone = (document.getElementById('clientPhone')?.value || '').trim();
      const dates = (document.getElementById('travelDates')?.value || '').trim();
      const type = (document.getElementById('tripType')?.value || '').trim();
      const notes = (document.getElementById('notes')?.value || '').trim();

      const payload = {
        name: name,
        email: email,
        phone: phone,
        service: tourName + (type ? ` (${type})` : ''),
        pickup: 'Marrakech to Essaouira Coast',
        vehicle: type,
        date: dates,
        notes: notes,
        source: window.location.pathname
      };

      const waMsg = `Salam Roam Morocco! I would like to inquire about an ${tourName}:\n\n` +
        `👤 Name: ${name}\n` +
        `✉️ Email: ${email}\n` +
        `📱 WhatsApp: ${phone}\n` +
        (type ? `🌊 Trip Format: ${type}\n` : '') +
        (dates ? `📅 Travel Date: ${dates}\n` : '') +
        (notes ? `📝 Notes: ${notes}\n` : '') +
        `\nCan you please confirm private driver availability and send a quote?`;
      
      const waUrl = `https://wa.me/212760426269?text=${encodeURIComponent(waMsg)}`;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      let statusBox = document.getElementById('destFormStatus');
      if (!statusBox) {
        statusBox = document.createElement('div');
        statusBox.id = 'destFormStatus';
        statusBox.className = 'dest-form-status';
        form.appendChild(statusBox);
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          event_category: 'conversion',
          event_label: tourName,
          value: 200,
          currency: 'EUR'
        });
      }

      try {
        await fetch('send-quote.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusBox.style.display = 'block';
        statusBox.innerHTML = `<strong>✓ Proposal Request Dispatched!</strong>Thank you, ${name}. Your inquiry for <strong>${tourName}</strong> has been sent to our team. We will check private vehicle and driver availability and email you at <strong>${email}</strong> within 30 minutes.<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Chat with Local Specialist on WhatsApp &rarr;</a>`;

        if (submitBtn) {
          submitBtn.textContent = '✓ REQUEST SENT TO OPERATIONS';
          submitBtn.style.background = '#16a34a';
          submitBtn.style.borderColor = '#16a34a';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 1000);

      } catch (err) {
        statusBox.style.display = 'block';
        statusBox.innerHTML = `Connecting directly to our Marrakech WhatsApp desk...<br><a href="${waUrl}" target="_blank" rel="noopener" class="dest-status-wa"><img src="/img/whatsapp-logo.png" alt="WhatsApp"> Open WhatsApp &rarr;</a>`;
        window.open(waUrl, '_blank');
      }
    }
  </script>

  <!-- Sticky Mobile Tour Bar (<900px) -->
  <div class="sticky-mobile-tour-bar">
    <div class="smt-info">
      <div class="smt-title">Essaouira Private Excursion</div>
      <div class="smt-price">From <span class="smt-price-num">140€</span> <span>per vehicle</span></div>
    </div>
    <a href="https://wa.me/212760426269?text=Salam%20Roam%20Morocco!%20I'm%20interested%20in%20the%20Essaouira%20Atlantic%20Coast%20Private%20Excursion." target="_blank" rel="noopener" class="smt-btn">
      <img src="/img/whatsapp-logo.png" alt="WhatsApp">
