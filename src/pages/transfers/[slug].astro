---
import Layout from '../../layouts/Layout.astro';
import { routesData, type RouteItem } from '../../data/routes';
import { getRouteCorridorDetails } from '../../data/corridorDetails';

export async function getStaticPaths() {
  return routesData.map((route) => ({
    params: { slug: route.slug },
    props: { route }
  }));
}

interface Props {
  route: RouteItem;
}

const { route } = Astro.props;
const corridor = getRouteCorridorDetails(route);

const canonical = `https://roammorocco.tours/transfers/${route.slug}.html`;
const ogImage = "https://roammorocco.tours/images/morocco_private_driver.webp";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": route.h1,
    "description": route.seoDescription,
    "url": canonical,
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".route-hero-title", ".faq-a"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://roammorocco.tours/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Transfers",
        "item": "https://roammorocco.tours/transfers.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": `${route.from} to ${route.to}`,
        "item": canonical
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": ["Service", "Product"],
    "name": `Private Transfer from ${route.from} to ${route.to}`,
    "description": route.seoDescription,
    "image": [
      "https://roammorocco.tours/images/fleet-mercedes-v-class.webp",
      "https://roammorocco.tours/images/fleet-toyota-prado-4x4.webp"
    ],
    "sku": `RM-TR-${route.id}`,
    "mpn": `RM-TR-${route.id}`,
    "provider": {
      "@type": "TravelAgency",
      "name": "Roam Morocco Tours",
      "url": "https://roammorocco.tours/",
      "telephone": "+212 760-426269"
    },
    "brand": {
      "@type": "Brand",
      "name": "Roam Morocco Tours"
    },
    "offers": {
      "@type": "Offer",
      "price": route.price_sedan.toString(),
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-01-01",
      "priceValidUntil": "2027-12-31",
      "url": canonical,
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "MA",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 2,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "EUR"
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "MA"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 0,
            "maxValue": 0,
            "unitCode": "DAY"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 0,
            "maxValue": 0,
            "unitCode": "DAY"
          }
        }
      }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "bestRating": "5",
      "worstRating": "1",
      "ratingCount": "985",
      "reviewCount": "985"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": corridor.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];

const waMessage = encodeURIComponent(`Salam Roam Morocco! I'd like to book a private transfer from ${route.from} to ${route.to} (${route.price_sedan}€).`);
const waUrl = `https://wa.me/212760426269?text=${waMessage}`;
---

<Layout
  title={route.seoTitle}
  description={route.seoDescription}
  canonical={canonical}
  ogImage={ogImage}
  schema={schema}
>
  <main class="route-page-main">
    
    <!-- 1. BREADCRUMBS & HERO SECTION (RESTORED OLD DESIGN WITH DESTINATIONS BREADCRUMBS) -->
    <section class="route-hero">
      <div class="route-container">
        
        <!-- Monospace Uppercase Underlined Breadcrumbs matching destinations -->
        <nav class="dest-breadcrumb" aria-label="Breadcrumb">
          <a href="/index.html">HOME</a> &nbsp;/&nbsp; <a href="/transfers.html">TRANSFERS</a> &nbsp;/&nbsp; <span>{route.from.toUpperCase()} TO {route.to.toUpperCase()}</span>
        </nav>

        <div class="route-hero-badge">
          <span class="gold-dot"></span>
          <span>{corridor.badge}</span>
        </div>

        <h1 class="route-hero-title">{route.h1}</h1>
        <p class="route-hero-subtitle">
          Direct door-to-door private chauffeur service between {route.from} and {route.to}. 
          Enjoy an unhurried, comfortable ride with a professional English-speaking driver, 
          pristine air-conditioned fleet, and zero hidden luggage or highway toll charges.
        </p>

        <!-- Route Metrics Summary Bar -->
        <div class="route-metrics-bar">
          <div class="metric-pill">
            <span class="metric-label">DRIVE TIME</span>
            <strong class="metric-value">{route.duration}</strong>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-pill">
            <span class="metric-label">DISTANCE</span>
            <strong class="metric-value">{route.distance}</strong>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-pill">
            <span class="metric-label">STARTING AT</span>
            <strong class="metric-value gold-text">€{route.price_sedan}</strong>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-pill">
            <span class="metric-label">ROUTE CORRIDOR</span>
            <strong class="metric-value">{route.highway}</strong>
          </div>
        </div>

        <!-- Quick Action CTAs -->
        <div class="route-hero-actions">
          <a href={waUrl} target="_blank" rel="noopener" class="primary-wa-cta">
            <img src="/img/whatsapp-logo.png" alt="WhatsApp" width="20" height="20" class="wa-btn-icon">
            <span>Book via WhatsApp (€{route.price_sedan})</span>
          </a>
          <a href="#pricing-tiers" class="secondary-calc-cta">
            <span>View Vehicle Fleet &amp; Rates ↓</span>
          </a>
        </div>

      </div>
    </section>

    <!-- 2. TRANSPARENT VEHICLE PRICING TIERS -->
    <section class="route-pricing-section" id="pricing-tiers">
      <div class="route-container">
        
                <div class="section-head">
          <span class="section-kicker">GUARANTEED TRANSPARENT RATES</span>
          <h2>Choose Your Private Vehicle</h2>
          <p>Flat rate per vehicle (not per person). Includes fuel, highway tolls, parking, and door-to-door luggage care.</p>
          <div class="route-perks-pills">
            <span class="perk-pill">🔄 <strong>Round-Trip Deal:</strong> 10% off return journey</span>
            <span class="perk-pill">💳 <strong>Fair Deposit:</strong> 0% under €300 · 30% over €300</span>
          </div>
        </div>

        <div class="pricing-tiers-grid">
          
          <!-- Tier 1: Comfort Sedan -->
          <div class="tier-card">
            <div class="tier-badge">POPULAR FOR COUPLES</div>
            <div class="tier-head">
              <h3>Comfort Sedan</h3>
              <p class="tier-desc">Ideal for solo travelers, couples, or small parties with standard luggage.</p>
            </div>
            <div class="tier-price-row">
              <span class="tier-price">€{route.price_sedan}</span>
              <span class="tier-price-unit">total · cash to driver</span>
            </div>
            <ul class="tier-features">
              <li>✓ <strong>1 to 4 Passengers</strong></li>
              <li>✓ Up to 3 large suitcases</li>
              <li>✓ Dual-zone climate control</li>
              <li>✓ Professional English/French chauffeur</li>
              <li>✓ Door-to-door hotel/riad pickup</li>
              <li>✓ Free child or booster seats</li>
            </ul>
            <a href={`https://wa.me/212760426269?text=${encodeURIComponent(`Salam Roam Morocco! I'd like to book a Comfort Sedan from ${route.from} to ${route.to} (${route.price_sedan}€).`)}`} target="_blank" rel="noopener" class="tier-book-btn">
              <span>Book Sedan (€{route.price_sedan})</span>
            </a>
          </div>

          <!-- Tier 2: Executive Minivan (Featured) -->
          <div class="tier-card featured-tier">
            <div class="tier-badge gold-badge">MOST POPULAR · EXTRA COMFORT</div>
            <div class="tier-head">
              <h3>Comfort Van</h3>
              <p class="tier-desc">Spacious executive van for families and small groups (5–7 passengers).</p>
            </div>
            <div class="tier-price-row">
              <span class="tier-price gold-text">€{route.price_van}</span>
              <span class="tier-price-unit">total · cash to driver</span>
            </div>
            <ul class="tier-features">
              <li>✓ <strong>5 to 7 Passengers</strong></li>
              <li>✓ Up to 7 large suitcases</li>
              <li>✓ Executive leather seating &amp; privacy glass</li>
              <li>✓ High-clearance suspension for smooth travel</li>
              <li>✓ Bottled mineral water &amp; phone chargers</li>
              <li>✓ Free flight delay tracking included</li>
            </ul>
            <a href={`https://wa.me/212760426269?text=${encodeURIComponent(`Salam Roam Morocco! I'd like to book a Comfort Van from ${route.from} to ${route.to} (${route.price_van}€).`)}`} target="_blank" rel="noopener" class="tier-book-btn featured-btn">
              <span>Book Comfort Van (€{route.price_van})</span>
            </a>
          </div>

          <!-- Tier 3: Minibus -->
          <div class="tier-card">
            <div class="tier-badge">GROUPS &amp; RETREATS</div>
            <div class="tier-head">
              <h3>Luxury Minibus</h3>
              <p class="tier-desc">Private group comfort with generous luggage hold (8–14 passengers).</p>
            </div>
            <div class="tier-price-row">
              <span class="tier-price">€{route.price_minibus}</span>
              <span class="tier-price-unit">total · cash to driver</span>
            </div>
            <ul class="tier-features">
              <li>✓ <strong>8 to 14 Passengers</strong></li>
              <li>✓ 12+ large suitcases + carry-ons</li>
              <li>✓ High-roof walkthrough cabin</li>
              <li>✓ Dedicated AC vents for every seat row</li>
              <li>✓ Perfect for family reunions or retreat groups</li>
              <li>✓ Punctual, courteous corporate-grade driver</li>
            </ul>
            <a href={`https://wa.me/212760426269?text=${encodeURIComponent(`Salam Roam Morocco! I'd like to book a Minibus from ${route.from} to ${route.to} (${route.price_minibus}€).`)}`} target="_blank" rel="noopener" class="tier-book-btn">
              <span>Book Minibus (€{route.price_minibus})</span>
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- 3. ROUTE HIGHLIGHTS & ITINERARY EXPERIENCE -->
    <section class="route-details-section">
      <div class="route-container">
        
        <div class="details-grid">
          
          <div class="details-content">
            <span class="section-kicker">{corridor.terrainKicker}</span>
            <h2>{corridor.terrainTitle}</h2>
            <p class="terrain-overview-text">
              {corridor.terrainOverview}
            </p>

            <!-- Medina Gate & Baggage Logistics -->
            <div class="medina-logistics-box">
              <div class="ml-header">
                <span class="ml-icon">🚪</span>
                <h3>{corridor.medinaLogistics.title}</h3>
              </div>
              <p>{corridor.medinaLogistics.description}</p>
              <ul class="ml-tips-list">
                {corridor.medinaLogistics.tips.map((tip) => (
                  <li>
                    <span class="ml-bullet">✦</span>
                    <span>{tip}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Scenic Waypoints & Recommended Stops -->
            <div class="scenic-waypoints-block">
              <h3>Recommended Waypoints &amp; Scenic Rest Stops</h3>
              <div class="scenic-stops-list">
                {corridor.scenicStops.map((stop, idx) => (
                  <div class="scenic-stop-item">
                    <div class="stop-num">0{idx + 1}</div>
                    <div class="stop-text">
                      <h4>{stop.title}</h4>
                      <p>{stop.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Inclusions -->
            <div class="highlights-box">
              <h3>Route Highlights &amp; Standard Inclusions</h3>
              <ul class="highlights-list">
                {route.highlights.map((h) => (
                  <li>
                    <span class="hl-check">✓</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="trust-banner">
              <div class="trust-pill">
                <strong>01. Zero Prepayment</strong>
                <span>Pay cash to your driver upon arrival.</span>
              </div>
              <div class="trust-pill">
                <strong>02. Free Cancellation</strong>
                <span>Change dates or cancel with 24h notice.</span>
              </div>
              <div class="trust-pill">
                <strong>03. Flight Delay Tracking</strong>
                <span>Driver waits with no late fees.</span>
              </div>
            </div>
          </div>

          <!-- Quick Booking Concierge Card -->
          <div class="details-card-wrap">
            <div class="concierge-card">
              <h3>Need a custom pickup or round-trip?</h3>
              <p>Chat directly with our Marrakech expedition team. We respond in under 10 minutes on WhatsApp.</p>
              
              <div class="concierge-features">
                <div class="cf-item">
                  <span class="cf-icon">⏱</span>
                  <div>
                    <strong>Average Response Time</strong>
                    <span>Under 10 minutes on WhatsApp</span>
                  </div>
                </div>
                <div class="cf-item">
                  <span class="cf-icon">🛡️</span>
                  <div>
                    <strong>ASTA &amp; Transport Touristique</strong>
                    <span>100% legal, insured &amp; licensed</span>
                  </div>
                </div>
                <div class="cf-item">
                  <span class="cf-icon">⭐</span>
                  <div>
                    <strong>5.0 / 5.0 Rating</strong>
                    <span>985+ verified reviews worldwide</span>
                  </div>
                </div>
              </div>

              <a href={waUrl} target="_blank" rel="noopener" class="concierge-wa-btn">
                <img src="/img/whatsapp-logo.png" alt="WhatsApp" width="18" height="18" class="wa-btn-icon">
                <span>Message on WhatsApp</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 4. FREQUENTLY ASKED QUESTIONS -->
    <section class="route-faq-section">
      <div class="route-container">
        
        <div class="section-head">
          <span class="section-kicker">ANSWERS &amp; ADVICE</span>
          <h2>Frequently Asked Questions</h2>
          <p>Everything you need to know about your private transfer between {route.from} and {route.to}.</p>
        </div>

        <div class="faq-list">
          {corridor.faqs.map((faq, idx) => (
            <div class="faq-card">
              <h3 class="faq-q">
                <span class="faq-num">0{idx + 1}.</span>
                <span>{faq.q}</span>
              </h3>
              <p class="faq-a">{faq.a}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 5. FINAL BOOKING CTA BANNER -->
    <section class="route-cta-banner">
      <div class="route-container">
        <div class="cta-inner">
          <span class="cta-kicker">READY TO TRAVEL?</span>
          <h2>Reserve Your {route.from} to {route.to} Private Chauffeur</h2>
          <p>Locked-in fixed rate of €{route.price_sedan}. 0% deposit for bookings ≤ €300 (pay cash on arrival). 30% deposit to confirm bookings > €300.</p>
          <a href={waUrl} target="_blank" rel="noopener" class="cta-button">
            <img src="/img/whatsapp-logo.png" alt="WhatsApp" width="22" height="22" class="wa-btn-icon">
            <span>Instant Booking on WhatsApp (€{route.price_sedan}) →</span>
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style is:global>
  /* ── ROUTE PAGE MODERN DESIGN SYSTEM ── */
  .route-perks-pills {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }
  .perk-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fdf8ed;
    border: 1px solid #C8A45C;
    color: #8A6A23;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 20px;
  }

  .route-page-main {
    padding-top: 100px;
    background: #fbf9f5;
    color: #111111;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .route-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ── MODERN BREADCRUMBS ── */
  .dest-breadcrumb {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(0, 0, 0, 0.45);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .dest-breadcrumb a {
    color: rgba(0, 0, 0, 0.55);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .dest-breadcrumb a:hover {
    color: #C8A45C;
  }
  .dest-breadcrumb span {
    color: #000000;
    font-weight: 700;
  }

  /* Hero Section */
  .route-hero {
    padding: 20px 0 60px;
  }
  .route-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(200, 164, 92, 0.12);
    border: 1px solid rgba(200, 164, 92, 0.3);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #9A7228;
    margin-bottom: 18px;
  }
  .gold-dot {
    width: 6px;
    height: 6px;
    background: #C8A45C;
    border-radius: 50%;
  }
  .route-hero-title {
    font-size: clamp(32px, 4.5vw, 54px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    max-width: 900px;
  }
  .route-hero-subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.65);
    max-width: 820px;
    margin: 0 0 32px;
  }

  /* Metrics Bar */
  .route-metrics-bar {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.04);
    border-radius: 16px;
    padding: 16px 28px;
    gap: 28px;
    max-width: max-content;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .metric-pill {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .metric-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: rgba(0, 0, 0, 0.45);
  }
  .metric-value {
    font-size: 18px;
    font-weight: 800;
    color: #000;
  }
  .metric-divider {
    width: 1px;
    height: 32px;
    background: rgba(0, 0, 0, 0.08);
  }
  .gold-text {
    color: #C8A45C !important;
  }

  /* Hero Actions */
  .route-hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .primary-wa-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25D366;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 26px;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.35);
    transition: transform 0.2s, background 0.2s;
  }
  .primary-wa-cta:hover {
    background: #20ba59;
    transform: translateY(-2px);
  }
  .secondary-calc-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    color: #000;
    padding: 14px 22px;
    border-radius: 9999px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .secondary-calc-cta:hover {
    border-color: #C8A45C;
    background: rgba(200, 164, 92, 0.06);
  }

  /* ── GEO & AEO QUICK ANSWER CARD (BLUF) ── */
  .route-quick-answer-card {
    background: #ffffff;
    border: 1px solid rgba(200, 164, 92, 0.35);
    border-left: 4px solid #C8A45C;
    border-radius: 14px;
    padding: 20px 24px;
    margin-top: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }
  .quick-answer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    gap: 12px;
  }
  .quick-answer-tag {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #9A7B38;
    text-transform: uppercase;
  }
  .quick-answer-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(37, 211, 102, 0.1);
    color: #15803d;
    padding: 3px 10px;
    border-radius: 9999px;
  }
  .quick-answer-text {
    font-size: 14.5px;
    line-height: 1.65;
    color: #334155;
    margin: 0;
  }
  .quick-answer-text strong {
    color: #0f172a;
    font-weight: 700;
  }

  /* Section Headings */
  .section-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
  }
  .section-kicker {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #C8A45C;
    text-transform: uppercase;
    display: block;
