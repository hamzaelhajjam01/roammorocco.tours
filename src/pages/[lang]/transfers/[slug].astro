---
import Layout from '../../../layouts/Layout.astro';
import routesFr from '../../../data/routes-fr.json';
import routesEs from '../../../data/routes-es.json';
import routesDe from '../../../data/routes-de.json';
import routesIt from '../../../data/routes-it.json';

export async function getStaticPaths() {
  const dataset = {
    fr: routesFr,
    es: routesEs,
    de: routesDe,
    it: routesIt
  };

  const paths = [];
  for (const [lang, routes] of Object.entries(dataset)) {
    for (const route of routes) {
      paths.push({
        params: { lang, slug: route.slug },
        props: { lang, route }
      });
    }
  }

  return paths;
}

const { lang, route } = Astro.props;

const canonical = `https://roammorocco.tours/${lang}/transfers/${route.slug}.html`;
const ogImage = "https://roammorocco.tours/images/morocco_private_driver.webp";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
