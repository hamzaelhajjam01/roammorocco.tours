    tier3Badge: "GRUPPI & RITIRI",
    tier3Title: "Minibus Privato (Mercedes Sprinter)",
    tier3Desc: "Massimo comfort di gruppo con ampio bagagliaio separato.",
    tier3Features: [
      "Da 8 a 12+ Passeggeri",
      "12+ valigie grandi + bagagli a mano",
      "Cabina alta con corridoio centrale",
      "Bocchette aria condizionata per ogni fila",
      "Ideale per riunioni di famiglia o ritiri yoga",
      "Autista puntuale e cortese"
    ],
    bookMinibus: `Prenota Minibus (€${route.price_minibus})`,
    expectKicker: "ESPERIENZA DI VIAGGIO",
    expectTitle: `Il Tuo Viaggio Privato da ${route.from} a ${route.to}`,
    expectDesc: `Prenotando il tuo transfer privato con Roam Morocco, viaggi senza lo stress di stazioni o taxi collettivi. Il tuo autista autorizzato ti aspetta direttamente alla porta del riad, in hotel o all'uscita dell'aeroporto con cartello personalizzato.`,
    highlightsTitle: "Punti di Forza e Servizi Inclusi",
    trust1Title: "01. Zero Anticipo",
    trust1Desc: "Paga in contanti al tuo autista all'arrivo.",
    trust2Title: "02. Cancellazione Gratuita",
    trust2Desc: "Modifica o cancella senza penali fino a 24 ore prima.",
    trust3Title: "03. Monitoraggio Voli in Tempo Reale",
    trust3Desc: "L'autista ti aspetta anche in caso di ritardo senza costi extra.",
    conciergeTitle: "Hai bisogno di un itinerario su misura o andata e ritorno?",
    conciergeDesc: "Contatta direttamente il nostro team a Marrakech. Risposta in meno di 10 minuti su WhatsApp.",
    avgResponse: "Tempo medio di risposta",
    avgResponseSub: "Meno di 10 minuti su WhatsApp",
    licensedAgency: "Agenzia e Trasporto Turistico Autorizzato",
    licensedAgencySub: "100% legale, assicurato e professionale",
    ratingTitle: "Valutazione 5.0 / 5.0",
    ratingSub: "Oltre 985 recensioni verificate",
    messageWa: "Invia messaggio su WhatsApp",
    faqKicker: "RISPOSTE E CONSIGLI",
    faqTitle: "Domande Frequenti",
    faqDesc: `Tutto quello che c'è da sapere sul tuo transfer privato da ${route.from} a ${route.to}.`,
    readyKicker: "PRONTO A PARTIRE?",
    readyTitle: `Prenota il Tuo Autista Privato da ${route.from} a ${route.to}`,
    readyDesc: `Prezzo fisso garantito da €${route.price_sedan}. Nessuna carta di credito richiesta oggi — paga direttamente l'autista a bordo.`,
    instantWa: `Prenota Subito su WhatsApp (€${route.price_sedan}) →`,
    waGreeting: `Salam Roam Morocco! Vorrei prenotare un transfer privato da ${route.from} a ${route.to} (${route.price_sedan}€).`
  }
};

const t = i18n[lang] || i18n.fr;

const waMessage = encodeURIComponent(t.waGreeting);
const waUrl = `https://wa.me/212653506441?text=${waMessage}`;
---

<Layout
  lang={lang}
  title={route.seoTitle}
  description={route.seoDescription}
  canonical={canonical}
  ogImage={ogImage}
  schema={schema}
>
  <main class="route-page-main">
    
    <!-- 1. BREADCRUMBS & HERO SECTION -->
    <section class="route-hero">
      <div class="route-container">
        
        <nav class="dest-breadcrumb" aria-label="Breadcrumb">
          <a href={`/${lang}/index.html`}>{t.home}</a> &nbsp;/&nbsp; <a href={`/${lang}/transfers.html`}>{t.transfers}</a> &nbsp;/&nbsp; <span>{route.from.toUpperCase()} → {route.to.toUpperCase()}</span>
        </nav>

        <div class="route-hero-badge">
          <span class="gold-dot"></span>
          <span>{t.badge}</span>
        </div>

        <h1 class="route-hero-title">{route.h1}</h1>
        <p class="route-hero-subtitle">{t.subtitle}</p>

        <!-- Route Metrics Summary Bar -->
        <div class="route-metrics-bar">
          <div class="metric-pill">
            <span class="metric-label">{t.driveTime}</span>
            <strong class="metric-value">{route.duration}</strong>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-pill">
            <span class="metric-label">{t.distance}</span>
            <strong class="metric-value">{route.distance}</strong>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-pill">
            <span class="metric-label">{t.startingAt}</span>
            <strong class="metric-value gold-text">€{route.price_sedan}</strong>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-pill">
            <span class="metric-label">{t.corridor}</span>
            <strong class="metric-value">{route.highway}</strong>
          </div>
        </div>

        <!-- Quick Action CTAs -->
        <div class="route-hero-actions">
          <a href={waUrl} target="_blank" rel="noopener" class="primary-wa-cta">
            <img src="/img/whatsapp-logo.png" alt="WhatsApp" width="20" height="20" class="wa-btn-icon">
            <span>{t.bookWa}</span>
          </a>
          <a href="#pricing-tiers" class="secondary-calc-cta">
            <span>{t.viewFleet}</span>
          </a>
        </div>

      </div>
    </section>

    <!-- 2. TRANSPARENT VEHICLE PRICING TIERS -->
    <section class="route-pricing-section" id="pricing-tiers">
      <div class="route-container">
        
        <div class="section-head">
          <span class="section-kicker">{t.ratesKicker}</span>
          <h2>{t.chooseVehicle}</h2>
          <p>{t.ratesDesc}</p>
        </div>

        <div class="pricing-tiers-grid">
          
          <!-- Tier 1: Comfort Sedan -->
          <div class="tier-card">
            <div class="tier-badge">{t.tier1Badge}</div>
            <div class="tier-head">
              <h3>{t.tier1Title}</h3>
              <p class="tier-desc">{t.tier1Desc}</p>
            </div>
            <div class="tier-price-row">
              <span class="tier-price">€{route.price_sedan}</span>
              <span class="tier-price-unit">{t.cashToDriver}</span>
            </div>
            <ul class="tier-features">
              {t.tier1Features.map((f) => (
                <li>✓ {f}</li>
              ))}
            </ul>
            <a href={`https://wa.me/212653506441?text=${encodeURIComponent(`${t.waGreeting} (Sedan - €${route.price_sedan})`)}`} target="_blank" rel="noopener" class="tier-book-btn">
              <span>{t.bookSedan}</span>
            </a>
          </div>

          <!-- Tier 2: Executive Minivan -->
          <div class="tier-card featured-tier">
            <div class="tier-badge gold-badge">{t.tier2Badge}</div>
            <div class="tier-head">
              <h3>{t.tier2Title}</h3>
              <p class="tier-desc">{t.tier2Desc}</p>
            </div>
            <div class="tier-price-row">
              <span class="tier-price gold-text">€{route.price_van}</span>
              <span class="tier-price-unit">{t.cashToDriver}</span>
            </div>
            <ul class="tier-features">
              {t.tier2Features.map((f) => (
                <li>✓ {f}</li>
              ))}
            </ul>
            <a href={`https://wa.me/212653506441?text=${encodeURIComponent(`${t.waGreeting} (Van - €${route.price_van})`)}`} target="_blank" rel="noopener" class="tier-book-btn featured-btn">
              <span>{t.bookVan}</span>
            </a>
          </div>

          <!-- Tier 3: Minibus -->
          <div class="tier-card">
            <div class="tier-badge">{t.tier3Badge}</div>
            <div class="tier-head">
              <h3>{t.tier3Title}</h3>
              <p class="tier-desc">{t.tier3Desc}</p>
            </div>
            <div class="tier-price-row">
              <span class="tier-price">€{route.price_minibus}</span>
              <span class="tier-price-unit">{t.cashToDriver}</span>
            </div>
            <ul class="tier-features">
              {t.tier3Features.map((f) => (
                <li>✓ {f}</li>
              ))}
            </ul>
            <a href={`https://wa.me/212653506441?text=${encodeURIComponent(`${t.waGreeting} (Minibus - €${route.price_minibus})`)}`} target="_blank" rel="noopener" class="tier-book-btn">
              <span>{t.bookMinibus}</span>
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- 3. ROUTE HIGHLIGHTS & ITINERARY EXPERIENCE -->
    <section class="route-details-section">
      <div class="route-container">
        
        <div class="details-grid">
          
          <div class="details-content">
            <span class="section-kicker">{t.expectKicker}</span>
            <h2>{t.expectTitle}</h2>
            <p>{t.expectDesc}</p>

            <div class="highlights-box">
              <h3>{t.highlightsTitle}</h3>
              <ul class="highlights-list">
                {route.highlights.map((h) => (
                  <li>
                    <span class="hl-check">✓</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="trust-banner">
              <div class="trust-pill">
                <strong>{t.trust1Title}</strong>
                <span>{t.trust1Desc}</span>
              </div>
              <div class="trust-pill">
                <strong>{t.trust2Title}</strong>
                <span>{t.trust2Desc}</span>
              </div>
              <div class="trust-pill">
                <strong>{t.trust3Title}</strong>
                <span>{t.trust3Desc}</span>
              </div>
            </div>
          </div>

          <!-- Quick Booking Concierge Card -->
          <div class="details-card-wrap">
            <div class="concierge-card">
              <h3>{t.conciergeTitle}</h3>
              <p>{t.conciergeDesc}</p>
              
              <div class="concierge-features">
                <div class="cf-item">
                  <span class="cf-icon">⏱</span>
                  <div>
                    <strong>{t.avgResponse}</strong>
                    <span>{t.avgResponseSub}</span>
                  </div>
                </div>
                <div class="cf-item">
                  <span class="cf-icon">🛡️</span>
                  <div>
                    <strong>{t.licensedAgency}</strong>
                    <span>{t.licensedAgencySub}</span>
                  </div>
                </div>
                <div class="cf-item">
                  <span class="cf-icon">⭐</span>
                  <div>
                    <strong>{t.ratingTitle}</strong>
                    <span>{t.ratingSub}</span>
                  </div>
                </div>
              </div>

              <a href={waUrl} target="_blank" rel="noopener" class="concierge-wa-btn">
                <img src="/img/whatsapp-logo.png" alt="WhatsApp" width="18" height="18" class="wa-btn-icon">
                <span>{t.messageWa}</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 4. FREQUENTLY ASKED QUESTIONS -->
    <section class="route-faq-section">
      <div class="route-container">
        
        <div class="section-head">
          <span class="section-kicker">{t.faqKicker}</span>
          <h2>{t.faqTitle}</h2>
          <p>{t.faqDesc}</p>
        </div>

        <div class="faq-list">
          {route.faqs.map((faq, idx) => (
            <div class="faq-card">
              <h3 class="faq-q">
                <span class="faq-num">0{idx + 1}.</span>
                <span>{faq.q}</span>
              </h3>
              <p class="faq-a">{faq.a}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 5. FINAL BOOKING CTA BANNER -->
    <section class="route-cta-banner">
      <div class="route-container">
        <div class="cta-inner">
          <span class="cta-kicker">{t.readyKicker}</span>
          <h2>{t.readyTitle}</h2>
          <p>{t.readyDesc}</p>
          <a href={waUrl} target="_blank" rel="noopener" class="cta-button">
            <img src="/img/whatsapp-logo.png" alt="WhatsApp" width="22" height="22" class="wa-btn-icon">
            <span>{t.instantWa}</span>
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style is:global>
  /* ── ROUTE PAGE MODERN DESIGN SYSTEM ── */
  .route-page-main {
    padding-top: 100px;
    background: #fbf9f5;
    color: #111111;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .route-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ── 1. HERO & BREADCRUMBS ── */
  .route-hero {
    padding: 40px 0 60px;
    background: linear-gradient(180deg, #f5f0e6 0%, #fbf9f5 100%);
    border-bottom: 1px solid #ebdcc5;
  }
  .dest-breadcrumb {
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a6f5d;
    margin-bottom: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
  .dest-breadcrumb a {
    color: #8b6b23;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .dest-breadcrumb a:hover {
    color: #5c430e;
  }
  .dest-breadcrumb span {
    color: #2b261f;
  }
  .route-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: #ffffff;
    border: 1px solid #e0d0b8;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #634b17;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }
  .gold-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #C8A45C;
  }
  .route-hero-title {
    font-size: clamp(30px, 4.4vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    color: #111111;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    max-width: 960px;
  }
  .route-hero-subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: #555555;
    max-width: 840px;
    margin-bottom: 36px;
  }

  /* Route Metrics Summary Bar */
  .route-metrics-bar {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #e8decb;
    border-radius: 16px;
    padding: 14px 24px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    margin-bottom: 32px;
    gap: 20px;
    flex-wrap: wrap;
  }
  .metric-pill {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .metric-label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #888888;
  }
  .metric-value {
    font-size: 17px;
    font-weight: 800;
    color: #111111;
  }
  .metric-divider {
    width: 1px;
    height: 32px;
    background: #e8decb;
  }
  .gold-text {
    color: #9b722b !important;
  }

  /* CTAs */
  .route-hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .primary-wa-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25D366;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
  }
  .primary-wa-cta:hover {
    background: #20ba59;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
  }
  .secondary-calc-cta {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #d4c4aa;
    color: #2b261f;
    font-size: 14.5px;
    font-weight: 600;
    padding: 14px 24px;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .secondary-calc-cta:hover {
    background: #f7f1e6;
    border-color: #baa483;
  }

  /* Quick Answer Card (BLUF) */
  .route-quick-answer-card {
    background: #ffffff;
    border: 1px solid #e5d8be;
    border-left: 5px solid #C8A45C;
    border-radius: 14px;
    padding: 22px 26px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    max-width: 960px;
  }
  .quick-answer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .quick-answer-tag {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #8c681f;
  }
  .quick-answer-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 6px;
    background: #f5ede0;
    color: #634b17;
  }
  .quick-answer-text {
    font-size: 14.5px;
    line-height: 1.65;
    color: #333333;
    margin: 0;
  }

  /* ── 2. PRICING TIERS ── */
  .route-pricing-section {
    padding: 70px 0;
    background: #ffffff;
    border-bottom: 1px solid #eee5d8;
  }
  .section-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 50px;
  }
  .section-kicker {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #9b722b;
    display: block;
    margin-bottom: 8px;
  }
  .section-head h2 {
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #111111;
    margin-bottom: 10px;
  }
  .section-head p {
    font-size: 15.5px;
    color: #666666;
    margin: 0;
  }
  .pricing-tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  .tier-card {
    background: #fcfbfa;
    border: 1px solid #e8decb;
    border-radius: 18px;
    padding: 32px 26px 28px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .tier-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }
  .featured-tier {
    background: #ffffff;
    border: 2px solid #C8A45C;
    box-shadow: 0 8px 30px rgba(200, 164, 92, 0.15);
    transform: scale(1.02);
  }
  .featured-tier:hover {
    transform: scale(1.02) translateY(-4px);
  }
  .tier-badge {
    position: absolute;
    top: -12px;
    left: 24px;
    background: #2b261f;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 999px;
  }
  .gold-badge {
    background: linear-gradient(135deg, #C8A45C 0%, #aa853a 100%) !important;
    color: #ffffff !important;
  }
  .tier-head h3 {
    font-size: 21px;
    font-weight: 800;
    color: #111111;
    margin-bottom: 6px;
  }
  .tier-desc {
    font-size: 13.5px;
    color: #666666;
    min-height: 40px;
    margin-bottom: 20px;
  }
  .tier-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid #ebdcc5;
  }
  .tier-price {
    font-size: 38px;
    font-weight: 900;
    color: #111111;
    letter-spacing: -0.02em;
  }
  .tier-price-unit {
    font-size: 12.5px;
    color: #888888;
    font-weight: 600;
  }
  .tier-features {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }
  .tier-features li {
    font-size: 13.5px;
    color: #333333;
    line-height: 1.4;
  }
  .tier-book-btn {
    display: block;
    text-align: center;
    background: #111111;
    color: #ffffff;
    font-size: 14.5px;
    font-weight: 700;
    padding: 13px 20px;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .tier-book-btn:hover {
    background: #333333;
  }
  .featured-btn {
    background: linear-gradient(135deg, #C8A45C 0%, #aa853a 100%) !important;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(200, 164, 92, 0.35);
  }
  .featured-btn:hover {
    filter: brightness(1.08);
  }

  /* ── 3. ROUTE HIGHLIGHTS ── */
  .route-details-section {
    padding: 70px 0;
    background: #fbf9f5;
  }
  .details-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .details-content h2 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    color: #111111;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .details-content p {
    font-size: 15.5px;
    line-height: 1.65;
    color: #555555;
    margin-bottom: 28px;
  }
  .highlights-box {
    background: #ffffff;
    border: 1px solid #e8decb;
    border-radius: 16px;
    padding: 26px 28px;
    margin-bottom: 28px;
  }
  .highlights-box h3 {
    font-size: 17px;
    font-weight: 800;
    color: #111111;
    margin-bottom: 16px;
  }
  .highlights-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .highlights-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 14.5px;
    color: #333333;
    line-height: 1.5;
  }
  .hl-check {
    color: #9b722b;
    font-weight: 800;
  }
  .trust-banner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
