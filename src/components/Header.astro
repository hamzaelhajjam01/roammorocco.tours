  <script is:inline>
    function toggleMobileAccordion(panelId, btn) {
      var panel = document.getElementById(panelId);
      if (!panel) return;
      var isOpen = panel.classList.contains('open');
      document.querySelectorAll('.mob-accordion-panel.open').forEach(function(p) {
        p.classList.remove('open');
        if (p.previousElementSibling) {
          p.previousElementSibling.classList.remove('active');
        }
      });
      if (!isOpen) {
        panel.classList.add('open');
        if (btn) btn.classList.add('active');
      }
    }
  </script>

  <style is:global>
    /* ── NAV DROPDOWN ARCHITECTURE ── */
    .nav-dropdown-item {
      position: relative;
      display: flex;
      align-items: center;
    }
    .nav-dropdown-item .nav-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: -.2px;
      padding: 6px 12px;
      border-radius: 9999px !important;
      background: transparent;
      border: none;
      text-decoration: none;
      transition: all .25s ease;
      cursor: pointer;
    }
    .top.at-top .nav-dropdown-item .nav-link {
      color: #000;
    }
    .top.at-top .nav-dropdown-item:hover .nav-link,
    .top.at-top .nav-dropdown-item .nav-link:focus {
      background: rgba(0, 0, 0, 0.06);
      color: #000;
    }
    .top.at-bottom .nav-dropdown-item .nav-link {
      color: rgba(255, 255, 255, 0.85);
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .top.at-bottom .nav-dropdown-item:hover .nav-link,
    .top.at-bottom .nav-dropdown-item .nav-link:focus {
      background: rgba(255, 255, 255, 0.22);
      color: #fff;
      transform: translateY(-1px);
    }

    .nav-chevron {
      transition: transform 0.25s ease;
    }
    .nav-dropdown-item:hover .nav-chevron,
    .nav-dropdown-item:focus-within .nav-chevron {
      transform: rotate(180deg);
    }

    /* ── DROPDOWN PANELS WITH INVISIBLE HOVER BRIDGE ── */
    .nav-dropdown-panel {
      position: absolute;
      width: 370px;
      border-radius: 20px;
      padding: 16px;
      box-sizing: border-box;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s;
      z-index: 250;
      text-align: left;
    }

    /* Invisible hover bridge connecting trigger button to dropdown panel */
    .nav-dropdown-panel::before {
      content: "";
      position: absolute;
      top: -20px;
      left: 0;
      right: 0;
      height: 20px;
      background: transparent;
      pointer-events: auto;
    }

    /* When at top (opens downward) */
    .top.at-top .nav-dropdown-panel {
      top: calc(100% + 4px);
      left: 0;
      transform: translateY(6px);
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(28px) saturate(1.8);
      -webkit-backdrop-filter: blur(28px) saturate(1.8);
      border: 1px solid rgba(0, 0, 0, 0.09);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04);
      color: #111;
    }
    .top.at-top .nav-dropdown-panel.tours-panel {
