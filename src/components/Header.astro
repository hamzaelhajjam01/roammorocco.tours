      <img id="loader-final-logo" src="/img/logo-for-dark-bg.png" alt="Roam Morocco">
    </div>
  </div>

  <style is:global>
    #page-loader {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: #0b0b0d;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.5s;
    }
    #page-loader.done {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    #loader-slot {
      position: relative;
      width: clamp(220px, 60vw, 360px);
      height: clamp(220px, 60vw, 360px);
    }
    .loader-item {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      opacity: 0;
      transform-origin: center center;
      will-change: transform, opacity;
    }
    @keyframes stickerSlap {
      0%  { opacity: 0; transform: rotate(calc(var(--r0))) scale(1.4) translate(var(--tx), var(--ty)); }
      55% { opacity: 1; transform: rotate(calc(var(--r1) * 0.5)) scale(1.04) translate(0, 3px); }
      75% { transform: rotate(calc(var(--r1) * 1.08)) scale(0.98) translate(0, -2px); }
      100%{ opacity: 1; transform: rotate(var(--r1)) scale(1) translate(0, 0); }
    }
    @keyframes stickerPeel {
      0%  { opacity: 1; transform: rotate(var(--r1)) scale(1); }
      100%{ opacity: 0; transform: rotate(calc(var(--r1) + var(--rp))) scale(0.65) translate(var(--px), var(--py)); }
    }
    .loader-item.slap-in {
      animation: stickerSlap var(--dur, 0.28s) cubic-bezier(.16, 1, .3, 1) forwards;
    }
    .loader-item.peel-off {
      animation: stickerPeel 0.16s ease-in forwards;
    }
    @keyframes logoStamp {
      0%  { opacity: 0; transform: scale(1.25); }
      60% { opacity: 1; transform: scale(0.96); }
      100%{ opacity: 1; transform: scale(1); }
    }
    #loader-final-logo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      opacity: 0;
      will-change: transform, opacity;
      max-width: 240px;
      margin: auto;
    }
    #loader-final-logo.stamp {
      animation: logoStamp 0.38s cubic-bezier(.16, 1, .3, 1) forwards;
    }
  </style>

  <script is:inline>
    (function(){
      const loader = document.getElementById('page-loader');
      if(!loader) return;

      // Run loader only on initial visit per session
      if (sessionStorage.getItem('hasLoadedBefore')) {
        loader.remove();
        return;
      }
      sessionStorage.setItem('hasLoadedBefore', 'true');

      // Fail-safe timeout: Dismiss loader after 3s max under any condition
      const failSafe = setTimeout(() => {
        if(loader && loader.parentNode) {
          loader.classList.add('done');
          setTimeout(() => { if(loader && loader.parentNode) loader.remove(); }, 400);
        }
      }, 3000);

      const baseSlapMs = 280;
      const baseHoldMs = 200;
      const basePeelMs = 150;
      const stickers   = Array.from(document.querySelectorAll('.loader-item'));
      const logo       = document.getElementById('loader-final-logo');

      function rnd(min, max){ return (Math.random() * (max - min) + min).toFixed(1); }

      function slap(idx){
        const currentSpeed = 1 + idx * 0.12;
        const slapMs = Math.round(baseSlapMs / currentSpeed);
        const holdMs = Math.round(baseHoldMs / currentSpeed);
        const peelMs = Math.round(basePeelMs / currentSpeed);

        if(idx >= stickers.length){
          if(logo) logo.classList.add('stamp');
          setTimeout(() => {
            clearTimeout(failSafe);
            loader.classList.add('done');
            setTimeout(() => {
              if(loader && loader.parentNode) loader.remove();
            }, 600);
          }, 800);
          return;
        }

        const s = stickers[idx];
        if(!s) return;

        const r1 = rnd(-10, 10);
        const r0 = (+r1 + parseFloat(rnd(20, 35)) * (Math.random() > .5 ? 1 : -1)).toFixed(1);
        const tx = rnd(-60, 60);
        const ty = rnd(-80, -30);
        const rp = rnd(15, 30) * (Math.random() > .5 ? 1 : -1);
        const px = rnd(-50, 50);
        const py = rnd(20, 60);

        s.style.setProperty('--r0', `${r0}deg`);
        s.style.setProperty('--r1', `${r1}deg`);
        s.style.setProperty('--tx', `${tx}px`);
        s.style.setProperty('--ty', `${ty}px`);
        s.style.setProperty('--rp', `${rp}deg`);
        s.style.setProperty('--px', `${px}px`);
        s.style.setProperty('--py', `${py}px`);
        s.style.setProperty('--dur', `${slapMs}ms`);

        s.classList.remove('peel-off');
        void s.offsetWidth;
        s.classList.add('slap-in');

        setTimeout(() => {
          s.classList.remove('slap-in');
          void s.offsetWidth;
          s.classList.add('peel-off');
          setTimeout(() => {
            s.classList.remove('peel-off');
            slap(idx + 1);
          }, peelMs);
        }, slapMs + holdMs);
      }

      slap(0);
    })();
  </script>
)}
