  <script is:inline>
    function toggleMobileAccordion(panelId, btn) {
      var panel = document.getElementById(panelId);
      if (!panel) return;
      var isOpen = panel.classList.contains('open');
      document.querySelectorAll('.mob-accordion-panel.open').forEach(function(p) {
        p.classList.remove('open');
        if (p.previousElementSibling) {
          p.previousElementSibling.classList.remove('active');
        }
      });
      if (!isOpen) {
        panel.classList.add('open');
        if (btn) btn.classList.add('active');
      }
    }

    // Dynamic Client-side Language Switcher Sync: always resolves accurately against live browser pathname
    (function () {
      function syncLanguageLinks() {
        var p = window.location.pathname;
        // Strip any existing language prefix (e.g. /fr/, /es/, /de/, /it/, /fr.html, etc.)
        var clean = p.replace(/^\/(fr|es|de|it)(\.html|\/|$)/, '/');
        if (!clean.startsWith('/')) clean = '/' + clean;
        if (clean === '/index.html' || clean === '/') clean = '/';

        var links = {
          en: clean,
          fr: clean === '/' ? '/fr/' : '/fr' + clean,
          es: clean === '/' ? '/es/' : '/es' + clean,
          de: clean === '/' ? '/de/' : '/de' + clean,
          it: clean === '/' ? '/it/' : '/it' + clean
        };

        document.querySelectorAll('.lang-row-btn, .mob-lang-pill').forEach(function (el) {
          var l = el.getAttribute('data-lang');
          if (l && links[l]) {
            el.href = links[l];
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncLanguageLinks);
      } else {
        syncLanguageLinks();
      }
    })();
  </script>

