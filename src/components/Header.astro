        <svg class="morocco-star" viewBox="0 0 24 24" width="14" height="14" fill="#000000"><path d="M12 1.7l3.09 6.26 6.91 1-5 4.87 1.18 6.88L12 17.47l-6.18 3.25L7 13.84 2 8.97l6.91-1L12 1.7z"/></svg>
