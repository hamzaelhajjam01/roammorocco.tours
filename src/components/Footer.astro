---
// Footer Component
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const lLink = (url: string) => {
  if (lang === 'en') return url;
  if (url === '/' || url === '/#top') return `/${lang}/`;
  return `/${lang}${url.startsWith('/') ? url : '/' + url}`;
};
---
  <footer id="contact">
    <div class="footer-wrap">
      <div class="footer-header-row">
        <div class="footer-contact-block">
          <p class="footer-tagline">Let's feel Morocco together</p>
          <a href="mailto:contact@roammorocco.tours" class="footer-email-link">contact@roammorocco.tours</a>
        </div>
        <div class="footer-nav-columns" style="gap:36px;">
          <div class="footer-col">
            <span class="footer-col-title">Destinations</span>
            <a href={lLink('/destination-sahara-desert.html')}>Sahara Desert</a>
            <a href={lLink('/destination-marrakech.html')}>Marrakech</a>
            <a href={lLink('/destination-fes.html')}>Fes</a>
            <a href={lLink('/destination-chefchaouen.html')}>Chefchaouen</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Travel Suite</span>
            <a href={lLink('/morocco-trip-cost-calculator.html')}>Cost Estimator</a>
            <a href={lLink('/morocco-private-driver.html')}>Private Chauffeur</a>
            <a href={lLink('/custom-morocco-tour.html')}>Custom Tours</a>
            <a href={lLink('/blog.html')}>Travel Blog</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Connect</span>
            <a href="https://wa.me/212653506441?text=Salam%20Roam%20Morocco!%20I'd%20like%20to%20plan%20a%20custom%20tour." target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </div>
      </div>
      
      <div class="footer-giant-brand">
        <img src="/img/roam-morocco-tours-footer-logo.png" alt="Roam Morocco Tours" class="footer-logo-img">
      </div>
      
      <div class="footer-bottom-bar">
        <div class="footer-legal">
          <span>&copy; 2026 Roam Morocco Tours. All Rights Reserved.</span>
          <a href={lLink('/terms-conditions.html')}>Terms of Service</a>
          <a href={lLink('/privacy-policy.html')}>Privacy Policy</a>
          <a href={lLink('/refund-policy.html')}>Refund Policy</a>
          <a href={lLink('/travel-policy.html')}>Travel Policy</a>
        </div>
      </div>
    </div>
  </footer>
